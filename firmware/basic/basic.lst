  324 e135:                                         ;into accumulator
  325 e135:             ;
  326 e135:             ; variable id in accumulator, return value in r7
  327 e135:             ;
  328 e135: 04 e5 9e        jsr exe_get_variable
  329 e138: 0e 04           LDAI TOKENIZER_VARIABLE
  330 e13a: 04 e1 19        JSR exe_accept
  331 e13d: 05              RET
