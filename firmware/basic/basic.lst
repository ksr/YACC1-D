 3094 ef52: 1f 03 00            mviw r7,parse_input_line
 3095 ef55: 04 ec 5c            JSR parse_line
 3096 ef58:             
 3097 ef58: a1 ef 46            BRZ basic_interprter
 3098 ef5b: 05                  RET
 3099 ef5c:             
 3100 ef5c: 1b 03 00            mviw r3,parse_input_line
 3101 ef5f:             
 3102 ef5f:             ;
 3103 ef5f:             ; get_inputline: read a line into the buffer at R7 (parse_input_line, $0300) up to and including the LF
 3104 ef5f:             ; (uartin echoes each character and turns CR into LF).
 3105 ef5f:             ; 2026-10-07: backspace ($08) and DEL ($7F) take back the last character (at the start of the line they
 3106 ef5f:             ; do nothing) and erase it on the screen; letters outside "..." are stored in upper case, so the
 3107 ef5f:             ; tokenizer (upper-case keywords and variables A-Z) takes lower case too. R6 low = 1 inside a string.
 3108 ef5f:             ; The bounds are hex: the assembler upper-cases every source line, character literals included.
 3109 ef5f:             ;
 3110 ef5f:             get_inputline:
 3111 ef5f: 07 06               pushr r6
 3112 ef61: 1e 00 00            mviw r6,0
 3113 ef64:             gil_loop:
 3114 ef64: 04 ff e8            jsr uartin
 3115 ef67: 0d 08               ldti 08h
 3116 ef69: a8 ef 9e            breq gil_bs
 3117 ef6c: 0d 7f               ldti 7fh
 3118 ef6e: a8 ef 99            breq gil_del
 3119 ef71: 4f                  stavr r7
 3120 ef72: 0d 22               ldti '"'
 3121 ef74: aa ef 7e            brneq gil_nq
 3122 ef77: 26                  mvrla r6            ; a quote: in or out of a string
 3123 ef78: b4 01               xori 1
 3124 ef7a: 36                  mvarl r6
 3125 ef7b: a0 ef 95            br gil_next
 3126 ef7e:             gil_nq:
 3127 ef7e: 0d 0a               ldti 0ah  ;1 changed from 0a to 0D for new emulator code, changed back
 3128 ef80: a8 ef ba            breq gil_done
 3129 ef83: 0d 61               ldti 61h            ; 'a'
 3130 ef85: a7 ef 95            brlt gil_next
 3131 ef88: 0d 7a               ldti 7ah            ; 'z'
 3132 ef8a: a9 ef 95            brgt gil_next
 3133 ef8d: 26                  mvrla r6
 3134 ef8e: a2 ef 95            brnz gil_next       ; inside a string: as typed
 3135 ef91: 47                  ldavr r7
 3136 ef92: b1 20               subi 20h
 3137 ef94: 4f                  stavr r7
 3138 ef95:             gil_next:
 3139 ef95: 57                  incr r7
 3140 ef96: a0 ef 64            br gil_loop
 3141 ef99:             gil_del:
 3142 ef99: 0e 08               ldai 08h            ; DEL echoed as itself: step back first
 3143 ef9b: 04 ff c8            jsr uartout
 3144 ef9e:             gil_bs:
 3145 ef9e: 27                  mvrla r7
 3146 ef9f: a1 ef 64            brz gil_loop        ; at the start of the line: nothing to take back
 3147 efa2: 5f                  decr r7
 3148 efa3: 47                  ldavr r7
 3149 efa4: 0d 22               ldti '"'
 3150 efa6: aa ef ad            brneq gil_erase
 3151 efa9: 26                  mvrla r6            ; took back a quote
 3152 efaa: b4 01               xori 1
 3153 efac: 36                  mvarl r6
 3154 efad:             gil_erase:
 3155 efad: 0e 20               ldai 20h            ; blank the character, then step back onto it
 3156 efaf: 04 ff c8            jsr uartout
 3157 efb2: 0e 08               ldai 08h
 3158 efb4: 04 ff c8            jsr uartout
 3159 efb7: a0 ef 64            br gil_loop
 3160 efba:             gil_done:
 3161 efba: 57                  incr r7
 3162 efbb: 08 60               popr r6
 3163 efbd: 1f ef c4            MVIW R7,CRLF
 3164 efc0: 04 ff c0            JSR STRINGOUT
 3165 efc3: 05                  RET
 3166 efc4:             
 3167 efc4:             ;
 3168 efc4:             ; STRINGS
 3169 efc4:             ;
 3170 efc4: 0a 0d 00    CRLF: DB 0ah,0dh,0
 3171 efc7:             ;
 3172 efc7:             
 3173 efc7:                   ORG 0EF00h
