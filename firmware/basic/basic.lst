  255 e114:             ;
  256 e114:             ; Basic interpreter - execution engine
  257 e114:             ; Register Usage
  258 e114:             ; R0 - Program Counter
  259 e114:             ; R1 - Stack Pointer
  260 e114:             ; R2 - Direct addressing mode
  261 e114:             ; R3 - Basic Interpreter Token Buffer ptr
  262 e114:             ; R4 - working register  ; or is this for-next stack ptr
  263 e114:             ; R5 - working register  ; or is this gosub stack ptr
  264 e114:             ; R6 - Working register
  265 e114:             ; R7 - parameter passing & return value
  266 e114:             ;
  267 e114:             ;exe: Is this label needed
  268 e114:             ;
  269 e114:             ; void ubasic_init()
  270 e114:             ;
  271 e114:             ; Setup basic interpreter execution engine
  272 e114:             ;
  273 e114:             exe_init:
  274 e114: 09              push
  275 e115: 1d 02 c2        MVIW R5,bas_gosubstack
  276 e118: 1c 02 82        MVIW R4,bas_forstack
  277 e11b: 1e 02 00        MVIW R6,bas_run_ended
  278 e11e: 0e 00           LDAI 0
  279 e120: 4e              STAVR R6
  280 e121: f3 02 0c        LDR R3,bas_tokenbuffer
  281 e124: 0a              pop
  282 e125: 05              RET
  283 e126:             
  284 e126:             ;
  285 e126:             ; void accept(int)
  286 e126:             ;
  287 e126:             ; compare accumulator with current token then advance to next token in buffer
  288 e126:             ; assume accumulator destroyed
  289 e126:             ;
  290 e126:             exe_accept:
  291 e126: 09              push
  292 e127:             ;
  293 e127:             ; get current token into accumulator
  294 e127:             ;
  295 e127:             ; FIX: Switch to BRNEQ to error state and save a branch
  296 e127:             ;
  297 e127: 43              LDAVR R3
  298 e128: 0b              MVAT
  299 e129: 0a              POP
  300 e12a: a8 e1 3b        BREQ exe_accept_done
  301 e12d:             ;
  302 e12d:             ; debug information
  303 e12d:             ;
  304 e12d: 04 ff e0        JSR showbytea
  305 e130: 0e 23           ldai '#'
  306 e132: 04 ff c8        JSR uartout
  307 e135: 1f e0 a8        mviw R7,bas_msg1
  308 e138: 04 e5 b6        JSR bas_error
  309 e13b:             ;
  310 e13b:             exe_accept_done:
  311 e13b: 04 e5 b8        jsr exe_next_token
  312 e13e: 05              RET
  313 e13f:             
  314 e13f:             ;
  315 e13f:             ; int varfactor()
  316 e13f:             ;
  317 e13f:             ; get variable id pointed to by exe_variable_num in token stream
  318 e13f:             ; (this is not a value but a variable id)
  319 e13f:             ; value returned by exe_get_variable in r7
  320 e13f:             ;
  321 e13f:             ; return value in R7
  322 e13f:             ;
  323 e13f:             exe_varfactor:
  324 e13f: 04 e5 f1        jsr exe_variable_num    ; get variable number id (one byte for now a-z)
  325 e142:                                         ;into accumulator
  326 e142:             ;
  327 e142:             ; variable id in accumulator, return value in r7
  328 e142:             ;
  329 e142: 04 e5 ab        jsr exe_get_variable
  330 e145: 0e 04           LDAI TOKENIZER_VARIABLE
  331 e147: 04 e1 26        JSR exe_accept
  332 e14a: 05              RET
  333 e14b:             
