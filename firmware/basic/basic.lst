  254 e107:             ;
  255 e107:             ; Basic interpreter - execution engine
  256 e107:             ; Register Usage
  257 e107:             ; R0 - Program Counter
  258 e107:             ; R1 - Stack Pointer
  259 e107:             ; R2 - Direct addressing mode
  260 e107:             ; R3 - Basic Interpreter Token Buffer ptr
  261 e107:             ; R4 - working register  ; or is this for-next stack ptr
  262 e107:             ; R5 - working register  ; or is this gosub stack ptr
  263 e107:             ; R6 - Working register
  264 e107:             ; R7 - parameter passing & return value
  265 e107:             ;
  266 e107:             ;exe: Is this label needed
  267 e107:             ;
  268 e107:             ; void ubasic_init()
  269 e107:             ;
  270 e107:             ; Setup basic interpreter execution engine
  271 e107:             ;
  272 e107:             exe_init:
  273 e107: 09              push
  274 e108: 1d 02 c2        MVIW R5,bas_gosubstack
  275 e10b: 1c 02 82        MVIW R4,bas_forstack
  276 e10e: 1e 02 00        MVIW R6,bas_run_ended
  277 e111: 0e 00           LDAI 0
  278 e113: 4e              STAVR R6
  279 e114: f3 02 0c        LDR R3,bas_tokenbuffer
  280 e117: 0a              pop
  281 e118: 05              RET
  282 e119:             
  283 e119:             ;
  284 e119:             ; void accept(int)
  285 e119:             ;
  286 e119:             ; compare accumulator with current token then advance to next token in buffer
  287 e119:             ; assume accumulator destroyed
  288 e119:             ;
  289 e119:             exe_accept:
  290 e119: 09              push
  291 e11a:             ;
  292 e11a:             ; get current token into accumulator
  293 e11a:             ;
  294 e11a:             ; FIX: Switch to BRNEQ to error state and save a branch
  295 e11a:             ;
  296 e11a: 43              LDAVR R3
  297 e11b: 0b              MVAT
  298 e11c: 0a              POP
  299 e11d: a8 e1 2e        BREQ exe_accept_done
  300 e120:             ;
  301 e120:             ; debug information
  302 e120:             ;
  303 e120: 04 ff e0        JSR showbytea
  304 e123: 0e 23           ldai '#'
  305 e125: 04 ff c8        JSR uartout
  306 e128: 1f e0 a8        mviw R7,bas_msg1
  307 e12b: 04 e5 a9        JSR bas_error
  308 e12e:             ;
  309 e12e:             exe_accept_done:
  310 e12e: 04 e5 ab        jsr exe_next_token
  311 e131: 05              RET
  312 e132:             
  313 e132:             ;
  314 e132:             ; int varfactor()
  315 e132:             ;
  316 e132:             ; get variable id pointed to by exe_variable_num in token stream
  317 e132:             ; (this is not a value but a variable id)
  318 e132:             ; value returned by exe_get_variable in r7
  319 e132:             ;
  320 e132:             ; return value in R7
  321 e132:             ;
  322 e132:             exe_varfactor:
