 3097 ef4f:             
 3098 ef4f:             ;
 3099 ef4f:             ; STRINGS
 3100 ef4f:             ;
 3101 ef4f: 0a 0d 00    CRLF: DB 0ah,0dh,0
 3102 ef52:             ;
 3103 ef52:             ; get_inputline: read a line into the buffer at R7 (parse_input_line, $0300) up to and including the LF
 3104 ef52:             ; (uartin echoes each character and turns CR into LF).
 3105 ef52:             ; 2026-10-07: backspace ($08) and DEL ($7F) take back the last character (at the start of the line they
 3106 ef52:             ; do nothing) and erase it on the screen; letters outside "..." are stored in upper case, so the
 3107 ef52:             ; tokenizer (upper-case keywords and variables A-Z) takes lower case too. R6 low = 1 inside a string.
 3108 ef52:             ; The bounds are hex: the assembler upper-cases every source line, character literals included.
 3109 ef52:             ;
 3110 ef52:             gil_start:
 3111 ef52: 07 06               pushr r6
 3112 ef54: 1e 00 00            mviw r6,0
 3113 ef57:             gil_loop:
 3114 ef57: 04 ff e8            jsr uartin
 3115 ef5a: 0d 08               ldti 08h
 3116 ef5c: a8 ef 91            breq gil_bs
 3117 ef5f: 0d 7f               ldti 7fh
 3118 ef61: a8 ef 8c            breq gil_del
 3119 ef64: 4f                  stavr r7
 3120 ef65: 0d 22               ldti '"'
 3121 ef67: aa ef 71            brneq gil_nq
 3122 ef6a: 26                  mvrla r6            ; a quote: in or out of a string
 3123 ef6b: b4 01               xori 1
 3124 ef6d: 36                  mvarl r6
 3125 ef6e: a0 ef 88            br gil_next
 3126 ef71:             gil_nq:
 3127 ef71: 0d 0a               ldti 0ah  ;1 changed from 0a to 0D for new emulator code, changed back
 3128 ef73: a8 ef ad            breq gil_done
 3129 ef76: 0d 61               ldti 61h            ; 'a'
 3130 ef78: a7 ef 88            brlt gil_next
 3131 ef7b: 0d 7a               ldti 7ah            ; 'z'
 3132 ef7d: a9 ef 88            brgt gil_next
 3133 ef80: 26                  mvrla r6
 3134 ef81: a2 ef 88            brnz gil_next       ; inside a string: as typed
 3135 ef84: 47                  ldavr r7
 3136 ef85: b1 20               subi 20h
 3137 ef87: 4f                  stavr r7
 3138 ef88:             gil_next:
 3139 ef88: 57                  incr r7
 3140 ef89: a0 ef 57            br gil_loop
 3141 ef8c:             gil_del:
 3142 ef8c: 0e 08               ldai 08h            ; DEL echoed as itself: step back first
 3143 ef8e: 04 ff c8            jsr uartout
 3144 ef91:             gil_bs:
 3145 ef91: 27                  mvrla r7
 3146 ef92: a1 ef 57            brz gil_loop        ; at the start of the line: nothing to take back
 3147 ef95: 5f                  decr r7
 3148 ef96: 47                  ldavr r7
 3149 ef97: 0d 22               ldti '"'
 3150 ef99: aa ef a0            brneq gil_erase
 3151 ef9c: 26                  mvrla r6            ; took back a quote
 3152 ef9d: b4 01               xori 1
 3153 ef9f: 36                  mvarl r6
 3154 efa0:             gil_erase:
 3155 efa0: 0e 20               ldai 20h            ; blank the character, then step back onto it
 3156 efa2: 04 ff c8            jsr uartout
 3157 efa5: 0e 08               ldai 08h
 3158 efa7: 04 ff c8            jsr uartout
 3159 efaa: a0 ef 57            br gil_loop
 3160 efad:             gil_done:
 3161 efad: 57                  incr r7
 3162 efae: 08 60               popr r6
 3163 efb0: 1f ef 4f            MVIW R7,CRLF
 3164 efb3: 04 ff c0            JSR STRINGOUT
 3165 efb6: 05                  RET
 3166 efb7:             ;
 3167 efb7:             ; 2026-10-07: the new line input and the SYNTAX ERROR handler sit here, after CRLF, so every routine and string
 3168 efb7:             ; before them keeps the address it had in ROM 2026-09-23.
 3169 efb7:             ; parse_token_chk: parse_token, and on TOKENIZER_ERROR (a character no token starts with: the text pointer does
 3170 efb7:             ; not move past it, so parse_line_loop would ask for the same token forever) drop the line: discard this call's
 3171 efb7:             ; return into parse_line_loop and return from parse_line itself (its loop keeps nothing else on the stack) with
 3172 efb7:             ; SYNTAX ERROR printed and 0 in ACC, as parse_line_error does. Same size at the call as JSR parse_token.
 3173 efb7:             parse_token_chk:
 3174 efb7: 04 eb 62        JSR parse_token
 3175 efba: 0d 00           ldti TOKENIZER_ERROR
 3176 efbc: a8 ef c0        BREQ parse_line_syntax
 3177 efbf: 05              ret
 3178 efc0:             parse_line_syntax:
 3179 efc0: 08 70           popr r7                   ; the return into parse_line_loop
 3180 efc2: 1f ef d1        mviw r7,parse_syntax_error
 3181 efc5: 04 ff c0        jsr stringout
 3182 efc8: 1f ef 4f        mviw r7,CRLF
 3183 efcb: 04 ff c0        jsr stringout
 3184 efce: 0e 00           ldai 0
 3185 efd0: 05              ret
 3186 efd1: 53 59 4e 54 
            41 58 20 45 
            52 52 4f 52 
            00          parse_syntax_error: db "SYNTAX ERROR",0   ; 2026-10-07
 3187 efde:             ;
 3188 efde:             
 3189 efde:                   ORG 0EF00h
 3190 ef00:             
