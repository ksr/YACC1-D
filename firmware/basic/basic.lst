   72 0000:             ;
   73 0000:             BASIC_VARS: EQU 0100h
   74 0000:             
   75 0000:             ;
   76 0000:             ; Basic interpreter internal variables
   77 0000:             ;
   78 0000:             bas_run_ended:    EQU 0200h ; set to 1 when current "run" is done
   79 0000:             bas_txtptr:       EQU 0202h ; pointer into text line being parse
   80 0000:             bas_nxtptr:       EQU 0204h ;
   81 0000:             bas_tokptr:       EQU 0206h ; pointer into tmp token buffer
   82 0000:             bas_tokcounter:   EQU 0208h ; counter for tmp token buffer
   83 0000:             bas_currenttoken: EQU 020Ah ; used in parsing
   84 0000:             bas_tokenbuffer:  EQU 020Ch ; Pointer to start of token buffer
   85 0000:             bas_bufferendhi:  EQU 020Eh ; HACK, above buffer should end on 0xXXFF boundry
   86 0000:                                         ; this value should be + 1 end of buffer
   87 0000:                                         ; if buffer is 0x1000-0x1fff this is
   88 0000:                                         ; set to 0x2000. Used in moving buffer around
   89 0000:                                         ; in add and remove line
   90 0000:             bas_newlinenum:   EQU 0210h ; line number of new line to be added
   91 0000:             bas_newlinelen:   EQU 0212h ; line length of new line to be added
   92 0000:             bas_insertptr:    EQU 0214H
   93 0000:             bas_negflag:      EQU 0216H ; PROCESS NEGATIVE NUMBER
   94 0000:             
   95 0000:             ;
   96 0000:             ; FOR-NEXT statement stack ptr and stack data
   97 0000:             ;
   98 0000:             ; for next stack data
   99 0000:             ; format
  100 0000:             ;   2 bytes for variable id (only first byte used for now)
  101 0000:             ;   2 bytes to value (upper value) (format HL) (only first byte used for now)
  102 0000:             ;   2 bytes ptr to line after for instruction (format HL)
  103 0000:             ; later add step amount
  104 0000:             ;
  105 0000:             bas_forstackptr: EQU 0280h
  106 0000:             bas_forstack: EQU 0282h
  107 0000:             
  108 0000:             ;
  109 0000:             ; GOSUB stack ptr and data
