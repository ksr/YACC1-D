  624 f312: a1 f3 00            BRZ cferr
  625 f315: 78 00               OUTI P8,CFSEL_DATA
  626 f317: 1e 02 00            MVIW R6,512
  627 f31a:             cfwrl:
  628 f31a: 47                  LDAVR R7
  629 f31b: 69                  OUTA P9
