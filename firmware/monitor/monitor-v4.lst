  636 f326: 04 f2 7a            JSR cfwait
  637 f329: b3 01               ANDI 001H
  638 f32b: 05                  RET
  639 f32c:             ;
  640 f32c:             ; const: ACC = 1 when a console byte is waiting (2026-11-10: a key on the V2.0 card's keyboard counts too). The
  641 f32c:             ; emulator's port-2 console has no status: always ready.
  642 f32c:             const:
  643 f32c: af f3 32            BRDEV consthw
  644 f32f: 0e 01               LDAI 1
  645 f331: 05                  RET
  646 f332:             consthw:
  647 f332: 04 f3 3e            JSR kbst
  648 f335: a2 f3 3d            BRNZ constx
  649 f338: 70 68               OUTI P0,(UARTCS!UARTA5)
  650 f33a: 91                  INP P1
  651 f33b: b3 01               ANDI 001H
  652 f33d: 05          constx: RET
  653 f33e:             ;
  654 f33e:             ; kbst (2026-11-10): ACC = 1 when the video card V2.0's PS/2 keyboard has a byte (IN PD bit 0, FULL), else 0; the
  655 f33e:             ; byte is then IN PE (the card's rule: read PE only after PD showed FULL). 0 with no card (VIDPRES = 0).
  656 f33e: e4 0f f0    kbst:   LDA VIDPRES
  657 f341: 0d 01               LDTI 1
  658 f343: aa f3 4a            BRNEQ kbst0
  659 f346: 9d                  INP PD
  660 f347: b3 01               ANDI 1
  661 f349: 05                  RET
  662 f34a: 0e 00       kbst0:  LDAI 0
  663 f34c: 05                  RET
  664 f34d:             ;
  665 f34d:             ; O command: boot. Read the boot block (LBA 0) to OSBASE, check 'P8' and OSCNT, read OSCNT sectors from LBA 1
  666 f34d:             ; to OSBASE and call it; the OS returns with RET.
  667 f34d:             ;
  668 f34d:             ;
  669 f34d:             ; ':' - Intel-hex loader (YACC1-D 2026-09-23). A ':' at the prompt starts load mode: the rest of the record is read
  670 f34d:             ; without echo (uartinne), its bytes stored from its address on, and the record acknowledged with one character:
  671 f34d:             ;   .  stored and the checksum is right
  672 f34d:             ;   ?  a bad hex digit or a bad checksum
  673 f34d:             ;   !  refused or not verified: an address outside $1000-$DFFF (the monitor's page, the stack and the ROM are
  674 f34d:             ;      protected; any write to $E000-$FFFF would reach the 28C64, review M2), or the byte read back differently
  675 f34d:             ; Between records everything up to the next ':' is skipped (CR, LF, blanks), so an assembler .img can be pasted into
  676 f34d:             ; a terminal or sent as is; ESC (or a NUL, the emulators' end of input) abandons, between records or inside one. The end record (type 01) prints
  677 f34d:             ; LOADED, or LOADED WITH ERRORS when any record failed, and returns to the prompt. Records of other types are read
  678 f34d:             ; and checked but not stored. Host side: tools/monload.py paces the characters (the UART has no FIFO enabled: one
  679 f34d:             ; character of buffering) and waits for each acknowledgement. Registers: R3 checksum, R4 count, R5 type,
  680 f34d:             ; R6 record status (0 ok, 1 bad hex, 2 refused/unverified), R7 the address; never R2.
  681 f34d:             ;
  682 f34d:             hexload:
  683 f34d: 0d 05               LDTI  LOADMODE
  684 f34f: e7 0f 00            STT   monmode
  685 f352: 0d 00               LDTI  0
  686 f354: e7 0f 01            STT   lderr
  687 f357:             ldrec:
  688 f357: 1b 00 00            MVIW  R3,0
  689 f35a: 1c 00 00            MVIW  R4,0
  690 f35d: 1e 00 00            MVIW  R6,0
  691 f360: 04 f4 08            JSR   ldbyte            ; byte count
  692 f363: 34                  MVARL R4
  693 f364: 04 f4 08            JSR   ldbyte            ; address high
  694 f367: 3f                  MVARH R7
  695 f368: 04 f4 08            JSR   ldbyte            ; address low
  696 f36b: 37                  MVARL R7
  697 f36c: 04 f4 08            JSR   ldbyte            ; record type
  698 f36f: 35                  MVARL R5
  699 f370:             ldloop:
  700 f370: 24                  MVRLA R4
  701 f371: a1 f3 a0            BRZ   ldsum
  702 f374: 04 f4 08            JSR   ldbyte
  703 f377: 09                  PUSH
  704 f378: 25                  MVRLA R5
  705 f379: a2 f3 9a            BRNZ  ldskip            ; not a data record: check only
  706 f37c: 2f                  MVRHA R7                ; protect everything outside $1000-$DFFF
  707 f37d: 0d 0f               LDTI  00fh
  708 f37f: a9 f3 85            BRGT  ldlowok
  709 f382: a0 f3 97            BR    ldref
  710 f385:             ldlowok:
  711 f385: 0d df               LDTI  0dfh
  712 f387: a9 f3 97            BRGT  ldref
