 1745 fa3f:             ;
 1746 fa3f: 04 f3 3e            JSR   kbst
 1747 fa42: a1 fa 49            BRZ   uartwt
 1748 fa45: 9e                  INP   PE
 1749 fa46: a0 fa 54            BR    uartcv
 1750 fa49: 70 68       uartwt: OUTI  P0,(UARTCS!UARTA5)
 1751 fa4b: 91                  INP   p1
 1752 fa4c: b3 01               ANDI  01h
 1753 fa4e: a1 fa 3f            BRZ   emulator3
 1754 fa51: 70 40               OUTI  P0,(UARTCS)
 1755 fa53: 91                  INP   P1
 1756 fa54: 0d 0d       uartcv: ldti 0dh          ; cobvert 0x0d to 0x0a
 1757 fa56: aa fa 5b            brneq uartinc
 1758 fa59: 0e 0a               ldai 0ah
 1759 fa5b:             uartinc:
 1760 fa5b: 04 f9 fe            JSR   LEDOUT
 1761 fa5e:             ;
 1762 fa5e:             ; emulator
 1763 fa5e:             ;
 1764 fa5e:             ;        ldti  0ah
 1765 fa5e:             ;        breq uartin
 1766 fa5e: 04 fa 10            JSR   uartout
 1767 fa61: 05                  RET
 1768 fa62:             ;
 1769 fa62:             ; uartinne: uartin WITHOUT the echo and the LED (2026-09-23, vector $FFFC): Y1/OS's CONIN syscall reads the
 1770 fa62:             ; console for a program (a filter reading its input) and the shell echoes what it wants itself. Same paths:
 1771 fa62:             ; port 2 on the instruction-level emulator (BRDEV), the UART on the machine; CR becomes LF.
 1772 fa62:             ;
 1773 fa62:             uartinne:
 1774 fa62: af fa 67            BRDEV uartinnehw
 1775 fa65: 92                  inp p2
 1776 fa66: 05                  ret
 1777 fa67:             uartinnehw:
 1778 fa67: 04 f3 3e            JSR   kbst              ; 2026-11-10: the V2.0 card's keyboard, else the UART
 1779 fa6a: a1 fa 71            BRZ   uartinnew
 1780 fa6d: 9e                  INP   PE
 1781 fa6e: a0 fa 7c            BR    uartinnecv
 1782 fa71:             uartinnew:
 1783 fa71: 70 68               OUTI  P0,(UARTCS!UARTA5)
 1784 fa73: 91                  INP   p1
 1785 fa74: b3 01               ANDI  01h
 1786 fa76: a1 fa 67            BRZ   uartinnehw
 1787 fa79: 70 40               OUTI  P0,(UARTCS)
 1788 fa7b: 91                  INP   P1
 1789 fa7c:             uartinnecv:
 1790 fa7c: 0d 0d               ldti 0dh
 1791 fa7e: aa fa 83            brneq uartinnec
 1792 fa81: 0e 0a               ldai 0ah
 1793 fa83:             uartinnec:
 1794 fa83: 05                  RET
