  879 f524:             ;
  880 f524:             ; ---- Video card driver (YACC1-D 2026-09-25) --------------------------------------------------------------------
  881 f524:             ; The screen is VCOLSV x VROWS bytes from VIDRAM, row after row; a byte's bits 0-5 pick one of the 64 glyphs of the
  882 f524:             ; character EPROM (the card latches VDATA0..5 only), bit 7 is inverse video, bit 6 is unused. The driver stores
  883 f524:             ; ASCII with $60-$7F moved to $40-$5F (upper case), so a 2513-style set (code = ASCII bits 0-5) shows the text as sent. Cursor: VROW/VCOL, VLINE =
  884 f524:             ; the address of the row. vputc handles CR (column 0), LF (column 0 of the next row: Y1/OS ends lines with LF
  885 f524:             ; alone), BS (one left, no erase), TAB (spaces to the next multiple of 8), FF (clear + home); other control bytes and
  886 f524:             ; DEL are ignored; a character in the last column wraps; LF on the last row scrolls (the whole screen moves up one
  887 f524:             ; row, the last row is blanked). Only instructions of the 2021 set: no LDZ/STZ/ADDIW/SHL16/BRUR, no R2.
  888 f524:             ;
  889 f524:             ; vidreset: at reset. Mirroring and the CRTC cursor off, cursor home, probe; with VIDAUTO also V I + mirroring on.
  890 f524:             vidreset:
  891 f524: 0e 00               LDAI 0
  892 f526: e5 0f f1            STA VIDMIR
  893 f529: e5 0f f2            STA VIDCUR
  894 f52c: 04 f5 8c            JSR vhome
  895 f52f: 04 f5 46            JSR vprobe
  896 f532: 0e 00               LDAI VIDAUTO
  897 f534: a1 f5 45            BRZ vidrx
  898 f537: e4 0f f0            LDA VIDPRES
  899 f53a: a1 f5 45            BRZ vidrx
  900 f53d: 04 f5 65            JSR vinit
  901 f540: 0e 01               LDAI 1
  902 f542: e5 0f f1            STA VIDMIR
  903 f545: 05          vidrx:  RET
  904 f546:             ;
  905 f546:             ; vprobe: VIDPRES (and ACC) = 1 when IN PC (the V2.0 card's status) reads $5x, the card ID in bits 7..4, else 0
  906 f546:             ; (2026-11-10; the V1 cards' probe wrote $55/$AA at VIDRAM). With no card the port is not decoded and reads the
  907 f546:             ; floating bus: $FF on the pull-ups, or the INP's own opcode $9C - neither is $5x.
  908 f546: 9c          vprobe: INP PC
  909 f547: b3 f0               ANDI 0f0h
  910 f549: 0d 70               LDTI 070h
  911 f54b: aa f5 53            BRNEQ vprno
  912 f54e: 0e 01               LDAI 1
  913 f550: a0 f5 55            BR vprset
  914 f553: 0e 00       vprno:  LDAI 0
  915 f555: e5 0f f0    vprset: STA VIDPRES
  916 f558: 04 f5 5f            JSR vmode
  917 f55b: e4 0f f0            LDA VIDPRES
  918 f55e: 05                  RET
  919 f55f:             ;
  920 f55f:             ; vmode (2026-10-22; 2026-11-10 the V2.0 card): the geometry from the DOTS jumper, IN PC bit 0 (read only when the
  921 f55f:             ; probe found the card): 1 (open) = 6 dots, 80 x 24; 0 (fitted) = 8 dots, 64 x 24, the mode the graphics layer needs;
  922 f55f:             ; both from the 12 MHz crystal. Sets VCOLSV and VSCRLN; R6 = the CRTC's R0..R3 for vinit (the rest are common: vcrtab)
  923 f55f: 0e 50       vmode:  LDAI 80                 ; V4: 80 columns, always
  924 f561: e5 0f f8            STA VCOLSV
  925 f564: 05                  RET
  926 f565:             ;
  927 f565:             ; vinit: the control register 0 (text on, graphics off: direct mode, plane and pages 0), the CRTC's 16 registers -
  928 f565:             ; R0..R3 for the mode vmode found, R4..R15 from vcrtab - through OUT PA / OUT PB, the CRTC cursor on, then vcls
  929 f565:             ; (R6, R7 clobbered)
  930 f565: 04 f5 5f    vinit:  JSR vmode
  931 f568: 7c 00               OUTI PC,0
  932 f56a: 0e 00               LDAI 0                  ; V4: control 2 and its copy 0 - text on, the cursor's left half, both syncs
  933 f56c: e5 0f f9            STA VIDC2               ;   negative, the three guns on (white)
  934 f56f: 6f                  OUTA PF
  935 f570: 1e f8 a9            MVIW R6,vcrtab
  936 f573: 0e 00               LDAI 0
  937 f575: 6a          vinitl: OUTA PA
  938 f576: 09                  PUSH
  939 f577: 46          vinitn: LDAVR R6
  940 f578: 6b                  OUTA PB
  941 f579: 56                  INCR R6
  942 f57a: 0a                  POP
  943 f57b: b0 01               ADDI 1
  944 f57d: 0d 10               LDTI 16
  945 f57f: aa f5 75            BRNEQ vinitl
  946 f582: 0e 01               LDAI 1
  947 f584: e5 0f f2            STA VIDCUR
  948 f587:             ; vcls: every byte of the display RAM a space, cursor home
  949 f587: 0e 20       vcls:   LDAI ' '
  950 f589: 04 f5 9b            JSR vfill
  951 f58c:             ; vhome: cursor to row 0, column 0 (R7 clobbered)
  952 f58c: 0e 00       vhome:  LDAI 0
  953 f58e: e5 0f f3            STA VROW
  954 f591: e5 0f f4            STA VCOL
  955 f594: 1f d0 00            MVIW R7,VIDRAM
  956 f597: ef 0f f6            STR R7,VLINE
  957 f59a: 05                  RET
  958 f59b:             ;
  959 f59b:             ; vfill: ACC to all VIDSIZE bytes of the display RAM, 8 per pass (R7, TMP clobbered, R5 kept)
  960 f59b: 07 05       vfill:  PUSHR R5
  961 f59d: 0b                  MVAT
  962 f59e: 1f d0 00            MVIW R7,VIDRAM
  963 f5a1: 15 00               MVIB R5,(VIDSIZE/8).0
  964 f5a3: 0c          vfilll: MVTA
  965 f5a4: 4f                  STAVR R7
  966 f5a5: 57                  INCR R7
  967 f5a6: 4f                  STAVR R7
  968 f5a7: 57                  INCR R7
  969 f5a8: 4f                  STAVR R7
  970 f5a9: 57                  INCR R7
  971 f5aa: 4f                  STAVR R7
  972 f5ab: 57                  INCR R7
  973 f5ac: 4f                  STAVR R7
  974 f5ad: 57                  INCR R7
  975 f5ae: 4f                  STAVR R7
  976 f5af: 57                  INCR R7
  977 f5b0: 4f                  STAVR R7
  978 f5b1: 57                  INCR R7
  979 f5b2: 4f                  STAVR R7
  980 f5b3: 57                  INCR R7
  981 f5b4: 5d                  DECR R5
  982 f5b5: 25                  MVRLA R5
  983 f5b6: a2 f5 a3            BRNZ vfilll
  984 f5b9: 08 50               POPR R5
  985 f5bb: 05                  RET
  986 f5bc:             ;
  987 f5bc:             ; vputc: ACC to the screen at the cursor (see above). Keeps R3-R7 and TMP; ACC is not kept (charout has its copy).
  988 f5bc: e5 0f f5    vputc:  STA VCHAR
  989 f5bf: 0c                  MVTA
  990 f5c0: 09                  PUSH
  991 f5c1: 07 07               PUSHR R7
  992 f5c3: e4 0f f5            LDA VCHAR
  993 f5c6: b3 7f               ANDI 07fh
  994 f5c8: 0d 20               LDTI 020h
  995 f5ca: a7 f5 dd            BRLT vpctl
  996 f5cd: 0d 7f               LDTI 07fh
  997 f5cf: a8 f5 d5            BREQ vpdone
  998 f5d2: 04 f6 28            JSR vpchar
  999 f5d5: 04 f6 ba    vpdone: JSR vcursor
 1000 f5d8: 08 70               POPR R7
 1001 f5da: 0a                  POP
 1002 f5db: 0b                  MVAT
 1003 f5dc: 05                  RET
 1004 f5dd: 0d 0d       vpctl:  LDTI 0dh
 1005 f5df: a8 f6 06            BREQ vpcr
 1006 f5e2: 0d 0a               LDTI 0ah
 1007 f5e4: a8 f6 0e            BREQ vplf
 1008 f5e7: 0d 08               LDTI 08h
 1009 f5e9: a8 f6 14            BREQ vpbs
 1010 f5ec: 0d 0c               LDTI 0ch
 1011 f5ee: a8 f6 22            BREQ vpff
 1012 f5f1: 0d 09               LDTI 09h
 1013 f5f3: aa f5 d5            BRNEQ vpdone
 1014 f5f6: 0e 20       vptab:  LDAI ' '
 1015 f5f8: 04 f6 28            JSR vpchar
 1016 f5fb: e4 0f f4            LDA VCOL
 1017 f5fe: b3 07               ANDI 7
 1018 f600: a2 f5 f6            BRNZ vptab
 1019 f603: a0 f5 d5            BR vpdone
 1020 f606: 0e 00       vpcr:   LDAI 0
 1021 f608: e5 0f f4            STA VCOL
 1022 f60b: a0 f5 d5            BR vpdone
 1023 f60e: 04 f6 40    vplf:   JSR vlf
 1024 f611: a0 f5 d5            BR vpdone
 1025 f614: e4 0f f4    vpbs:   LDA VCOL
 1026 f617: a1 f5 d5            BRZ vpdone
 1027 f61a: b1 01               SUBI 1
 1028 f61c: e5 0f f4            STA VCOL
 1029 f61f: a0 f5 d5            BR vpdone
 1030 f622: 04 f5 87    vpff:   JSR vcls
 1031 f625: a0 f5 d5            BR vpdone
 1032 f628:             ;
 1033 f628:             ; vpchar: ACC stored at the cursor, the cursor one right; past the last column to the next row (R7, TMP clobbered)
 1034 f628: 09          vpchar: PUSH
 1035 f629: 04 f6 ac            JSR vcaddr
 1036 f62c: 0a                  POP
 1037 f62d: 4f                  STAVR R7
 1038 f62e: e4 0f f4            LDA VCOL
 1039 f631: b0 01               ADDI 1
 1040 f633: e5 0f f4            STA VCOL
 1041 f636: e6 0f f8            LDT VCOLSV
 1042 f639: aa f6 3f            BRNEQ vpchx
 1043 f63c: 04 f6 40            JSR vlf
 1044 f63f: 05          vpchx:  RET
 1045 f640:             ;
 1046 f640:             ; vlf: column 0 of the next row; on the last row the screen scrolls instead (R7, TMP clobbered)
 1047 f640: 0e 00       vlf:    LDAI 0
 1048 f642: e5 0f f4            STA VCOL
 1049 f645: e4 0f f3            LDA VROW
 1050 f648: b0 01               ADDI 1
 1051 f64a: 0d 19               LDTI VROWS
 1052 f64c: a8 f6 5f            BREQ vscroll
 1053 f64f: e5 0f f3            STA VROW
 1054 f652: f7 0f f6            LDR R7,VLINE
 1055 f655: e6 0f f8            LDT VCOLSV
 1056 f658: 04 f6 b2            JSR vaddt
 1057 f65b: ef 0f f6            STR R7,VLINE
 1058 f65e: 05                  RET
 1059 f65f:             ;
 1060 f65f:             ; vscroll: rows 1..VROWS-1 up one row (8 bytes per pass), the last row blanked; R5/R6 kept, R7 clobbered
 1061 f65f:             vscroll:
 1062 f65f: 07 06               PUSHR R6
 1063 f661: 07 05               PUSHR R5
 1064 f663: 1f d0 00            MVIW R7,VIDRAM
 1065 f666: e6 0f f8            LDT VCOLSV
 1066 f669: 04 f6 b2            JSR vaddt
 1067 f66c: 07 07               PUSHR R7
 1068 f66e: 08 60               POPR R6                 ; R6 = VIDRAM + VCOLSV: row 1
 1069 f670: 1f d0 00            MVIW R7,VIDRAM
 1070 f673: 0e f0               LDAI 240                ; 80*(VROWS-1)/8
 1071 f675: 35                  MVARL R5
 1072 f676: 46          vscrl:  LDAVR R6
 1073 f677: 4f                  STAVR R7
 1074 f678: 56                  INCR R6
 1075 f679: 57                  INCR R7
 1076 f67a: 46                  LDAVR R6
 1077 f67b: 4f                  STAVR R7
 1078 f67c: 56                  INCR R6
 1079 f67d: 57                  INCR R7
 1080 f67e: 46                  LDAVR R6
 1081 f67f: 4f                  STAVR R7
 1082 f680: 56                  INCR R6
 1083 f681: 57                  INCR R7
 1084 f682: 46                  LDAVR R6
 1085 f683: 4f                  STAVR R7
 1086 f684: 56                  INCR R6
 1087 f685: 57                  INCR R7
 1088 f686: 46                  LDAVR R6
 1089 f687: 4f                  STAVR R7
 1090 f688: 56                  INCR R6
 1091 f689: 57                  INCR R7
 1092 f68a: 46                  LDAVR R6
 1093 f68b: 4f                  STAVR R7
 1094 f68c: 56                  INCR R6
 1095 f68d: 57                  INCR R7
 1096 f68e: 46                  LDAVR R6
 1097 f68f: 4f                  STAVR R7
 1098 f690: 56                  INCR R6
 1099 f691: 57                  INCR R7
 1100 f692: 46                  LDAVR R6
 1101 f693: 4f                  STAVR R7
 1102 f694: 56                  INCR R6
 1103 f695: 57                  INCR R7
 1104 f696: 5d                  DECR R5
 1105 f697: 25                  MVRLA R5
 1106 f698: a2 f6 76            BRNZ vscrl
 1107 f69b: e4 0f f8            LDA VCOLSV
 1108 f69e: 35                  MVARL R5
 1109 f69f: d7 20       vscrb:  LDIVR R7,' '
 1110 f6a1: 57                  INCR R7
 1111 f6a2: 5d                  DECR R5
 1112 f6a3: 25                  MVRLA R5
 1113 f6a4: a2 f6 9f            BRNZ vscrb
 1114 f6a7: 08 50               POPR R5
 1115 f6a9: 08 60               POPR R6
 1116 f6ab: 05                  RET
 1117 f6ac:             ;
 1118 f6ac:             ; vupper: $60-$7F down to $40-$5F (lower case to upper; the monitor's toupper also moves [ \ ] ^ _, which the
 1119 f6ac:             ; 64-glyph set has)
 1120 f6ac:             ;
 1121 f6ac:             ; vcaddr: R7 = VLINE + VCOL, the cursor's address (TMP clobbered)
 1122 f6ac: e6 0f f4    vcaddr: LDT VCOL
 1123 f6af: f7 0f f6            LDR R7,VLINE
 1124 f6b2:             ; vaddt: R7 += TMP (8 bits). The ADDIC follows the ADDI with only register moves between: the carry is the add's
 1125 f6b2:             ; on the machine and on both emulators (docs/programming/ISA-REFERENCE.md section 6)
 1126 f6b2: 27          vaddt:  MVRLA R7
 1127 f6b3: b8                  ADDT
 1128 f6b4: 37                  MVARL R7
 1129 f6b5: 2f                  MVRHA R7
 1130 f6b6: e2 00               ADDIC 0
 1131 f6b8: 3f                  MVARH R7
 1132 f6b9: 05                  RET
 1133 f6ba:             ;
 1134 f6ba:             ; vcursor: with VIDCUR set, the CRTC's cursor registers R14/R15 <- the cursor's offset from VIDRAM (R7 clobbered)
 1135 f6ba:             vcursor:
 1136 f6ba: e4 0f f2            LDA VIDCUR
 1137 f6bd: a1 f6 ea            BRZ vcurx
 1138 f6c0: 04 f6 ac            JSR vcaddr
 1139 f6c3:             ; V4: the 6845 counts pairs of characters. R14/R15 = the cursor's offset from VIDRAM halved (the start address is
 1140 f6c3:             ; 0), and the offset's bit 0 is CURH, control 2's bit 1: the cursor on the right-hand character of its count
 1141 f6c3: 0e 0e               LDAI 14
 1142 f6c5: 6a                  OUTA PA
 1143 f6c6: 2f                  MVRHA R7
 1144 f6c7: b1 d0               SUBI (VIDRAM).1         ; the offset's high byte, 0..7
 1145 f6c9: b7                  SHR
 1146 f6ca: 6b                  OUTA PB
 1147 f6cb: 0e 0f               LDAI 15
 1148 f6cd: 6a                  OUTA PA
 1149 f6ce: 2f                  MVRHA R7                ; its bit 0 ((VIDRAM).1 is even) is bit 7 of the halved low byte
 1150 f6cf: b3 01               ANDI 1
 1151 f6d1: a1 f6 d6            BRZ vcur1
 1152 f6d4: 0e 80               LDAI 080h
 1153 f6d6: 0b          vcur1:  MVAT
 1154 f6d7: 27                  MVRLA R7
 1155 f6d8: b7                  SHR
 1156 f6d9: ba                  ORT
 1157 f6da: 6b                  OUTA PB
 1158 f6db: 27                  MVRLA R7                ; CURH
 1159 f6dc: b3 01               ANDI 1
 1160 f6de: b6                  SHL
 1161 f6df: 0b                  MVAT
 1162 f6e0: e4 0f f9            LDA VIDC2
 1163 f6e3: b3 fd               ANDI 0fdh
 1164 f6e5: ba                  ORT
 1165 f6e6: e5 0f f9            STA VIDC2
 1166 f6e9: 6f                  OUTA PF
 1167 f6ea: 05          vcurx:  RET
 1168 f6eb:             ;
 1169 f6eb:             ; vidctl: the video entry at $FFBC (JSR vidctl / RET, below the full vector table), for Y1/OS and programs.
 1170 f6eb:             ; ACC = 0 probe (ACC = VIDPRES), 1 init (V I), 2 clear + home (V C); anything else: ACC = VIDPRES.
 1171 f6eb:             ; A caller checks that $FFBC holds $04 (JSR) first: an older ROM has $FF there. Clobbers R5-R7, TMP.
 1172 f6eb: 0d 01       vidctl: LDTI 1
 1173 f6ed: a8 f6 fe            BREQ vctli
 1174 f6f0: 0d 02               LDTI 2
 1175 f6f2: a8 f7 04            BREQ vctlc
 1176 f6f5: a2 f7 07            BRNZ vctlx
 1177 f6f8: 04 f5 46            JSR vprobe
 1178 f6fb: a0 f7 07            BR vctlx
 1179 f6fe: 04 f5 65    vctli:  JSR vinit
 1180 f701: a0 f7 07            BR vctlx
 1181 f704: 04 f5 87    vctlc:  JSR vcls
 1182 f707: e4 0f f0    vctlx:  LDA VIDPRES
 1183 f70a: 05                  RET
 1184 f70b:             ;
 1185 f70b:             ; ---- V: the video unit (monitor command) ---------------------------------------------------------------------
 1186 f70b:             ; V then a letter (blanks skipped); numbers are hex, blanks between them optional. V? (or any other letter) lists:
 1187 f70b:             ;   VS  status          VP  probe again      VI  init (CRTC, clear, home)     VC  clear, home
 1188 f70b:             ;   VM1 / VM0  mirror on / off               VW rr cc text  text at row rr, column cc (not the cursor)
 1189 f70b:             ;   VB aaaa bb bb ..  bytes from aaaa ($Dxxx only)   VF bb  fill the 2K     VD  the screen as text (not mirrored)
 1190 f70b:             ;   VR rr [vv]  write CRTC register rr, or read it
 1191 f70b:             ;
 1192 f70b:             cmd_video:
 1193 f70b: 0d 00               LDTI NOMODE
 1194 f70d: e7 0f 00            STT monmode
 1195 f710: 04 f8 9a            JSR vskip
 1196 f713: 04 f8 ed            JSR toupper
 1197 f716: 0d 53               LDTI 'S'
 1198 f718: a8 f7 68            BREQ vcstat
 1199 f71b: 0d 50               LDTI 'P'
 1200 f71d: a8 f7 4e            BREQ vcprob
 1201 f720: 0d 49               LDTI 'I'
 1202 f722: a8 f7 54            BREQ vcinit
 1203 f725: 0d 43               LDTI 'C'
 1204 f727: a8 f7 5a            BREQ vcclr
 1205 f72a: 0d 4d               LDTI 'M'
 1206 f72c: a8 f7 60            BREQ vcmir
 1207 f72f: 0d 57               LDTI 'W'
 1208 f731: a8 f7 a8            BREQ vcwrt
 1209 f734: 0d 42               LDTI 'B'
 1210 f736: a8 f7 fd            BREQ vcbyt
 1211 f739: 0d 46               LDTI 'F'
 1212 f73b: a8 f8 22            BREQ vcfil
 1213 f73e: 0d 44               LDTI 'D'
 1214 f740: a8 f8 2b            BREQ vcdump
 1215 f743: 0d 52               LDTI 'R'
 1216 f745: a8 f8 75            BREQ vcreg
 1217 f748: 1f fe ba            MVIW R7,VHELP
 1218 f74b: a0 f7 8c            BR vcmsg
 1219 f74e: 04 f5 46    vcprob: JSR vprobe
 1220 f751: a0 f7 68            BR vcstat
 1221 f754: 04 f5 65    vcinit: JSR vinit
 1222 f757: a0 f7 68            BR vcstat
 1223 f75a: 04 f5 87    vcclr:  JSR vcls
 1224 f75d: a0 f7 89            BR vcok
 1225 f760: 04 f8 9a    vcmir:  JSR vskip                ; '1' ($31) -> 1, '0' ($30) -> 0
 1226 f763: b3 01               ANDI 1
 1227 f765: e5 0f f1            STA VIDMIR
 1228 f768: 1f fe 84    vcstat: MVIW R7,MSGVST          ; VIDPRES, VIDMIR, VIDCUR, VROW, VCOL ($0FF0-$0FF4), each after its label
 1229 f76b: 1e 0f f0            MVIW R6,VIDPRES
 1230 f76e: 04 fa 02    vcstl:  JSR stringout
 1231 f771: 57                  INCR R7
 1232 f772: 46                  LDAVR R6
 1233 f773: 04 f9 c5            JSR showbytea
 1234 f776: 56                  INCR R6
 1235 f777: 26                  MVRLA R6
 1236 f778: 0d f5               LDTI (VCOL+1).0
 1237 f77a: aa f7 6e            BRNEQ vcstl
 1238 f77d: 1f fe ad            MVIW R7,MSGVCOL         ; 2026-10-22: the columns vmode set ($50 or $40)
 1239 f780: 04 fa 02            JSR stringout
 1240 f783: e4 0f f8            LDA VCOLSV
 1241 f786: 04 f9 c5            JSR showbytea
 1242 f789: 1f fa de    vcok:   MVIW R7,CRLF
 1243 f78c: 04 fa 02    vcmsg:  JSR stringout
 1244 f78f: a0 f0 6a            BR cmdloop
 1245 f792: 19 0e ff    vcbad:  MVIW R1,STACK           ; from any depth: the V command runs from the command loop, whose stack is empty
 1246 f795: 04 fa 3a    vcbadl: JSR uartin              ; the rest of the line is dropped (else its characters would run as commands:
 1247 f798: 0d 0a               LDTI 0ah                ; a 0 would stop the machine)
 1248 f79a: a8 f7 a2            BREQ vcbadx
 1249 f79d: 0d 0d               LDTI 0dh
 1250 f79f: aa f7 95            BRNEQ vcbadl
 1251 f7a2: 1f fe b5    vcbadx: MVIW R7,MSGVBAD
 1252 f7a5: a0 f7 8c            BR vcmsg
 1253 f7a8:             ;
 1254 f7a8:             ; VW rr cc text: rows 0..VROWS-1, columns 0..VCOLSV-1; one blank after cc is the separator, the text runs to CR/LF
 1255 f7a8:             ; (upper-cased, stored as typed, it may run on into the next rows but stops at the end of the display RAM)
 1256 f7a8: 04 f8 a3    vcwrt:  JSR vgetb
 1257 f7ab: 0d 18               LDTI VROWS-1
 1258 f7ad: a9 f7 92            BRGT vcbad
 1259 f7b0: 09                  PUSH
 1260 f7b1: 04 f8 a3            JSR vgetb
 1261 f7b4: e5 0f f5            STA VCHAR
 1262 f7b7: e4 0f f8            LDA VCOLSV
 1263 f7ba: b1 01               SUBI 1
 1264 f7bc: 0b                  MVAT
 1265 f7bd: e4 0f f5            LDA VCHAR
 1266 f7c0: a9 f7 92            BRGT vcbad
 1267 f7c3: 0a                  POP
 1268 f7c4: 1f d0 00            MVIW R7,VIDRAM
 1269 f7c7: a1 f7 d7    vcwrl:  BRZ vcwrc
 1270 f7ca: 09                  PUSH
 1271 f7cb: e6 0f f8            LDT VCOLSV
 1272 f7ce: 04 f6 b2            JSR vaddt
 1273 f7d1: 0a                  POP
 1274 f7d2: b1 01               SUBI 1
 1275 f7d4: a0 f7 c7            BR vcwrl
 1276 f7d7: e6 0f f5    vcwrc:  LDT VCHAR
 1277 f7da: 04 f6 b2            JSR vaddt
 1278 f7dd: 04 fa 3a            JSR uartin
 1279 f7e0: 0d 20               LDTI ' '
 1280 f7e2: aa f7 e8            BRNEQ vcwrs
 1281 f7e5: 04 fa 3a    vcwrn:  JSR uartin
