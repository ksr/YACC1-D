  510 f27a:             ;
  511 f27a:             ; ---- CompactFlash driver (YACC1-D 2026-09-22) -----------------------------------------------------------
  512 f27a:             ; The card sits on two ports: P8 = register-select latch (ATA task-file register 0-7), P9 = data.
  513 f27a:             ; 8-bit True IDE mode. Registers: 0 data, 1 error/feature, 2 sector count, 3-5 LBA0-2, 6 drive/head, 7 status/cmd.
  514 f27a:             ; Entry points (also BIOS vectors at 0FFECh..): cfinit  ACC = 0 ok / 1 error (absent card times out);
  515 f27a:             ;   cfread   sector CFLBA0..2 -> (R7), R7 += 512, ACC = 0 ok / 1 error;   cfwrite  (R7) -> sector, R7 += 512, same;
  516 f27a:             ;   R6 and TMP are clobbered. const  ACC = 1 when a console byte waits (0 otherwise).
  517 f27a:             ;
  518 f27a:             CFSEL_DATA:  EQU 0
  519 f27a:             CFSEL_FEAT:  EQU 1
  520 f27a:             CFSEL_SCNT:  EQU 2
  521 f27a:             CFSEL_LBA0:  EQU 3
  522 f27a:             CFSEL_LBA1:  EQU 4
  523 f27a:             CFSEL_LBA2:  EQU 5
  524 f27a:             CFSEL_HEAD:  EQU 6
  525 f27a:             CFSEL_CMD:   EQU 7
  526 f27a:             ;
  527 f27a:             ; wait while BSY (bit 7), bounded to 65536 polls; returns the status in ACC
  528 f27a:             cfwait:
  529 f27a: 1e 00 00            MVIW R6,0
  530 f27d:             cfwaitl:
  531 f27d: 78 07               OUTI P8,CFSEL_CMD
  532 f27f: 99                  INP P9
  533 f280: b3 80               ANDI 080H
  534 f282: a1 f2 8e            BRZ cfwaitd
  535 f285: 5e                  DECR R6
  536 f286: 26                  MVRLA R6
  537 f287: a2 f2 7d            BRNZ cfwaitl
  538 f28a: 2e                  MVRHA R6
  539 f28b: a2 f2 7d            BRNZ cfwaitl
  540 f28e:             cfwaitd:
  541 f28e: 78 07               OUTI P8,CFSEL_CMD
  542 f290: 99                  INP P9
  543 f291: 05                  RET
  544 f292:             ;
  545 f292:             ; wait until DRQ (bit 3), bounded; returns the status in ACC
  546 f292:             cfdrq:
  547 f292: 1e 00 00            MVIW R6,0
  548 f295:             cfdrql:
  549 f295: 78 07               OUTI P8,CFSEL_CMD
  550 f297: 99                  INP P9
  551 f298: b3 08               ANDI 008H
  552 f29a: a2 f2 a6            BRNZ cfdrqd
  553 f29d: 5e                  DECR R6
  554 f29e: 26                  MVRLA R6
  555 f29f: a2 f2 95            BRNZ cfdrql
  556 f2a2: 2e                  MVRHA R6
  557 f2a3: a2 f2 95            BRNZ cfdrql
  558 f2a6:             cfdrqd:
  559 f2a6: 78 07               OUTI P8,CFSEL_CMD
  560 f2a8: 99                  INP P9
  561 f2a9: 05                  RET
  562 f2aa:             ;
  563 f2aa:             cfinit:
  564 f2aa: 04 f2 7a            JSR cfwait
  565 f2ad: 78 06               OUTI P8,CFSEL_HEAD
  566 f2af: 79 e0               OUTI P9,0E0H            ; LBA mode, drive 0
  567 f2b1: 78 01               OUTI P8,CFSEL_FEAT
  568 f2b3: 79 01               OUTI P9,001H            ; feature 1: 8-bit transfers
  569 f2b5: 78 07               OUTI P8,CFSEL_CMD
  570 f2b7: 79 ef               OUTI P9,0EFH            ; SET FEATURES
  571 f2b9: 04 f2 7a            JSR cfwait
  572 f2bc: b3 01               ANDI 001H               ; ERR bit; an absent card reads FFh and times out -> 1
  573 f2be: 05                  RET
  574 f2bf:             ;
  575 f2bf:             ; task file <- CFLBA0..2, LBA mode, one sector
  576 f2bf:             cfsetl:
  577 f2bf: 78 03               OUTI P8,CFSEL_LBA0
  578 f2c1: e4 0f 10            LDA CFLBA0
  579 f2c4: 69                  OUTA P9
  580 f2c5: 78 04               OUTI P8,CFSEL_LBA1
  581 f2c7: e4 0f 11            LDA CFLBA1
  582 f2ca: 69                  OUTA P9
  583 f2cb: 78 05               OUTI P8,CFSEL_LBA2
  584 f2cd: e4 0f 12            LDA CFLBA2
  585 f2d0: 69                  OUTA P9
  586 f2d1: 78 06               OUTI P8,CFSEL_HEAD
  587 f2d3: 79 e0               OUTI P9,0E0H
  588 f2d5: 78 02               OUTI P8,CFSEL_SCNT
  589 f2d7: 79 01               OUTI P9,1
  590 f2d9: 05                  RET
  591 f2da:             ;
  592 f2da:             cfread:
  593 f2da: 04 f2 7a            JSR cfwait
  594 f2dd: 04 f2 bf            JSR cfsetl
  595 f2e0: 78 07               OUTI P8,CFSEL_CMD
  596 f2e2: 79 20               OUTI P9,020H            ; READ SECTORS
  597 f2e4: 04 f2 92            JSR cfdrq
  598 f2e7: b3 08               ANDI 008H
  599 f2e9: a1 f3 00            BRZ cferr
  600 f2ec: 78 00               OUTI P8,CFSEL_DATA
  601 f2ee: 1e 02 00            MVIW R6,512
  602 f2f1:             cfrdl:
  603 f2f1: 99                  INP P9
  604 f2f2: 4f                  STAVR R7
  605 f2f3: 57                  INCR R7
  606 f2f4: 5e                  DECR R6
  607 f2f5: 26                  MVRLA R6
  608 f2f6: a2 f2 f1            BRNZ cfrdl
  609 f2f9: 2e                  MVRHA R6
  610 f2fa: a2 f2 f1            BRNZ cfrdl
  611 f2fd: 0e 00               LDAI 0
  612 f2ff: 05                  RET
  613 f300:             cferr:
  614 f300: 0e 01               LDAI 1
  615 f302: 05                  RET
  616 f303:             ;
  617 f303:             cfwrite:
  618 f303: 04 f2 7a            JSR cfwait
  619 f306: 04 f2 bf            JSR cfsetl
  620 f309: 78 07               OUTI P8,CFSEL_CMD
  621 f30b: 79 30               OUTI P9,030H            ; WRITE SECTORS
  622 f30d: 04 f2 92            JSR cfdrq
