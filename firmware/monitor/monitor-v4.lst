  717 f38e: a8 f3 9b            BREQ  ldnext
  718 f391: 1e 00 02            MVIW  R6,2
  719 f394: a0 f3 9b            BR    ldnext
  720 f397:             ldref:
  721 f397: 1e 00 02            MVIW  R6,2
  722 f39a:             ldskip:
