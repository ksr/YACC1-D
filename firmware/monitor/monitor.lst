 1319 f879:             ;
 1320 f879:             ; the CRTC registers R0..R15 for vinit. Timing ASSUMED (no crystal value in the tree, docs/cards/video.md 3.4): a
 1321 f879:             ; 10 MHz dot clock, 5 dots a character (IC28 divides by 5), 8 scan lines a row (RA0..2): a 2 MHz character clock,
 1322 f879:             ; 127 characters a line = 63.5 us (15.7 kHz), 32 rows + 6 lines = 262 lines (60 Hz), non-interlaced. Re-derive R0-R7
 1323 f879:             ; when the crystal is known; R1/R6 follow VCOLS/VROWS.
 1324 f879: 7e          vcrtab: DB 126            ; R0  horizontal total - 1
 1325 f87a: 50                  DB VCOLS          ; R1  characters displayed
 1326 f87b: 62                  DB 98             ; R2  horizontal sync position
 1327 f87c: 0a                  DB 10             ; R3  sync width (HS 10 characters)
 1328 f87d: 1f                  DB 31             ; R4  vertical total - 1 (rows)
 1329 f87e: 06                  DB 6              ; R5  vertical total adjust (scan lines)
 1330 f87f: 18                  DB VROWS          ; R6  rows displayed
 1331 f880: 1c                  DB 28             ; R7  vertical sync position (row)
 1332 f881: 00                  DB 0              ; R8  interlace mode: off
 1333 f882: 07                  DB 7              ; R9  scan lines per row - 1
 1334 f883: 67                  DB 067h           ; R10 cursor start line 7, blinking (1/16 field rate)
 1335 f884: 07                  DB 7              ; R11 cursor end line 7
 1336 f885: 00                  DB 0              ; R12 start address high
 1337 f886: 00                  DB 0              ; R13 start address low
 1338 f887: 00                  DB 0              ; R14 cursor address high
 1339 f888: 00                  DB 0              ; R15 cursor address low
