 1172 f71b: 05                  RET
 1173 f71c:             ;
 1174 f71c:             ; ---- V: the video unit (monitor command) ---------------------------------------------------------------------
 1175 f71c:             ; V then a letter (blanks skipped); numbers are hex, blanks between them optional. V? (or any other letter) lists:
 1176 f71c:             ;   VS  status          VP  probe again      VI  init (CRTC, clear, home)     VC  clear, home
 1177 f71c:             ;   VM1 / VM0  mirror on / off               VW rr cc text  text at row rr, column cc (not the cursor)
 1178 f71c:             ;   VB aaaa bb bb ..  bytes from aaaa ($Dxxx only)   VF bb  fill the 2K     VD  the screen as text (not mirrored)
 1179 f71c:             ;   VR rr [vv]  write CRTC register rr, or read it
 1180 f71c:             ;
 1181 f71c:             cmd_video:
 1182 f71c: 0d 00               LDTI NOMODE
 1183 f71e: e7 0f 00            STT monmode
 1184 f721: 04 f8 ad            JSR vskip
 1185 f724: 04 f9 04            JSR toupper
 1186 f727: 0d 53               LDTI 'S'
 1187 f729: a8 f7 79            BREQ vcstat
 1188 f72c: 0d 50               LDTI 'P'
