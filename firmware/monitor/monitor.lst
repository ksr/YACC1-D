   19 0000:             UARTA2:       EQU 010h
   20 0000:             UARTA3:       EQU 018h
   21 0000:             UARTA4:       EQU 020h
   22 0000:             UARTA5:       EQU 028h
   23 0000:             UARTA6:       EQU 030h
   24 0000:             UARTA7:       EQU 038h
   25 0000:             
   26 0000:             SWITCHLED:    EQU 001H
   27 0000:             LCDENABLE:    EQU 002H
   28 0000:             LCDREGISTER:  EQU 004H
   29 0000:             UARTCS:       EQU 040H
   30 0000:             TIL311:       EQU 080H
   31 0000:             
   32 0000:             CNTL-PORT:    EQU "P0"
   33 0000:             DATAPORT:     EQU "P1"
   34 0000:             
   35 0000:             ;
   36 0000:             ; MONITOR MODES
   37 0000:             ;
   38 0000:             NOMODE:       EQU 0
   39 0000:             EXAMINEMODE:  EQU 1
   40 0000:             DUMPMODE:     EQU 2
   41 0000:             BLOCKMODE:    EQU 3
   42 0000:             FILLMODE:     EQU 4
   43 0000:             LOADMODE:     EQU 5         ; 2026-09-23: after a ':' load, CR/LF at the prompt do nothing
   44 0000:             
   45 0000:             ;
   46 0000:             ; Monitor variables 0x0f00 - 0x0fff
   47 0000:             ;
   48 0000:             monmode:        EQU 0f00h
   49 0000:             continue_addr:  EQU 0f02h
   50 0000:             lderr:          EQU 0f01h    ; 2026-09-23: nonzero when a record of the current ':' load failed
   51 0000:             interupt_cnt:   EQU 0f04h
   52 0000:             ;
   53 0000:             ; CompactFlash driver variables (YACC1-D 2026-09-22) and the OS/program argument buffer
   54 0000:             ;
   55 0000:             CFLBA0:         EQU 0f10h    ; sector number for CFREAD/CFWRITE, low byte
   56 0000:             CFLBA1:         EQU 0f11h
   57 0000:             CFLBA2:         EQU 0f12h    ; high byte (24-bit LBA)
   58 0000:             ARGBUF:         EQU 0f40h    ; 64 bytes: the OS leaves a program's command tail here (NUL-terminated)
   59 0000:             OSBASE:         EQU 1000h    ; where the boot command loads the OS image (LBA 1..OSCNT) and calls it
   60 0000:             line_buffer:    EQU 0f80h    ; 112 bytes long max ($0FF0-$0FFF are the video variables since 2026-09-25)
   61 0000:             ;
   62 0000:             ; Video card (YACC1-D 2026-09-25). 2026-11-11 (branch video-v3): the video card V3 (docs/cards/video-v3.md) - the
   63 0000:             ; HD63484 ACRTC drawing a 640 x 480 picture, the card on I/O ports only: PA OUT the chip's address register, PB OUT its
   64 0000:             ; data (a register, or the write FIFO when the address register is 0), PC IN its status (bit 0 WFE: the write FIFO
   65 0000:             ; empty), PD IN its data; PE IN the card's status (bit 0 FULL: a PS/2 byte waits, bits 7..4 = 0110: the card ID) and
   66 0000:             ; OUT the PS/2 command, PF IN the PS/2 byte. Nothing in the $D000 block. The driver is always in the ROM; VIDAUTO
   67 0000:             ; decides whether reset also starts it: until the card is debugged it does not - reset only probes the card (VIDPRES,
   68 0000:             ; the banner says VIDEO CARD FOUND); V I starts the chip, copies the font and clears the screen, V M1 (or Y1/OS's
   69 0000:             ; `video on`) turns the mirroring on. The keyboard is a second console input beside the UART (kbst: uartin,
   70 0000:             ; uartinne, const).
   71 0000:             ;
   72 0000:             VIDAUTO:        EQU 0        ; 1 = reset also runs V I and sets VIDMIR when a card is found
   73 0000:             VROWS:          EQU 30       ; the screen: 80 x 30 characters of 8 x 16 dots
   74 0000:             VCOLS:          EQU 80
   75 0000:             VYHOME:         EQU 479      ; the Y of row 0's top line: the chip's Y runs up from the bottom line of the screen
   76 0000:             VIDPRES:        EQU 0ff0h    ; 1 = the video card V3 answered at reset (or at the last V P): IN PE = $6x
   77 0000:             VIDMIR:         EQU 0ff1h    ; nonzero = CHAROUT/UARTOUT also write to the screen (only while VIDPRES is 1)
   78 0000:             VIDCUR:         EQU 0ff2h    ; 1 = the chip has been started (V I)
   79 0000:             VROW:           EQU 0ff3h    ; text cursor row 0..VROWS-1
   80 0000:             VCOL:           EQU 0ff4h    ; text cursor column 0..VCOLS-1
   81 0000:             VCHAR:          EQU 0ff5h    ; the driver's scratch byte
   82 0000:             VYTOP:          EQU 0ff6h    ; word ($0FF6 high, $0FF7 low): the Y of the cursor row's top line, VYHOME - 16 x VROW
   83 0000:             VYTOPL:         EQU 0ff7h
   84 0000:             VCOLSV:         EQU 0ff8h    ; the screen's columns, 80 (V S and Y1/OS's video read it)
   85 0000:             
