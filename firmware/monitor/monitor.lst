   15 0000:             ; Hardware info
   16 0000:             ;
   17 0000:             UARTA0:       EQU 000h
   18 0000:             UARTA1:       EQU 008h
   19 0000:             UARTA2:       EQU 010h
   20 0000:             UARTA3:       EQU 018h
   21 0000:             UARTA4:       EQU 020h
   22 0000:             UARTA5:       EQU 028h
   23 0000:             UARTA6:       EQU 030h
   24 0000:             UARTA7:       EQU 038h
   25 0000:             
   26 0000:             SWITCHLED:    EQU 001H
   27 0000:             LCDENABLE:    EQU 002H
   28 0000:             LCDREGISTER:  EQU 004H
   29 0000:             UARTCS:       EQU 040H
   30 0000:             TIL311:       EQU 080H
   31 0000:             
   32 0000:             CNTL-PORT:    EQU "P0"
   33 0000:             DATAPORT:     EQU "P1"
   34 0000:             
   35 0000:             ;
   36 0000:             ; MONITOR MODES
   37 0000:             ;
   38 0000:             NOMODE:       EQU 0
   39 0000:             EXAMINEMODE:  EQU 1
   40 0000:             DUMPMODE:     EQU 2
   41 0000:             BLOCKMODE:    EQU 3
   42 0000:             FILLMODE:     EQU 4
   43 0000:             LOADMODE:     EQU 5         ; 2026-09-23: after a ':' load, CR/LF at the prompt do nothing
   44 0000:             
   45 0000:             ;
   46 0000:             ; Monitor variables 0x0f00 - 0x0fff
   47 0000:             ;
   48 0000:             monmode:        EQU 0f00h
   49 0000:             continue_addr:  EQU 0f02h
   50 0000:             lderr:          EQU 0f01h    ; 2026-09-23: nonzero when a record of the current ':' load failed
   51 0000:             interupt_cnt:   EQU 0f04h
   52 0000:             ;
   53 0000:             ; CompactFlash driver variables (YACC1-D 2026-09-22) and the OS/program argument buffer
   54 0000:             ;
   55 0000:             CFLBA0:         EQU 0f10h    ; sector number for CFREAD/CFWRITE, low byte
   56 0000:             CFLBA1:         EQU 0f11h
   57 0000:             CFLBA2:         EQU 0f12h    ; high byte (24-bit LBA)
   58 0000:             ARGBUF:         EQU 0f40h    ; 64 bytes: the OS leaves a program's command tail here (NUL-terminated)
   59 0000:             OSBASE:         EQU 1000h    ; where the boot command loads the OS image (LBA 1..OSCNT) and calls it
   60 0000:             line_buffer:    EQU 0f80h    ; 112 bytes long max ($0FF0-$0FFF are the video variables since 2026-09-25)
   61 0000:             ;
   62 0000:             ; Video card (YACC1-D 2026-09-25): MC6845 CRTC + IDT7134 dual-port RAM in the $D000 block (docs/cards/video.md).
   63 0000:             ; The driver is always in the ROM; VIDAUTO decides whether reset also starts it. Until the card is debugged it does
   64 0000:             ; not: reset only probes the card (VIDPRES, the banner says VIDEO CARD FOUND) and homes the cursor variables; V I
   65 0000:             ; initialises the CRTC and clears the screen, V M1 (or Y1/OS's `video on`) turns the mirroring on.
   66 0000:             ; 2026-11-10 (branch video-v2): the video card V2.0 (docs/cards/video-v2.md) in place of the V1 cards. The text RAM is
   67 0000:             ; at $D000 as before; every register is on an I/O port: PA the 6845's address register, PB its data register, PC the
   68 0000:             ; control register (OUT: 0-2 PLANE, 3 CPAGE, 4 DPAGE, 5 TEXT-OFF, 6 GFX-ON, 7 XOR; cleared at reset) and the status (IN:
   69 0000:             ; 0 DOTS, 1 VSYNC, 2 DE, 3 TEXT-ONLY, 7..4 = 0101, the card ID), PD/PE the PS/2 keyboard (IN PD: 0 FULL, 1 SRC, 2 BUSY;
   70 0000:             ; IN PE the byte, only after IN PD showed FULL). $D800-$DFFF is the graphics window (graphics RAM, never the 6845).
   71 0000:             ; The keyboard is a second console input beside the UART (kbst: uartin, uartinne, const).
   72 0000:             ;
   73 0000:             VIDAUTO:        EQU 0        ; 1 = reset also runs V I (CRTC table, clear, home) and sets VIDMIR when a card is found
   74 0000:             VIDRAM:         EQU 0d000h   ; display RAM, CPU side (A11 = 0); its first byte is the probe byte
   75 0000:             VIDSIZE:        EQU 2048     ; the RAM the CPU reaches (IC15 A11R grounded): VIDRAM..VIDRAM+2047
   76 0000:             VROWS:          EQU 24       ; screen geometry: VCOLSV x 24, one byte per character (2026-10-22: the columns are a
   77 0000:                                          ;   variable, 80 or 64, set from the card's latch by vmode; cols*(VROWS-1) must be a
   78 0000:                                          ;   multiple of 8 and at most 2,040: the scroll's loop - 80: 230 passes, 64: 184)
   79 0000:             VIDPRES:        EQU 0ff0h    ; 1 = the video card V2.0 answered at reset (or at the last V P): IN PC = $5x
   80 0000:             VIDMIR:         EQU 0ff1h    ; nonzero = CHAROUT/UARTOUT also write to the screen (only while VIDPRES is 1)
   81 0000:             VIDCUR:         EQU 0ff2h    ; nonzero = keep the CRTC's cursor (R14/R15) at the text cursor (set by V I)
   82 0000:             VROW:           EQU 0ff3h    ; text cursor row 0..VROWS-1
   83 0000:             VCOL:           EQU 0ff4h    ; text cursor column 0..VCOLSV-1
   84 0000:             VCHAR:          EQU 0ff5h    ; the driver's scratch byte
   85 0000:             VLINE:          EQU 0ff6h    ; word ($0FF6 high, $0FF7 low): the address of the cursor row's first byte
   86 0000:             VCOLSV:         EQU 0ff8h    ; (2026-10-22) the screen's columns: 80, or 64 with the card's DOTS jumper fitted
   87 0000:             VSCRLN:         EQU 0ff9h    ;   and the scroll's passes for it, VCOLSV*(VROWS-1)/8 (both set by vmode)
   88 0000:             
