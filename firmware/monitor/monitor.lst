  652 f33a: 91                  INP P1
  653 f33b: b3 01               ANDI 001H
  654 f33d: 05          constx: RET
  655 f33e:             ;
  656 f33e:             ; kbst (2026-11-10): ACC = 1 when the video card V2.0's PS/2 keyboard has a byte (IN PD bit 0, FULL), else 0; the
  657 f33e:             ; byte is then IN PE (the card's rule: read PE only after PD showed FULL). 0 with no card (VIDPRES = 0).
  658 f33e: e4 0f f0    kbst:   LDA VIDPRES
  659 f341: 0d 01               LDTI 1
  660 f343: aa f3 4a            BRNEQ kbst0
  661 f346: 9d                  INP PD
