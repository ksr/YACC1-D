  747 f3f0: a0 f0 6a            BR    cmdloop
  748 f3f3:             ;
  749 f3f3:             ; ldbyte: two hex digits (no echo) -> ACC, added into the checksum R3; a bad digit sets R6 = 1 and gives 0
  750 f3f3:             ;
