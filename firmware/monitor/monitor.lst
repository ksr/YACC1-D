  850 f50f:             ;
  851 f50f:             ; ---- Video card driver (YACC1-D 2026-09-25) --------------------------------------------------------------------
  852 f50f:             ; The screen is VCOLS x VROWS bytes from VIDRAM, row after row; a byte's bits 0-5 pick one of the 64 glyphs of the
  853 f50f:             ; character EPROM (the card latches VDATA0..5 only), bit 7 is inverse video, bit 6 is unused. The driver stores
  854 f50f:             ; ASCII with $60-$7F moved to $40-$5F (upper case), so a 2513-style set (code = ASCII bits 0-5) shows the text as sent. Cursor: VROW/VCOL, VLINE =
  855 f50f:             ; the address of the row. vputc handles CR (column 0), LF (column 0 of the next row: Y1/OS ends lines with LF
  856 f50f:             ; alone), BS (one left, no erase), TAB (spaces to the next multiple of 8), FF (clear + home); other control bytes and
  857 f50f:             ; DEL are ignored; a character in the last column wraps; LF on the last row scrolls (the whole screen moves up one
  858 f50f:             ; row, the last row is blanked). Only instructions of the 2021 set: no LDZ/STZ/ADDIW/SHL16/BRUR, no R2.
  859 f50f:             ;
  860 f50f:             ; vidreset: at reset. Mirroring and the CRTC cursor off, cursor home, probe; with VIDAUTO also V I + mirroring on.
  861 f50f:             vidreset:
  862 f50f: 0e 00               LDAI 0
  863 f511: e5 0f f1            STA VIDMIR
  864 f514: e5 0f f2            STA VIDCUR
  865 f517: 04 f5 81            JSR vhome
  866 f51a: 04 f5 31            JSR vprobe
  867 f51d: 0e 00               LDAI VIDAUTO
  868 f51f: a1 f5 30            BRZ vidrx
  869 f522: e4 0f f0            LDA VIDPRES
  870 f525: a1 f5 30            BRZ vidrx
  871 f528: 04 f5 61            JSR vinit
  872 f52b: 0e 01               LDAI 1
  873 f52d: e5 0f f1            STA VIDMIR
  874 f530: 05          vidrx:  RET
  875 f531:             ;
  876 f531:             ; vprobe: VIDPRES (and ACC) = 1 when the byte at VIDRAM keeps $55 and then $AA, else 0; the old byte is put back.
  877 f531:             ; An undecoded block reads what was last on the bus: between each STA and its LDA the LDA's own opcode and operand
  878 f531:             ; bytes ($E4 $D0 $00) cross the bus, so a floating bus reads $00, not the pattern.
  879 f531:             vprobe:
  880 f531: e4 d0 00            LDA VIDRAM
  881 f534: 09                  PUSH
  882 f535: 0e 55               LDAI 055h
  883 f537: e5 d0 00            STA VIDRAM
  884 f53a: e4 d0 00            LDA VIDRAM
  885 f53d: 0d 55               LDTI 055h
  886 f53f: aa f5 54            BRNEQ vprno
  887 f542: 0e aa               LDAI 0aah
