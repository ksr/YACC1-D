  855 f50f:             ;
  856 f50f:             ; ---- Video card driver (YACC1-D 2026-09-25) --------------------------------------------------------------------
  857 f50f:             ; The screen is VCOLSV x VROWS bytes from VIDRAM, row after row; a byte's bits 0-5 pick one of the 64 glyphs of the
  858 f50f:             ; character EPROM (the card latches VDATA0..5 only), bit 7 is inverse video, bit 6 is unused. The driver stores
  859 f50f:             ; ASCII with $60-$7F moved to $40-$5F (upper case), so a 2513-style set (code = ASCII bits 0-5) shows the text as sent. Cursor: VROW/VCOL, VLINE =
  860 f50f:             ; the address of the row. vputc handles CR (column 0), LF (column 0 of the next row: Y1/OS ends lines with LF
  861 f50f:             ; alone), BS (one left, no erase), TAB (spaces to the next multiple of 8), FF (clear + home); other control bytes and
  862 f50f:             ; DEL are ignored; a character in the last column wraps; LF on the last row scrolls (the whole screen moves up one
  863 f50f:             ; row, the last row is blanked). Only instructions of the 2021 set: no LDZ/STZ/ADDIW/SHL16/BRUR, no R2.
  864 f50f:             ;
  865 f50f:             ; vidreset: at reset. Mirroring and the CRTC cursor off, cursor home, probe; with VIDAUTO also V I + mirroring on.
  866 f50f:             vidreset:
  867 f50f: 0e 00               LDAI 0
  868 f511: e5 0f f1            STA VIDMIR
  869 f514: e5 0f f2            STA VIDCUR
  870 f517: 04 f5 c0            JSR vhome
  871 f51a: 04 f5 31            JSR vprobe
  872 f51d: 0e 00               LDAI VIDAUTO
  873 f51f: a1 f5 30            BRZ vidrx
  874 f522: e4 0f f0            LDA VIDPRES
  875 f525: a1 f5 30            BRZ vidrx
  876 f528: 04 f5 98            JSR vinit
  877 f52b: 0e 01               LDAI 1
  878 f52d: e5 0f f1            STA VIDMIR
  879 f530: 05          vidrx:  RET
  880 f531:             ;
  881 f531:             ; vprobe: VIDPRES (and ACC) = 1 when the byte at VIDRAM keeps $55 and then $AA, else 0; the old byte is put back.
  882 f531:             ; An undecoded block reads what was last on the bus: between each STA and its LDA the LDA's own opcode and operand
  883 f531:             ; bytes ($E4 $D0 $00) cross the bus, so a floating bus reads $00, not the pattern.
  884 f531:             vprobe:
  885 f531: e4 d0 00            LDA VIDRAM
  886 f534: 09                  PUSH
  887 f535: 0e 55               LDAI 055h
  888 f537: e5 d0 00            STA VIDRAM
  889 f53a: e4 d0 00            LDA VIDRAM
  890 f53d: 0d 55               LDTI 055h
  891 f53f: aa f5 54            BRNEQ vprno
  892 f542: 0e aa               LDAI 0aah
  893 f544: e5 d0 00            STA VIDRAM
  894 f547: e4 d0 00            LDA VIDRAM
  895 f54a: 0d aa               LDTI 0aah
  896 f54c: aa f5 54            BRNEQ vprno
  897 f54f: 0e 01               LDAI 1
  898 f551: a0 f5 56            BR vprset
  899 f554: 0e 00       vprno:  LDAI 0
  900 f556: e5 0f f0    vprset: STA VIDPRES
  901 f559: 0a                  POP
  902 f55a: e5 d0 00            STA VIDRAM
  903 f55d: 04 f5 64            JSR vmode
  904 f560: e4 0f f0            LDA VIDPRES
  905 f563: 05                  RET
  906 f564:             ;
  907 f564:             ; vmode (2026-10-22): the card's geometry from the JP1 latch at VLATCH ($D801, read only when the probe found a card).
  908 f564:             ; Bit 2 = 1: the V1.0-V1.2 card (11.0592 MHz, 6 dots, 80 x 24; on the card in the machine a jumper on JP1 3-4 holds
  909 f564:             ; the bit high). Bit 2 = 0: a V1.3 card at 12 MHz, its DOTS jumper on bit 0: 1 (open) = 6 dots, 80 x 24; 0 (fitted)
  910 f564:             ; = 8 dots, 64 x 24. Sets VCOLSV and VSCRLN; R6 = the CRTC's R0..R3 for vinit (the rest are common: vcrtab)
  911 f564: 1e f8 de    vmode:  MVIW R6,vcr10
  912 f567: 0e 50               LDAI 80
  913 f569: e5 0f f8            STA VCOLSV
  914 f56c: 0e e6               LDAI 230                ; 80*(VROWS-1)/8
  915 f56e: e5 0f f9            STA VSCRLN
  916 f571: e4 0f f0            LDA VIDPRES
  917 f574: a1 f5 97            BRZ vmodex
  918 f577: e4 d8 01            LDA VLATCH
  919 f57a: b3 04               ANDI 4
  920 f57c: a2 f5 97            BRNZ vmodex
  921 f57f: 1e f8 e2            MVIW R6,vcr13
  922 f582: e4 d8 01            LDA VLATCH
  923 f585: b3 01               ANDI 1
  924 f587: a2 f5 97            BRNZ vmodex
  925 f58a: 1e f8 e6            MVIW R6,vcr64
  926 f58d: 0e 40               LDAI 64
  927 f58f: e5 0f f8            STA VCOLSV
  928 f592: 0e b8               LDAI 184                ; 64*(VROWS-1)/8
  929 f594: e5 0f f9            STA VSCRLN
  930 f597: 05          vmodex: RET
  931 f598:             ;
  932 f598:             ; vinit: the CRTC's 16 registers - R0..R3 for the card vmode found, R4..R15 from vcrtab - the CRTC cursor on, then
  933 f598:             ; vcls (R6, R7 clobbered)
  934 f598: 04 f5 64    vinit:  JSR vmode
  935 f59b: 0e 00               LDAI 0
  936 f59d: e5 d8 00    vinitl: STA VCRTCA
  937 f5a0: 09                  PUSH
  938 f5a1: 0d 04               LDTI 4
  939 f5a3: aa f5 a9            BRNEQ vinitn
  940 f5a6: 1e f8 ea            MVIW R6,vcrtab
  941 f5a9: 46          vinitn: LDAVR R6
  942 f5aa: e5 d8 02            STA VCRTCD
  943 f5ad: 56                  INCR R6
  944 f5ae: 0a                  POP
  945 f5af: b0 01               ADDI 1
  946 f5b1: 0d 10               LDTI 16
  947 f5b3: aa f5 9d            BRNEQ vinitl
  948 f5b6: 0e 01               LDAI 1
  949 f5b8: e5 0f f2            STA VIDCUR
  950 f5bb:             ; vcls: every byte of the display RAM a space, cursor home
  951 f5bb: 0e 20       vcls:   LDAI ' '
  952 f5bd: 04 f5 cf            JSR vfill
  953 f5c0:             ; vhome: cursor to row 0, column 0 (R7 clobbered)
  954 f5c0: 0e 00       vhome:  LDAI 0
  955 f5c2: e5 0f f3            STA VROW
  956 f5c5: e5 0f f4            STA VCOL
  957 f5c8: 1f d0 00            MVIW R7,VIDRAM
  958 f5cb: ef 0f f6            STR R7,VLINE
  959 f5ce: 05                  RET
  960 f5cf:             ;
  961 f5cf:             ; vfill: ACC to all VIDSIZE bytes of the display RAM, 8 per pass (R7, TMP clobbered, R5 kept)
  962 f5cf: 07 05       vfill:  PUSHR R5
  963 f5d1: 0b                  MVAT
  964 f5d2: 1f d0 00            MVIW R7,VIDRAM
  965 f5d5: 15 00               MVIB R5,(VIDSIZE/8).0
  966 f5d7: 0c          vfilll: MVTA
  967 f5d8: 4f                  STAVR R7
  968 f5d9: 57                  INCR R7
  969 f5da: 4f                  STAVR R7
  970 f5db: 57                  INCR R7
  971 f5dc: 4f                  STAVR R7
  972 f5dd: 57                  INCR R7
  973 f5de: 4f                  STAVR R7
  974 f5df: 57                  INCR R7
  975 f5e0: 4f                  STAVR R7
  976 f5e1: 57                  INCR R7
  977 f5e2: 4f                  STAVR R7
  978 f5e3: 57                  INCR R7
  979 f5e4: 4f                  STAVR R7
  980 f5e5: 57                  INCR R7
  981 f5e6: 4f                  STAVR R7
  982 f5e7: 57                  INCR R7
  983 f5e8: 5d                  DECR R5
  984 f5e9: 25                  MVRLA R5
  985 f5ea: a2 f5 d7            BRNZ vfilll
  986 f5ed: 08 50               POPR R5
  987 f5ef: 05                  RET
  988 f5f0:             ;
  989 f5f0:             ; vputc: ACC to the screen at the cursor (see above). Keeps R3-R7 and TMP; ACC is not kept (charout has its copy).
  990 f5f0: e5 0f f5    vputc:  STA VCHAR
  991 f5f3: 0c                  MVTA
  992 f5f4: 09                  PUSH
  993 f5f5: 07 07               PUSHR R7
  994 f5f7: e4 0f f5            LDA VCHAR
  995 f5fa: b3 7f               ANDI 07fh
  996 f5fc: 0d 20               LDTI 020h
  997 f5fe: a7 f6 14            BRLT vpctl
  998 f601: 0d 7f               LDTI 07fh
  999 f603: a8 f6 0c            BREQ vpdone
 1000 f606: 04 f6 e4            JSR vupper
 1001 f609: 04 f6 5f            JSR vpchar
 1002 f60c: 04 f6 fa    vpdone: JSR vcursor
 1003 f60f: 08 70               POPR R7
 1004 f611: 0a                  POP
 1005 f612: 0b                  MVAT
 1006 f613: 05                  RET
 1007 f614: 0d 0d       vpctl:  LDTI 0dh
 1008 f616: a8 f6 3d            BREQ vpcr
 1009 f619: 0d 0a               LDTI 0ah
 1010 f61b: a8 f6 45            BREQ vplf
 1011 f61e: 0d 08               LDTI 08h
 1012 f620: a8 f6 4b            BREQ vpbs
 1013 f623: 0d 0c               LDTI 0ch
 1014 f625: a8 f6 59            BREQ vpff
 1015 f628: 0d 09               LDTI 09h
 1016 f62a: aa f6 0c            BRNEQ vpdone
 1017 f62d: 0e 20       vptab:  LDAI ' '
 1018 f62f: 04 f6 5f            JSR vpchar
 1019 f632: e4 0f f4            LDA VCOL
 1020 f635: b3 07               ANDI 7
 1021 f637: a2 f6 2d            BRNZ vptab
 1022 f63a: a0 f6 0c            BR vpdone
 1023 f63d: 0e 00       vpcr:   LDAI 0
 1024 f63f: e5 0f f4            STA VCOL
 1025 f642: a0 f6 0c            BR vpdone
 1026 f645: 04 f6 77    vplf:   JSR vlf
 1027 f648: a0 f6 0c            BR vpdone
 1028 f64b: e4 0f f4    vpbs:   LDA VCOL
 1029 f64e: a1 f6 0c            BRZ vpdone
 1030 f651: b1 01               SUBI 1
 1031 f653: e5 0f f4            STA VCOL
 1032 f656: a0 f6 0c            BR vpdone
 1033 f659: 04 f5 bb    vpff:   JSR vcls
 1034 f65c: a0 f6 0c            BR vpdone
 1035 f65f:             ;
 1036 f65f:             ; vpchar: ACC stored at the cursor, the cursor one right; past the last column to the next row (R7, TMP clobbered)
 1037 f65f: 09          vpchar: PUSH
 1038 f660: 04 f6 ec            JSR vcaddr
 1039 f663: 0a                  POP
 1040 f664: 4f                  STAVR R7
 1041 f665: e4 0f f4            LDA VCOL
 1042 f668: b0 01               ADDI 1
 1043 f66a: e5 0f f4            STA VCOL
 1044 f66d: e6 0f f8            LDT VCOLSV
 1045 f670: aa f6 76            BRNEQ vpchx
 1046 f673: 04 f6 77            JSR vlf
 1047 f676: 05          vpchx:  RET
 1048 f677:             ;
 1049 f677:             ; vlf: column 0 of the next row; on the last row the screen scrolls instead (R7, TMP clobbered)
 1050 f677: 0e 00       vlf:    LDAI 0
 1051 f679: e5 0f f4            STA VCOL
 1052 f67c: e4 0f f3            LDA VROW
 1053 f67f: b0 01               ADDI 1
 1054 f681: 0d 18               LDTI VROWS
 1055 f683: a8 f6 96            BREQ vscroll
 1056 f686: e5 0f f3            STA VROW
