 1140 f6e5: 05                  RET
 1141 f6e6:             ;
 1142 f6e6:             ; vcursor: with VIDCUR set, the CRTC's cursor registers R14/R15 <- the cursor's offset from VIDRAM (R7 clobbered)
 1143 f6e6:             vcursor:
 1144 f6e6: e4 0f f2            LDA VIDCUR
 1145 f6e9: a1 f6 fb            BRZ vcurx
