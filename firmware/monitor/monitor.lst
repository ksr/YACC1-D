  970 f5c1: 04 f5 73    vmove:  JSR vwfe
  971 f5c4: 7b 80               OUTI PB,080h
  972 f5c6: 7b 00               OUTI PB,0
  973 f5c8: e4 0f f4            LDA VCOL
  974 f5cb: b7                  SHR
