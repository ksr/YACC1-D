 1110 f6ac:             ;
 1111 f6ac:             ; vupper: $60-$7F down to $40-$5F (lower case to upper; the monitor's toupper also moves [ \ ] ^ _, which the
 1112 f6ac:             ; 64-glyph set has)
 1113 f6ac:             ;
 1114 f6ac:             ; vcaddr: R7 = VLINE + VCOL, the cursor's address (TMP clobbered)
 1115 f6ac: e6 0f f4    vcaddr: LDT VCOL
 1116 f6af: f7 0f f6            LDR R7,VLINE
 1117 f6b2:             ; vaddt: R7 += TMP (8 bits). The ADDIC follows the ADDI with only register moves between: the carry is the add's
 1118 f6b2:             ; on the machine and on both emulators (docs/programming/ISA-REFERENCE.md section 6)
 1119 f6b2: 27          vaddt:  MVRLA R7
 1120 f6b3: b8                  ADDT
 1121 f6b4: 37                  MVARL R7
 1122 f6b5: 2f                  MVRHA R7
