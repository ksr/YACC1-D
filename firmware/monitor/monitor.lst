  874 f524:             ;
  875 f524:             ; ---- Video card driver (YACC1-D 2026-09-25) --------------------------------------------------------------------
  876 f524:             ; The screen is VCOLSV x VROWS bytes from VIDRAM, row after row; a byte's bits 0-5 pick one of the 64 glyphs of the
  877 f524:             ; character EPROM (the card latches VDATA0..5 only), bit 7 is inverse video, bit 6 is unused. The driver stores
  878 f524:             ; ASCII with $60-$7F moved to $40-$5F (upper case), so a 2513-style set (code = ASCII bits 0-5) shows the text as sent. Cursor: VROW/VCOL, VLINE =
  879 f524:             ; the address of the row. vputc handles CR (column 0), LF (column 0 of the next row: Y1/OS ends lines with LF
  880 f524:             ; alone), BS (one left, no erase), TAB (spaces to the next multiple of 8), FF (clear + home); other control bytes and
  881 f524:             ; DEL are ignored; a character in the last column wraps; LF on the last row scrolls (the whole screen moves up one
  882 f524:             ; row, the last row is blanked). Only instructions of the 2021 set: no LDZ/STZ/ADDIW/SHL16/BRUR, no R2.
  883 f524:             ;
  884 f524:             ; vidreset: at reset. Mirroring and the CRTC cursor off, cursor home, probe; with VIDAUTO also V I + mirroring on.
  885 f524:             vidreset:
  886 f524: 0e 00               LDAI 0
  887 f526: e5 0f f1            STA VIDMIR
  888 f529: e5 0f f2            STA VIDCUR
  889 f52c: 04 f5 8c            JSR vhome
  890 f52f: 04 f5 46            JSR vprobe
  891 f532: 0e 00               LDAI VIDAUTO
  892 f534: a1 f5 45            BRZ vidrx
  893 f537: e4 0f f0            LDA VIDPRES
  894 f53a: a1 f5 45            BRZ vidrx
  895 f53d: 04 f5 65            JSR vinit
  896 f540: 0e 01               LDAI 1
  897 f542: e5 0f f1            STA VIDMIR
  898 f545: 05          vidrx:  RET
  899 f546:             ;
  900 f546:             ; vprobe: VIDPRES (and ACC) = 1 when IN PC (the V4 card's status) reads $7x, the card ID in bits 7..4, else 0
  901 f546:             ; (2026-11-10; the V1 cards' probe wrote $55/$AA at VIDRAM). With no card the port is not decoded and reads the
  902 f546:             ; floating bus: $FF on the pull-ups, or the INP's own opcode $9C - neither is $7x.
  903 f546: 9c          vprobe: INP PC
  904 f547: b3 f0               ANDI 0f0h
  905 f549: 0d 70               LDTI 070h
  906 f54b: aa f5 53            BRNEQ vprno
  907 f54e: 0e 01               LDAI 1
  908 f550: a0 f5 55            BR vprset
  909 f553: 0e 00       vprno:  LDAI 0
  910 f555: e5 0f f0    vprset: STA VIDPRES
  911 f558: 04 f5 5f            JSR vmode
  912 f55b: e4 0f f0            LDA VIDPRES
  913 f55e: 05                  RET
  914 f55f:             ;
  915 f55f:             ; vmode (2026-10-22): the screen's geometry; on the V4 always 80 columns (VCOLSV)
  916 f55f: 0e 50       vmode:  LDAI 80                 ; V4: 80 columns, always
  917 f561: e5 0f f8            STA VCOLSV
  918 f564: 05                  RET
  919 f565:             ;
  920 f565:             ; vinit: the control register 0 (text on, graphics off: direct mode, plane and pages 0), the CRTC's 16 registers -
  921 f565:             ; R0..R3 for the mode vmode found, R4..R15 from vcrtab - through OUT PA / OUT PB, the CRTC cursor on, then vcls
  922 f565:             ; (R6, R7 clobbered)
  923 f565: 04 f5 5f    vinit:  JSR vmode
  924 f568: 7c 00               OUTI PC,0
  925 f56a: 0e 00               LDAI 0                  ; V4: control 2 and its copy 0 - text on, the cursor's left half, both syncs
  926 f56c: e5 0f f9            STA VIDC2               ;   negative, the three guns on (white)
  927 f56f: 6f                  OUTA PF
  928 f570: 1e f8 a9            MVIW R6,vcrtab
  929 f573: 0e 00               LDAI 0
  930 f575: 6a          vinitl: OUTA PA
  931 f576: 09                  PUSH
  932 f577: 46          vinitn: LDAVR R6
  933 f578: 6b                  OUTA PB
  934 f579: 56                  INCR R6
  935 f57a: 0a                  POP
  936 f57b: b0 01               ADDI 1
  937 f57d: 0d 10               LDTI 16
  938 f57f: aa f5 75            BRNEQ vinitl
  939 f582: 0e 01               LDAI 1
  940 f584: e5 0f f2            STA VIDCUR
  941 f587:             ; vcls: every byte of the display RAM a space, cursor home
  942 f587: 0e 20       vcls:   LDAI ' '
  943 f589: 04 f5 9b            JSR vfill
  944 f58c:             ; vhome: cursor to row 0, column 0 (R7 clobbered)
  945 f58c: 0e 00       vhome:  LDAI 0
  946 f58e: e5 0f f3            STA VROW
  947 f591: e5 0f f4            STA VCOL
  948 f594: 1f d0 00            MVIW R7,VIDRAM
  949 f597: ef 0f f6            STR R7,VLINE
  950 f59a: 05                  RET
  951 f59b:             ;
  952 f59b:             ; vfill: ACC to all VIDSIZE bytes of the display RAM, 8 per pass (R7, TMP clobbered, R5 kept)
  953 f59b: 07 05       vfill:  PUSHR R5
  954 f59d: 0b                  MVAT
  955 f59e: 1f d0 00            MVIW R7,VIDRAM
  956 f5a1: 15 00               MVIB R5,(VIDSIZE/8).0
  957 f5a3: 0c          vfilll: MVTA
  958 f5a4: 4f                  STAVR R7
  959 f5a5: 57                  INCR R7
  960 f5a6: 4f                  STAVR R7
  961 f5a7: 57                  INCR R7
  962 f5a8: 4f                  STAVR R7
  963 f5a9: 57                  INCR R7
  964 f5aa: 4f                  STAVR R7
  965 f5ab: 57                  INCR R7
  966 f5ac: 4f                  STAVR R7
  967 f5ad: 57                  INCR R7
  968 f5ae: 4f                  STAVR R7
  969 f5af: 57                  INCR R7
  970 f5b0: 4f                  STAVR R7
  971 f5b1: 57                  INCR R7
  972 f5b2: 4f                  STAVR R7
  973 f5b3: 57                  INCR R7
  974 f5b4: 5d                  DECR R5
  975 f5b5: 25                  MVRLA R5
  976 f5b6: a2 f5 a3            BRNZ vfilll
  977 f5b9: 08 50               POPR R5
  978 f5bb: 05                  RET
  979 f5bc:             ;
  980 f5bc:             ; vputc: ACC to the screen at the cursor (see above). Keeps R3-R7 and TMP; ACC is not kept (charout has its copy).
  981 f5bc: e5 0f f5    vputc:  STA VCHAR
  982 f5bf: 0c                  MVTA
  983 f5c0: 09                  PUSH
  984 f5c1: 07 07               PUSHR R7
