  456 f262: 04 f3 cf          jsr getaddress
  457 f265:             ;
  458 f265:             ; YACC1-D 2026-09-22: was BRVR R7, which is an INDIRECT jump (PC <- the word AT the address, see the
  459 f265:             ; microcode: branch() fetches the target through R7 like BR fetches its operand through the PC), so G jumped
  460 f265:             ; through whatever was stored at AAAA. JSRUR R7 jumps TO AAAA and pushes a return address: the program ends
  461 f265:             ; with RET and lands back in the command loop.
  462 f265:             ;
  463 f265: 06 07             JSRUR R7
  464 f267: a0 f0 5b          BR cmdloop
