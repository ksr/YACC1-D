  794 f438: 19 0e ff            MVIW  R1,STACK          ; stack is empty, so resetting it drops the return addresses and pushed bytes
  795 f43b: a0 f3 ea            BR    ldabort
  796 f43e: 0a 0d 4c 4f 
            41 44 45 44 
            0a 0d 00    MSGLOADED: DB 0ah,0dh,"LOADED",0ah,0dh,0
