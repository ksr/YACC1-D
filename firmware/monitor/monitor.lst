 1156 f6e3: b3 fd               ANDI 0fdh
 1157 f6e5: ba                  ORT
 1158 f6e6: e5 0f f9            STA VIDC2
 1159 f6e9: 6f                  OUTA PF
 1160 f6ea: 05          vcurx:  RET
 1161 f6eb:             ;
 1162 f6eb:             ; vidctl: the video entry at $FFBC (JSR vidctl / RET, below the full vector table), for Y1/OS and programs.
 1163 f6eb:             ; ACC = 0 probe (ACC = VIDPRES), 1 init (V I), 2 clear + home (V C); anything else: ACC = VIDPRES.
 1164 f6eb:             ; A caller checks that $FFBC holds $04 (JSR) first: an older ROM has $FF there. Clobbers R5-R7, TMP.
 1165 f6eb: 0d 01       vidctl: LDTI 1
 1166 f6ed: a8 f6 fe            BREQ vctli
 1167 f6f0: 0d 02               LDTI 2
 1168 f6f2: a8 f7 04            BREQ vctlc
