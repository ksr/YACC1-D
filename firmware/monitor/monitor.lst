 1061 f67e: ef 0f f6            STR R7,VLINE
 1062 f681: 05                  RET
 1063 f682:             ;
 1064 f682:             ; vscroll: rows 1..VROWS-1 up one row (8 bytes per pass), the last row blanked; R5/R6 kept, R7 clobbered
 1065 f682:             vscroll:
 1066 f682: 07 06               PUSHR R6
 1067 f684: 07 05               PUSHR R5
 1068 f686: 1f d0 00            MVIW R7,VIDRAM
 1069 f689: e6 0f f8            LDT VCOLSV
 1070 f68c: 04 f6 de            JSR vaddt
 1071 f68f: 07 07               PUSHR R7
