  588 f2e4: 04 f2 92            JSR cfdrq
  589 f2e7: b3 08               ANDI 008H
  590 f2e9: a1 f3 00            BRZ cferr
  591 f2ec: 78 00               OUTI P8,CFSEL_DATA
  592 f2ee: 1e 02 00            MVIW R6,512
  593 f2f1:             cfrdl:
  594 f2f1: 99                  INP P9
  595 f2f2: 4f                  STAVR R7
