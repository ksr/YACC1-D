  501 f27a:             ;
  502 f27a:             ; ---- CompactFlash driver (YACC1-D 2026-09-22) -----------------------------------------------------------
  503 f27a:             ; The card sits on two ports: P8 = register-select latch (ATA task-file register 0-7), P9 = data.
  504 f27a:             ; 8-bit True IDE mode. Registers: 0 data, 1 error/feature, 2 sector count, 3-5 LBA0-2, 6 drive/head, 7 status/cmd.
  505 f27a:             ; Entry points (also BIOS vectors at 0FFECh..): cfinit  ACC = 0 ok / 1 error (absent card times out);
  506 f27a:             ;   cfread   sector CFLBA0..2 -> (R7), R7 += 512, ACC = 0 ok / 1 error;   cfwrite  (R7) -> sector, R7 += 512, same;
  507 f27a:             ;   R6 and TMP are clobbered. const  ACC = 1 when a console byte waits (0 otherwise).
  508 f27a:             ;
  509 f27a:             CFSEL_DATA:  EQU 0
  510 f27a:             CFSEL_FEAT:  EQU 1
  511 f27a:             CFSEL_SCNT:  EQU 2
  512 f27a:             CFSEL_LBA0:  EQU 3
  513 f27a:             CFSEL_LBA1:  EQU 4
  514 f27a:             CFSEL_LBA2:  EQU 5
  515 f27a:             CFSEL_HEAD:  EQU 6
  516 f27a:             CFSEL_CMD:   EQU 7
  517 f27a:             ;
  518 f27a:             ; wait while BSY (bit 7), bounded to 65536 polls; returns the status in ACC
  519 f27a:             cfwait:
  520 f27a: 1e 00 00            MVIW R6,0
  521 f27d:             cfwaitl:
  522 f27d: 78 07               OUTI P8,CFSEL_CMD
  523 f27f: 99                  INP P9
  524 f280: b3 80               ANDI 080H
  525 f282: a1 f2 8e            BRZ cfwaitd
  526 f285: 5e                  DECR R6
  527 f286: 26                  MVRLA R6
  528 f287: a2 f2 7d            BRNZ cfwaitl
  529 f28a: 2e                  MVRHA R6
  530 f28b: a2 f2 7d            BRNZ cfwaitl
  531 f28e:             cfwaitd:
  532 f28e: 78 07               OUTI P8,CFSEL_CMD
  533 f290: 99                  INP P9
  534 f291: 05                  RET
  535 f292:             ;
  536 f292:             ; wait until DRQ (bit 3), bounded; returns the status in ACC
  537 f292:             cfdrq:
  538 f292: 1e 00 00            MVIW R6,0
  539 f295:             cfdrql:
  540 f295: 78 07               OUTI P8,CFSEL_CMD
  541 f297: 99                  INP P9
