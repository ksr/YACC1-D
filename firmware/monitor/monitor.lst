  870 f524:             ;
  871 f524:             ; ---- Video card driver (YACC1-D 2026-09-25) --------------------------------------------------------------------
  872 f524:             ; The screen is VCOLSV x VROWS bytes from VIDRAM, row after row; a byte's bits 0-5 pick one of the 64 glyphs of the
  873 f524:             ; character EPROM (the card latches VDATA0..5 only), bit 7 is inverse video, bit 6 is unused. The driver stores
  874 f524:             ; ASCII with $60-$7F moved to $40-$5F (upper case), so a 2513-style set (code = ASCII bits 0-5) shows the text as sent. Cursor: VROW/VCOL, VLINE =
  875 f524:             ; the address of the row. vputc handles CR (column 0), LF (column 0 of the next row: Y1/OS ends lines with LF
  876 f524:             ; alone), BS (one left, no erase), TAB (spaces to the next multiple of 8), FF (clear + home); other control bytes and
  877 f524:             ; DEL are ignored; a character in the last column wraps; LF on the last row scrolls (the whole screen moves up one
  878 f524:             ; row, the last row is blanked). Only instructions of the 2021 set: no LDZ/STZ/ADDIW/SHL16/BRUR, no R2.
  879 f524:             ;
  880 f524:             ; vidreset: at reset. Mirroring and the CRTC cursor off, cursor home, probe; with VIDAUTO also V I + mirroring on.
  881 f524:             vidreset:
  882 f524: 0e 00               LDAI 0
  883 f526: e5 0f f1            STA VIDMIR
  884 f529: e5 0f f2            STA VIDCUR
  885 f52c: 04 f5 ac            JSR vhome
  886 f52f: 04 f5 46            JSR vprobe
  887 f532: 0e 00               LDAI VIDAUTO
  888 f534: a1 f5 45            BRZ vidrx
  889 f537: e4 0f f0            LDA VIDPRES
  890 f53a: a1 f5 45            BRZ vidrx
  891 f53d: 04 f5 86            JSR vinit
  892 f540: 0e 01               LDAI 1
  893 f542: e5 0f f1            STA VIDMIR
  894 f545: 05          vidrx:  RET
  895 f546:             ;
  896 f546:             ; vprobe: VIDPRES (and ACC) = 1 when IN PC (the V2.0 card's status) reads $5x, the card ID in bits 7..4, else 0
  897 f546:             ; (2026-11-10; the V1 cards' probe wrote $55/$AA at VIDRAM). With no card the port is not decoded and reads the
  898 f546:             ; floating bus: $FF on the pull-ups, or the INP's own opcode $9C - neither is $5x.
  899 f546: 9c          vprobe: INP PC
  900 f547: b3 f0               ANDI 0f0h
  901 f549: 0d 50               LDTI 050h
  902 f54b: aa f5 53            BRNEQ vprno
  903 f54e: 0e 01               LDAI 1
  904 f550: a0 f5 55            BR vprset
  905 f553: 0e 00       vprno:  LDAI 0
  906 f555: e5 0f f0    vprset: STA VIDPRES
  907 f558: 04 f5 5f            JSR vmode
  908 f55b: e4 0f f0            LDA VIDPRES
  909 f55e: 05                  RET
  910 f55f:             ;
  911 f55f:             ; vmode (2026-10-22; 2026-11-10 the V2.0 card): the geometry from the DOTS jumper, IN PC bit 0 (read only when the
  912 f55f:             ; probe found the card): 1 (open) = 6 dots, 80 x 24; 0 (fitted) = 8 dots, 64 x 24, the mode the graphics layer needs;
  913 f55f:             ; both from the 12 MHz crystal. Sets VCOLSV and VSCRLN; R6 = the CRTC's R0..R3 for vinit (the rest are common: vcrtab)
  914 f55f: 1e f8 bc    vmode:  MVIW R6,vcr80
  915 f562: 0e 50               LDAI 80
  916 f564: e5 0f f8            STA VCOLSV
  917 f567: 0e e6               LDAI 230                ; 80*(VROWS-1)/8
  918 f569: e5 0f f9            STA VSCRLN
  919 f56c: e4 0f f0            LDA VIDPRES
  920 f56f: a1 f5 85            BRZ vmodex
  921 f572: 9c                  INP PC
  922 f573: b3 01               ANDI 1
  923 f575: a2 f5 85            BRNZ vmodex
  924 f578: 1e f8 c0            MVIW R6,vcr64
  925 f57b: 0e 40               LDAI 64
  926 f57d: e5 0f f8            STA VCOLSV
  927 f580: 0e b8               LDAI 184                ; 64*(VROWS-1)/8
  928 f582: e5 0f f9            STA VSCRLN
  929 f585: 05          vmodex: RET
  930 f586:             ;
  931 f586:             ; vinit: the control register 0 (text on, graphics off: direct mode, plane and pages 0), the CRTC's 16 registers -
  932 f586:             ; R0..R3 for the mode vmode found, R4..R15 from vcrtab - through OUT PA / OUT PB, the CRTC cursor on, then vcls
  933 f586:             ; (R6, R7 clobbered)
  934 f586: 04 f5 5f    vinit:  JSR vmode
  935 f589: 7c 00               OUTI PC,0
  936 f58b: 0e 00               LDAI 0
  937 f58d: 6a          vinitl: OUTA PA
  938 f58e: 09                  PUSH
  939 f58f: 0d 04               LDTI 4
  940 f591: aa f5 97            BRNEQ vinitn
  941 f594: 1e f8 c4            MVIW R6,vcrtab
  942 f597: 46          vinitn: LDAVR R6
  943 f598: 6b                  OUTA PB
  944 f599: 56                  INCR R6
  945 f59a: 0a                  POP
  946 f59b: b0 01               ADDI 1
  947 f59d: 0d 10               LDTI 16
  948 f59f: aa f5 8d            BRNEQ vinitl
  949 f5a2: 0e 01               LDAI 1
  950 f5a4: e5 0f f2            STA VIDCUR
  951 f5a7:             ; vcls: every byte of the display RAM a space, cursor home
  952 f5a7: 0e 20       vcls:   LDAI ' '
  953 f5a9: 04 f5 bb            JSR vfill
  954 f5ac:             ; vhome: cursor to row 0, column 0 (R7 clobbered)
  955 f5ac: 0e 00       vhome:  LDAI 0
  956 f5ae: e5 0f f3            STA VROW
  957 f5b1: e5 0f f4            STA VCOL
  958 f5b4: 1f d0 00            MVIW R7,VIDRAM
  959 f5b7: ef 0f f6            STR R7,VLINE
  960 f5ba: 05                  RET
  961 f5bb:             ;
  962 f5bb:             ; vfill: ACC to all VIDSIZE bytes of the display RAM, 8 per pass (R7, TMP clobbered, R5 kept)
  963 f5bb: 07 05       vfill:  PUSHR R5
  964 f5bd: 0b                  MVAT
  965 f5be: 1f d0 00            MVIW R7,VIDRAM
  966 f5c1: 15 00               MVIB R5,(VIDSIZE/8).0
  967 f5c3: 0c          vfilll: MVTA
  968 f5c4: 4f                  STAVR R7
  969 f5c5: 57                  INCR R7
  970 f5c6: 4f                  STAVR R7
  971 f5c7: 57                  INCR R7
  972 f5c8: 4f                  STAVR R7
  973 f5c9: 57                  INCR R7
  974 f5ca: 4f                  STAVR R7
  975 f5cb: 57                  INCR R7
  976 f5cc: 4f                  STAVR R7
  977 f5cd: 57                  INCR R7
  978 f5ce: 4f                  STAVR R7
  979 f5cf: 57                  INCR R7
  980 f5d0: 4f                  STAVR R7
  981 f5d1: 57                  INCR R7
  982 f5d2: 4f                  STAVR R7
  983 f5d3: 57                  INCR R7
  984 f5d4: 5d                  DECR R5
  985 f5d5: 25                  MVRLA R5
  986 f5d6: a2 f5 c3            BRNZ vfilll
  987 f5d9: 08 50               POPR R5
  988 f5db: 05                  RET
  989 f5dc:             ;
  990 f5dc:             ; vputc: ACC to the screen at the cursor (see above). Keeps R3-R7 and TMP; ACC is not kept (charout has its copy).
  991 f5dc: e5 0f f5    vputc:  STA VCHAR
  992 f5df: 0c                  MVTA
  993 f5e0: 09                  PUSH
  994 f5e1: 07 07               PUSHR R7
  995 f5e3: e4 0f f5            LDA VCHAR
  996 f5e6: b3 7f               ANDI 07fh
  997 f5e8: 0d 20               LDTI 020h
  998 f5ea: a7 f6 00            BRLT vpctl
  999 f5ed: 0d 7f               LDTI 07fh
