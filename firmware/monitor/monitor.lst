 1174 f704: 04 f5 87    vctlc:  JSR vcls
 1175 f707: e4 0f f0    vctlx:  LDA VIDPRES
 1176 f70a: 05                  RET
 1177 f70b:             ;
 1178 f70b:             ; ---- V: the video unit (monitor command) ---------------------------------------------------------------------
 1179 f70b:             ; V then a letter (blanks skipped); numbers are hex, blanks between them optional. V? (or any other letter) lists:
 1180 f70b:             ;   VS  status          VP  probe again      VI  init (CRTC, clear, home)     VC  clear, home
 1181 f70b:             ;   VM1 / VM0  mirror on / off               VW rr cc text  text at row rr, column cc (not the cursor)
 1182 f70b:             ;   VB aaaa bb bb ..  bytes from aaaa ($Dxxx only)   VF bb  fill the 2K     VD  the screen as text (not mirrored)
 1183 f70b:             ;   VR rr [vv]  write CRTC register rr, or read it
 1184 f70b:             ;
 1185 f70b:             cmd_video:
 1186 f70b: 0d 00               LDTI NOMODE
 1187 f70d: e7 0f 00            STT monmode
 1188 f710: 04 f8 9a            JSR vskip
