  709 f398: a8 f3 a5            BREQ  ldnext
  710 f39b: 1e 00 02            MVIW  R6,2
  711 f39e: a0 f3 a5            BR    ldnext
  712 f3a1:             ldref:
  713 f3a1: 1e 00 02            MVIW  R6,2
  714 f3a4:             ldskip:
  715 f3a4: 0a                  POP
  716 f3a5:             ldnext:
  717 f3a5: 57                  INCR  R7
  718 f3a6: 5c                  DECR  R4
  719 f3a7: a0 f3 7a            BR    ldloop
  720 f3aa:             ldsum:
  721 f3aa: 04 f4 12            JSR   ldbyte            ; the checksum: the record's bytes now sum to zero
  722 f3ad: 26                  MVRLA R6
  723 f3ae: 0d 01               LDTI  1
  724 f3b0: a8 f3 c9            BREQ  ldbadrec
  725 f3b3: 23                  MVRLA R3
  726 f3b4: a2 f3 c9            BRNZ  ldbadrec
