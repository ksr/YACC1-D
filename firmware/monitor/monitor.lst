 1014 f60f: 0d 0c               LDTI 0ch
 1015 f611: a8 f6 45            BREQ vpff
 1016 f614: 0d 09               LDTI 09h
 1017 f616: aa f5 f8            BRNEQ vpdone
 1018 f619: 0e 20       vptab:  LDAI ' '
 1019 f61b: 04 f6 4b            JSR vpchar
 1020 f61e: e4 0f f4            LDA VCOL
 1021 f621: b3 07               ANDI 7
 1022 f623: a2 f6 19            BRNZ vptab
 1023 f626: a0 f5 f8            BR vpdone
 1024 f629: 0e 00       vpcr:   LDAI 0
 1025 f62b: e5 0f f4            STA VCOL
 1026 f62e: a0 f5 f8            BR vpdone
 1027 f631: 04 f6 63    vplf:   JSR vlf
 1028 f634: a0 f5 f8            BR vpdone
 1029 f637: e4 0f f4    vpbs:   LDA VCOL
 1030 f63a: a1 f5 f8            BRZ vpdone
 1031 f63d: b1 01               SUBI 1
 1032 f63f: e5 0f f4            STA VCOL
 1033 f642: a0 f5 f8            BR vpdone
 1034 f645: 04 f5 a7    vpff:   JSR vcls
 1035 f648: a0 f5 f8            BR vpdone
 1036 f64b:             ;
 1037 f64b:             ; vpchar: ACC stored at the cursor, the cursor one right; past the last column to the next row (R7, TMP clobbered)
 1038 f64b: 09          vpchar: PUSH
 1039 f64c: 04 f6 d8            JSR vcaddr
 1040 f64f: 0a                  POP
 1041 f650: 4f                  STAVR R7
 1042 f651: e4 0f f4            LDA VCOL
 1043 f654: b0 01               ADDI 1
 1044 f656: e5 0f f4            STA VCOL
 1045 f659: e6 0f f8            LDT VCOLSV
 1046 f65c: aa f6 62            BRNEQ vpchx
 1047 f65f: 04 f6 63            JSR vlf
 1048 f662: 05          vpchx:  RET
 1049 f663:             ;
 1050 f663:             ; vlf: column 0 of the next row; on the last row the screen scrolls instead (R7, TMP clobbered)
 1051 f663: 0e 00       vlf:    LDAI 0
 1052 f665: e5 0f f4            STA VCOL
 1053 f668: e4 0f f3            LDA VROW
 1054 f66b: b0 01               ADDI 1
 1055 f66d: 0d 18               LDTI VROWS
 1056 f66f: a8 f6 82            BREQ vscroll
 1057 f672: e5 0f f3            STA VROW
 1058 f675: f7 0f f6            LDR R7,VLINE
