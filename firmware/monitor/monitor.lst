 1102 f6b4: 56                  INCR R6
 1103 f6b5: 57                  INCR R7
 1104 f6b6: 46                  LDAVR R6
 1105 f6b7: 4f                  STAVR R7
 1106 f6b8: 56                  INCR R6
 1107 f6b9: 57                  INCR R7
 1108 f6ba: 5d                  DECR R5
 1109 f6bb: 25                  MVRLA R5
 1110 f6bc: a2 f6 9a            BRNZ vscrl
 1111 f6bf: e4 0f f8            LDA VCOLSV
 1112 f6c2: 35                  MVARL R5
 1113 f6c3: d7 20       vscrb:  LDIVR R7,' '
 1114 f6c5: 57                  INCR R7
 1115 f6c6: 5d                  DECR R5
 1116 f6c7: 25                  MVRLA R5
 1117 f6c8: a2 f6 c3            BRNZ vscrb
 1118 f6cb: 08 50               POPR R5
 1119 f6cd: 08 60               POPR R6
 1120 f6cf: 05                  RET
 1121 f6d0:             ;
 1122 f6d0:             ; vupper: $60-$7F down to $40-$5F (lower case to upper; the monitor's toupper also moves [ \ ] ^ _, which the
 1123 f6d0:             ; 64-glyph set has)
 1124 f6d0: 0d 60       vupper: LDTI 060h
 1125 f6d2: a7 f6 d7            BRLT vuppx
 1126 f6d5: b1 20               SUBI 020h
 1127 f6d7: 05          vuppx:  RET
 1128 f6d8:             ;
 1129 f6d8:             ; vcaddr: R7 = VLINE + VCOL, the cursor's address (TMP clobbered)
 1130 f6d8: e6 0f f4    vcaddr: LDT VCOL
 1131 f6db: f7 0f f6            LDR R7,VLINE
 1132 f6de:             ; vaddt: R7 += TMP (8 bits). The ADDIC follows the ADDI with only register moves between: the carry is the add's
 1133 f6de:             ; on the machine and on both emulators (docs/programming/ISA-REFERENCE.md section 6)
 1134 f6de: 27          vaddt:  MVRLA R7
 1135 f6df: b8                  ADDT
 1136 f6e0: 37                  MVARL R7
 1137 f6e1: 2f                  MVRHA R7
