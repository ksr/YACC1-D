 1168 f72e: a0 f7 34            BR vctlx
 1169 f731: 04 f5 bb    vctlc:  JSR vcls
 1170 f734: e4 0f f0    vctlx:  LDA VIDPRES
 1171 f737: 05                  RET
 1172 f738:             ;
 1173 f738:             ; ---- V: the video unit (monitor command) ---------------------------------------------------------------------
 1174 f738:             ; V then a letter (blanks skipped); numbers are hex, blanks between them optional. V? (or any other letter) lists:
 1175 f738:             ;   VS  status          VP  probe again      VI  init (CRTC, clear, home)     VC  clear, home
 1176 f738:             ;   VM1 / VM0  mirror on / off               VW rr cc text  text at row rr, column cc (not the cursor)
 1177 f738:             ;   VB aaaa bb bb ..  bytes from aaaa ($Dxxx only)   VF bb  fill the 2K     VD  the screen as text (not mirrored)
 1178 f738:             ;   VR rr [vv]  write CRTC register rr, or read it
 1179 f738:             ;
 1180 f738:             cmd_video:
 1181 f738: 0d 00               LDTI NOMODE
 1182 f73a: e7 0f 00            STT monmode
 1183 f73d: 04 f8 cf            JSR vskip
