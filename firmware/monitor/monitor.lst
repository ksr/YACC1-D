 1759 fa61: 05                  RET
 1760 fa62:             ;
 1761 fa62:             ; uartinne: uartin WITHOUT the echo and the LED (2026-09-23, vector $FFFC): Y1/OS's CONIN syscall reads the
 1762 fa62:             ; console for a program (a filter reading its input) and the shell echoes what it wants itself. Same paths:
 1763 fa62:             ; port 2 on the instruction-level emulator (BRDEV), the UART on the machine; CR becomes LF.
 1764 fa62:             ;
 1765 fa62:             uartinne:
 1766 fa62: af fa 67            BRDEV uartinnehw
 1767 fa65: 92                  inp p2
 1768 fa66: 05                  ret
 1769 fa67:             uartinnehw:
 1770 fa67: 04 f3 3e            JSR   kbst              ; 2026-11-10: the video card's keyboard, else the UART
 1771 fa6a: a1 fa 71            BRZ   uartinnew
 1772 fa6d: 9e                  INP   PE
 1773 fa6e: a0 fa 7c            BR    uartinnecv
 1774 fa71:             uartinnew:
 1775 fa71: 70 68               OUTI  P0,(UARTCS!UARTA5)
 1776 fa73: 91                  INP   p1
 1777 fa74: b3 01               ANDI  01h
 1778 fa76: a1 fa 67            BRZ   uartinnehw
 1779 fa79: 70 40               OUTI  P0,(UARTCS)
 1780 fa7b: 91                  INP   P1
 1781 fa7c:             uartinnecv:
 1782 fa7c: 0d 0d               ldti 0dh
 1783 fa7e: aa fa 83            brneq uartinnec
 1784 fa81: 0e 0a               ldai 0ah
 1785 fa83:             uartinnec:
 1786 fa83: 05                  RET
