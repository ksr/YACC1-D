  589 f2dd: 04 f2 bf            JSR cfsetl
  590 f2e0: 78 07               OUTI P8,CFSEL_CMD
  591 f2e2: 79 20               OUTI P9,020H            ; READ SECTORS
  592 f2e4: 04 f2 92            JSR cfdrq
  593 f2e7: b3 08               ANDI 008H
  594 f2e9: a1 f3 00            BRZ cferr
  595 f2ec: 78 00               OUTI P8,CFSEL_DATA
  596 f2ee: 1e 02 00            MVIW R6,512
  597 f2f1:             cfrdl:
  598 f2f1: 99                  INP P9
  599 f2f2: 4f                  STAVR R7
