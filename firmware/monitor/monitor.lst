 1061 f695: 05                  RET
 1062 f696:             ;
 1063 f696:             ; vscroll: rows 1..VROWS-1 up one row (8 bytes per pass), the last row blanked; R5/R6 kept, R7 clobbered
 1064 f696:             vscroll:
 1065 f696: 07 06               PUSHR R6
 1066 f698: 07 05               PUSHR R5
 1067 f69a: 1f d0 00            MVIW R7,VIDRAM
 1068 f69d: e6 0f f8            LDT VCOLSV
 1069 f6a0: 04 f6 f2            JSR vaddt
