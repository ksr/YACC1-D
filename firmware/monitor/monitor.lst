  611 f30b: 79 30               OUTI P9,030H            ; WRITE SECTORS
  612 f30d: 04 f2 92            JSR cfdrq
  613 f310: b3 08               ANDI 008H
  614 f312: a1 f3 00            BRZ cferr
  615 f315: 78 00               OUTI P8,CFSEL_DATA
  616 f317: 1e 02 00            MVIW R6,512
  617 f31a:             cfwrl:
  618 f31a: 47                  LDAVR R7
  619 f31b: 69                  OUTA P9
  620 f31c: 57                  INCR R7
  621 f31d: 5e                  DECR R6
  622 f31e: 26                  MVRLA R6
  623 f31f: a2 f3 1a            BRNZ cfwrl
  624 f322: 2e                  MVRHA R6
  625 f323: a2 f3 1a            BRNZ cfwrl
  626 f326: 04 f2 7a            JSR cfwait
  627 f329: b3 01               ANDI 001H
  628 f32b: 05                  RET
  629 f32c:             ;
  630 f32c:             ; const: ACC = 1 when a console byte is waiting. The emulator's port-2 console has no status: always ready.
  631 f32c:             const:
  632 f32c: af f3 32            BRDEV consthw
  633 f32f: 0e 01               LDAI 1
  634 f331: 05                  RET
  635 f332:             consthw:
  636 f332: 70 68               OUTI P0,(UARTCS!UARTA5)
  637 f334: 91                  INP P1
  638 f335: b3 01               ANDI 001H
  639 f337: 05                  RET
  640 f338:             ;
  641 f338:             ; O command: boot. Read the boot block (LBA 0) to OSBASE, check 'P8' and OSCNT, read OSCNT sectors from LBA 1
  642 f338:             ; to OSBASE and call it; the OS returns with RET.
  643 f338:             ;
  644 f338:             ;
  645 f338:             ; ':' - Intel-hex loader (YACC1-D 2026-09-23). A ':' at the prompt starts load mode: the rest of the record is read
  646 f338:             ; without echo (uartinne), its bytes stored from its address on, and the record acknowledged with one character:
  647 f338:             ;   .  stored and the checksum is right
  648 f338:             ;   ?  a bad hex digit or a bad checksum
  649 f338:             ;   !  refused or not verified: an address outside $1000-$DFFF (the monitor's page, the stack and the ROM are
  650 f338:             ;      protected; any write to $E000-$FFFF would reach the 28C64, review M2), or the byte read back differently
  651 f338:             ; Between records everything up to the next ':' is skipped (CR, LF, blanks), so an assembler .img can be pasted into
  652 f338:             ; a terminal or sent as is; ESC (or a NUL, the emulators' end of input) abandons, between records or inside one. The end record (type 01) prints
  653 f338:             ; LOADED, or LOADED WITH ERRORS when any record failed, and returns to the prompt. Records of other types are read
  654 f338:             ; and checked but not stored. Host side: tools/monload.py paces the characters (the UART has no FIFO enabled: one
  655 f338:             ; character of buffering) and waits for each acknowledgement. Registers: R3 checksum, R4 count, R5 type,
  656 f338:             ; R6 record status (0 ok, 1 bad hex, 2 refused/unverified), R7 the address; never R2.
  657 f338:             ;
  658 f338:             hexload:
  659 f338: 0d 05               LDTI  LOADMODE
  660 f33a: e7 0f 00            STT   monmode
  661 f33d: 0d 00               LDTI  0
  662 f33f: e7 0f 01            STT   lderr
  663 f342:             ldrec:
  664 f342: 1b 00 00            MVIW  R3,0
  665 f345: 1c 00 00            MVIW  R4,0
  666 f348: 1e 00 00            MVIW  R6,0
  667 f34b: 04 f3 f3            JSR   ldbyte            ; byte count
  668 f34e: 34                  MVARL R4
  669 f34f: 04 f3 f3            JSR   ldbyte            ; address high
  670 f352: 3f                  MVARH R7
  671 f353: 04 f3 f3            JSR   ldbyte            ; address low
  672 f356: 37                  MVARL R7
  673 f357: 04 f3 f3            JSR   ldbyte            ; record type
  674 f35a: 35                  MVARL R5
  675 f35b:             ldloop:
  676 f35b: 24                  MVRLA R4
  677 f35c: a1 f3 8b            BRZ   ldsum
  678 f35f: 04 f3 f3            JSR   ldbyte
  679 f362: 09                  PUSH
  680 f363: 25                  MVRLA R5
  681 f364: a2 f3 85            BRNZ  ldskip            ; not a data record: check only
  682 f367: 2f                  MVRHA R7                ; protect everything outside $1000-$DFFF
  683 f368: 0d 0f               LDTI  00fh
  684 f36a: a9 f3 70            BRGT  ldlowok
  685 f36d: a0 f3 82            BR    ldref
