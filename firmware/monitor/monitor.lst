  958 f5a8: 0e 01               LDAI 1
  959 f5aa: e5 0f f2            STA VIDCUR
  960 f5ad:             ; vcls: the screen cleared (the font under it stays), cursor home (R5-R7 clobbered)
  961 f5ad: 1e f8 90    vcls:   MVIW R6,vclrt
  962 f5b0: 04 f5 7c            JSR vsend
  963 f5b3:             ; vhome: cursor to row 0, column 0 (R7 clobbered)
  964 f5b3: 0e 00       vhome:  LDAI 0
  965 f5b5: e5 0f f3            STA VROW
  966 f5b8: e5 0f f4            STA VCOL
  967 f5bb: 1f 01 df            MVIW R7,VYHOME
  968 f5be: ef 0f f6            STR R7,VYTOP
