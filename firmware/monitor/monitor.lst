 1201 f731: a8 f7 a8            BREQ vcwrt
 1202 f734: 0d 42               LDTI 'B'
 1203 f736: a8 f7 fd            BREQ vcbyt
 1204 f739: 0d 46               LDTI 'F'
 1205 f73b: a8 f8 22            BREQ vcfil
