  500 f27a:             ;
  501 f27a:             ; ---- CompactFlash driver (YACC1-D 2026-09-22) -----------------------------------------------------------
  502 f27a:             ; The card sits on two ports: P8 = register-select latch (ATA task-file register 0-7), P9 = data.
  503 f27a:             ; 8-bit True IDE mode. Registers: 0 data, 1 error/feature, 2 sector count, 3-5 LBA0-2, 6 drive/head, 7 status/cmd.
  504 f27a:             ; Entry points (also BIOS vectors at 0FFECh..): cfinit  ACC = 0 ok / 1 error (absent card times out);
  505 f27a:             ;   cfread   sector CFLBA0..2 -> (R7), R7 += 512, ACC = 0 ok / 1 error;   cfwrite  (R7) -> sector, R7 += 512, same;
  506 f27a:             ;   R6 and TMP are clobbered. const  ACC = 1 when a console byte waits (0 otherwise).
  507 f27a:             ;
  508 f27a:             CFSEL_DATA:  EQU 0
  509 f27a:             CFSEL_FEAT:  EQU 1
  510 f27a:             CFSEL_SCNT:  EQU 2
  511 f27a:             CFSEL_LBA0:  EQU 3
  512 f27a:             CFSEL_LBA1:  EQU 4
  513 f27a:             CFSEL_LBA2:  EQU 5
  514 f27a:             CFSEL_HEAD:  EQU 6
  515 f27a:             CFSEL_CMD:   EQU 7
  516 f27a:             ;
  517 f27a:             ; wait while BSY (bit 7), bounded to 65536 polls; returns the status in ACC
  518 f27a:             cfwait:
  519 f27a: 1e 00 00            MVIW R6,0
  520 f27d:             cfwaitl:
  521 f27d: 78 07               OUTI P8,CFSEL_CMD
  522 f27f: 99                  INP P9
  523 f280: b3 80               ANDI 080H
  524 f282: a1 f2 8e            BRZ cfwaitd
  525 f285: 5e                  DECR R6
  526 f286: 26                  MVRLA R6
  527 f287: a2 f2 7d            BRNZ cfwaitl
  528 f28a: 2e                  MVRHA R6
  529 f28b: a2 f2 7d            BRNZ cfwaitl
  530 f28e:             cfwaitd:
  531 f28e: 78 07               OUTI P8,CFSEL_CMD
  532 f290: 99                  INP P9
  533 f291: 05                  RET
  534 f292:             ;
  535 f292:             ; wait until DRQ (bit 3), bounded; returns the status in ACC
  536 f292:             cfdrq:
  537 f292: 1e 00 00            MVIW R6,0
  538 f295:             cfdrql:
  539 f295: 78 07               OUTI P8,CFSEL_CMD
  540 f297: 99                  INP P9
  541 f298: b3 08               ANDI 008H
  542 f29a: a2 f2 a6            BRNZ cfdrqd
  543 f29d: 5e                  DECR R6
  544 f29e: 26                  MVRLA R6
  545 f29f: a2 f2 95            BRNZ cfdrql
  546 f2a2: 2e                  MVRHA R6
  547 f2a3: a2 f2 95            BRNZ cfdrql
  548 f2a6:             cfdrqd:
  549 f2a6: 78 07               OUTI P8,CFSEL_CMD
  550 f2a8: 99                  INP P9
  551 f2a9: 05                  RET
  552 f2aa:             ;
  553 f2aa:             cfinit:
  554 f2aa: 04 f2 7a            JSR cfwait
  555 f2ad: 78 06               OUTI P8,CFSEL_HEAD
  556 f2af: 79 e0               OUTI P9,0E0H            ; LBA mode, drive 0
  557 f2b1: 78 01               OUTI P8,CFSEL_FEAT
  558 f2b3: 79 01               OUTI P9,001H            ; feature 1: 8-bit transfers
  559 f2b5: 78 07               OUTI P8,CFSEL_CMD
  560 f2b7: 79 ef               OUTI P9,0EFH            ; SET FEATURES
  561 f2b9: 04 f2 7a            JSR cfwait
  562 f2bc: b3 01               ANDI 001H               ; ERR bit; an absent card reads FFh and times out -> 1
  563 f2be: 05                  RET
  564 f2bf:             ;
  565 f2bf:             ; task file <- CFLBA0..2, LBA mode, one sector
  566 f2bf:             cfsetl:
  567 f2bf: 78 03               OUTI P8,CFSEL_LBA0
  568 f2c1: e4 0f 10            LDA CFLBA0
  569 f2c4: 69                  OUTA P9
  570 f2c5: 78 04               OUTI P8,CFSEL_LBA1
  571 f2c7: e4 0f 11            LDA CFLBA1
  572 f2ca: 69                  OUTA P9
  573 f2cb: 78 05               OUTI P8,CFSEL_LBA2
  574 f2cd: e4 0f 12            LDA CFLBA2
  575 f2d0: 69                  OUTA P9
  576 f2d1: 78 06               OUTI P8,CFSEL_HEAD
  577 f2d3: 79 e0               OUTI P9,0E0H
  578 f2d5: 78 02               OUTI P8,CFSEL_SCNT
  579 f2d7: 79 01               OUTI P9,1
  580 f2d9: 05                  RET
  581 f2da:             ;
  582 f2da:             cfread:
  583 f2da: 04 f2 7a            JSR cfwait
  584 f2dd: 04 f2 bf            JSR cfsetl
  585 f2e0: 78 07               OUTI P8,CFSEL_CMD
  586 f2e2: 79 20               OUTI P9,020H            ; READ SECTORS
  587 f2e4: 04 f2 92            JSR cfdrq
  588 f2e7: b3 08               ANDI 008H
  589 f2e9: a1 f3 00            BRZ cferr
  590 f2ec: 78 00               OUTI P8,CFSEL_DATA
  591 f2ee: 1e 02 00            MVIW R6,512
  592 f2f1:             cfrdl:
  593 f2f1: 99                  INP P9
  594 f2f2: 4f                  STAVR R7
  595 f2f3: 57                  INCR R7
  596 f2f4: 5e                  DECR R6
  597 f2f5: 26                  MVRLA R6
  598 f2f6: a2 f2 f1            BRNZ cfrdl
  599 f2f9: 2e                  MVRHA R6
  600 f2fa: a2 f2 f1            BRNZ cfrdl
  601 f2fd: 0e 00               LDAI 0
  602 f2ff: 05                  RET
  603 f300:             cferr:
  604 f300: 0e 01               LDAI 1
  605 f302: 05                  RET
  606 f303:             ;
  607 f303:             cfwrite:
