 1036 f63c: 04 f6 40            JSR vlf
 1037 f63f: 05          vpchx:  RET
 1038 f640:             ;
 1039 f640:             ; vlf: column 0 of the next row; on the last row the screen scrolls instead (R7, TMP clobbered)
 1040 f640: 0e 00       vlf:    LDAI 0
 1041 f642: e5 0f f4            STA VCOL
 1042 f645: e4 0f f3            LDA VROW
 1043 f648: b0 01               ADDI 1
 1044 f64a: 0d 19               LDTI VROWS
 1045 f64c: a8 f6 5f            BREQ vscroll
 1046 f64f: e5 0f f3            STA VROW
 1047 f652: f7 0f f6            LDR R7,VLINE
 1048 f655: e6 0f f8            LDT VCOLSV
 1049 f658: 04 f6 b2            JSR vaddt
 1050 f65b: ef 0f f6            STR R7,VLINE
 1051 f65e: 05                  RET
 1052 f65f:             ;
 1053 f65f:             ; vscroll: rows 1..VROWS-1 up one row (8 bytes per pass), the last row blanked; R5/R6 kept, R7 clobbered
 1054 f65f:             vscroll:
 1055 f65f: 07 06               PUSHR R6
 1056 f661: 07 05               PUSHR R5
 1057 f663: 1f d0 00            MVIW R7,VIDRAM
 1058 f666: e6 0f f8            LDT VCOLSV
