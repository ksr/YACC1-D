 1140 f6fa:             ;
 1141 f6fa:             ; vcursor: with VIDCUR set, the CRTC's cursor registers R14/R15 <- the cursor's offset from VIDRAM (R7 clobbered)
 1142 f6fa:             vcursor:
 1143 f6fa: e4 0f f2            LDA VIDCUR
 1144 f6fd: a1 f7 17            BRZ vcurx
