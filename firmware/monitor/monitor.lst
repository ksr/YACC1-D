  558 f2b1: 78 01               OUTI P8,CFSEL_FEAT
  559 f2b3: 79 01               OUTI P9,001H            ; feature 1: 8-bit transfers
  560 f2b5: 78 07               OUTI P8,CFSEL_CMD
  561 f2b7: 79 ef               OUTI P9,0EFH            ; SET FEATURES
  562 f2b9: 04 f2 7a            JSR cfwait
  563 f2bc: b3 01               ANDI 001H               ; ERR bit; an absent card reads FFh and times out -> 1
  564 f2be: 05                  RET
  565 f2bf:             ;
  566 f2bf:             ; task file <- CFLBA0..2, LBA mode, one sector
  567 f2bf:             cfsetl:
  568 f2bf: 78 03               OUTI P8,CFSEL_LBA0
  569 f2c1: e4 0f 10            LDA CFLBA0
  570 f2c4: 69                  OUTA P9
  571 f2c5: 78 04               OUTI P8,CFSEL_LBA1
  572 f2c7: e4 0f 11            LDA CFLBA1
  573 f2ca: 69                  OUTA P9
  574 f2cb: 78 05               OUTI P8,CFSEL_LBA2
  575 f2cd: e4 0f 12            LDA CFLBA2
  576 f2d0: 69                  OUTA P9
  577 f2d1: 78 06               OUTI P8,CFSEL_HEAD
  578 f2d3: 79 e0               OUTI P9,0E0H
  579 f2d5: 78 02               OUTI P8,CFSEL_SCNT
  580 f2d7: 79 01               OUTI P9,1
  581 f2d9: 05                  RET
