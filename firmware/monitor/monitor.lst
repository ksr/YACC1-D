  546 f29f: a2 f2 95            BRNZ cfdrql
  547 f2a2: 2e                  MVRHA R6
  548 f2a3: a2 f2 95            BRNZ cfdrql
  549 f2a6:             cfdrqd:
  550 f2a6: 78 07               OUTI P8,CFSEL_CMD
  551 f2a8: 99                  INP P9
  552 f2a9: 05                  RET
  553 f2aa:             ;
  554 f2aa:             cfinit:
  555 f2aa: 04 f2 7a            JSR cfwait
