  641 f32c:             ;
  642 f32c:             ; const: ACC = 1 when a console byte is waiting (2026-11-10: a key on the V2.0 card's keyboard counts too). The
  643 f32c:             ; emulator's port-2 console has no status: always ready.
  644 f32c:             const:
