  753 f3f6: b6                  SHL
  754 f3f7: b6                  SHL
  755 f3f8: b6                  SHL
  756 f3f9: b6                  SHL
  757 f3fa: b3 f0               ANDI  0f0h
  758 f3fc: 09                  PUSH
