  631 f326: 04 f2 7a            JSR cfwait
  632 f329: b3 01               ANDI 001H
  633 f32b: 05                  RET
  634 f32c:             ;
  635 f32c:             ; const: ACC = 1 when a console byte is waiting (2026-11-10: a key on the video card's keyboard counts too). The
  636 f32c:             ; emulator's port-2 console has no status: always ready.
  637 f32c:             const:
  638 f32c: af f3 32            BRDEV consthw
  639 f32f: 0e 01               LDAI 1
  640 f331: 05                  RET
  641 f332:             consthw:
  642 f332: 04 f3 3e            JSR kbst
  643 f335: a2 f3 3d            BRNZ constx
  644 f338: 70 68               OUTI P0,(UARTCS!UARTA5)
  645 f33a: 91                  INP P1
  646 f33b: b3 01               ANDI 001H
  647 f33d: 05          constx: RET
  648 f33e:             ;
  649 f33e:             ; kbst (2026-11-10): ACC = 1 when the video card's PS/2 keyboard has a byte (IN PD bit 0, FULL), else 0; the
  650 f33e:             ; byte is then IN PE (the card's rule: read PE only after PD showed FULL). 0 with no card (VIDPRES = 0).
  651 f33e: e4 0f f0    kbst:   LDA VIDPRES
  652 f341: 0d 01               LDTI 1
  653 f343: aa f3 4a            BRNEQ kbst0
  654 f346: 9d                  INP PD
  655 f347: b3 01               ANDI 1
  656 f349: 05                  RET
  657 f34a: 0e 00       kbst0:  LDAI 0
  658 f34c: 05                  RET
  659 f34d:             ;
  660 f34d:             ; O command: boot. Read the boot block (LBA 0) to OSBASE, check 'P8' and OSCNT, read OSCNT sectors from LBA 1
  661 f34d:             ; to OSBASE and call it; the OS returns with RET.
  662 f34d:             ;
  663 f34d:             ;
  664 f34d:             ; ':' - Intel-hex loader (YACC1-D 2026-09-23). A ':' at the prompt starts load mode: the rest of the record is read
  665 f34d:             ; without echo (uartinne), its bytes stored from its address on, and the record acknowledged with one character:
  666 f34d:             ;   .  stored and the checksum is right
  667 f34d:             ;   ?  a bad hex digit or a bad checksum
  668 f34d:             ;   !  refused or not verified: an address outside $1000-$DFFF (the monitor's page, the stack and the ROM are
  669 f34d:             ;      protected; any write to $E000-$FFFF would reach the 28C64, review M2), or the byte read back differently
  670 f34d:             ; Between records everything up to the next ':' is skipped (CR, LF, blanks), so an assembler .img can be pasted into
  671 f34d:             ; a terminal or sent as is; ESC (or a NUL, the emulators' end of input) abandons, between records or inside one. The end record (type 01) prints
  672 f34d:             ; LOADED, or LOADED WITH ERRORS when any record failed, and returns to the prompt. Records of other types are read
  673 f34d:             ; and checked but not stored. Host side: tools/monload.py paces the characters (the UART has no FIFO enabled: one
  674 f34d:             ; character of buffering) and waits for each acknowledgement. Registers: R3 checksum, R4 count, R5 type,
  675 f34d:             ; R6 record status (0 ok, 1 bad hex, 2 refused/unverified), R7 the address; never R2.
  676 f34d:             ;
  677 f34d:             hexload:
  678 f34d: 0d 05               LDTI  LOADMODE
  679 f34f: e7 0f 00            STT   monmode
  680 f352: 0d 00               LDTI  0
  681 f354: e7 0f 01            STT   lderr
