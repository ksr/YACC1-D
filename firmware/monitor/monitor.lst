  479 f26a:             ; YACC1-D 2026-09-22: was BRVR R7, which is an INDIRECT jump (PC <- the word AT the address, see the
  480 f26a:             ; microcode: branch() fetches the target through R7 like BR fetches its operand through the PC), so G jumped
  481 f26a:             ; through whatever was stored at AAAA. JSRUR R7 jumps TO AAAA and pushes a return address: the program ends
  482 f26a:             ; with RET and lands back in the command loop.
  483 f26a:             ;
  484 f26a: 06 07             JSRUR R7
  485 f26c: a0 f0 6a          BR cmdloop
  486 f26f:             
  487 f26f:             dumpreg:
  488 f26f: 04 f9 0e          JSR showregs
  489 f272:             ;      MVIB R6,NOMODE
  490 f272: 0d 00             LDTI NOMODE
  491 f274: e7 0f 00          STT monmode
  492 f277:             
  493 f277: a0 f0 6a          BR cmdloop
  494 f27a:             
  495 f27a:             ;
  496 f27a:             ; ---- CompactFlash driver (YACC1-D 2026-09-22) -----------------------------------------------------------
  497 f27a:             ; The card sits on two ports: P8 = register-select latch (ATA task-file register 0-7), P9 = data.
  498 f27a:             ; 8-bit True IDE mode. Registers: 0 data, 1 error/feature, 2 sector count, 3-5 LBA0-2, 6 drive/head, 7 status/cmd.
  499 f27a:             ; Entry points (also BIOS vectors at 0FFECh..): cfinit  ACC = 0 ok / 1 error (absent card times out);
  500 f27a:             ;   cfread   sector CFLBA0..2 -> (R7), R7 += 512, ACC = 0 ok / 1 error;   cfwrite  (R7) -> sector, R7 += 512, same;
  501 f27a:             ;   R6 and TMP are clobbered. const  ACC = 1 when a console byte waits (0 otherwise).
  502 f27a:             ;
  503 f27a:             CFSEL_DATA:  EQU 0
  504 f27a:             CFSEL_FEAT:  EQU 1
  505 f27a:             CFSEL_SCNT:  EQU 2
  506 f27a:             CFSEL_LBA0:  EQU 3
  507 f27a:             CFSEL_LBA1:  EQU 4
  508 f27a:             CFSEL_LBA2:  EQU 5
  509 f27a:             CFSEL_HEAD:  EQU 6
  510 f27a:             CFSEL_CMD:   EQU 7
  511 f27a:             ;
  512 f27a:             ; wait while BSY (bit 7), bounded to 65536 polls; returns the status in ACC
  513 f27a:             cfwait:
  514 f27a: 1e 00 00            MVIW R6,0
  515 f27d:             cfwaitl:
  516 f27d: 78 07               OUTI P8,CFSEL_CMD
  517 f27f: 99                  INP P9
  518 f280: b3 80               ANDI 080H
  519 f282: a1 f2 8e            BRZ cfwaitd
  520 f285: 5e                  DECR R6
  521 f286: 26                  MVRLA R6
  522 f287: a2 f2 7d            BRNZ cfwaitl
  523 f28a: 2e                  MVRHA R6
  524 f28b: a2 f2 7d            BRNZ cfwaitl
  525 f28e:             cfwaitd:
  526 f28e: 78 07               OUTI P8,CFSEL_CMD
  527 f290: 99                  INP P9
  528 f291: 05                  RET
  529 f292:             ;
  530 f292:             ; wait until DRQ (bit 3), bounded; returns the status in ACC
  531 f292:             cfdrq:
  532 f292: 1e 00 00            MVIW R6,0
  533 f295:             cfdrql:
  534 f295: 78 07               OUTI P8,CFSEL_CMD
  535 f297: 99                  INP P9
  536 f298: b3 08               ANDI 008H
  537 f29a: a2 f2 a6            BRNZ cfdrqd
  538 f29d: 5e                  DECR R6
  539 f29e: 26                  MVRLA R6
  540 f29f: a2 f2 95            BRNZ cfdrql
  541 f2a2: 2e                  MVRHA R6
  542 f2a3: a2 f2 95            BRNZ cfdrql
  543 f2a6:             cfdrqd:
  544 f2a6: 78 07               OUTI P8,CFSEL_CMD
  545 f2a8: 99                  INP P9
  546 f2a9: 05                  RET
  547 f2aa:             ;
  548 f2aa:             cfinit:
  549 f2aa: 04 f2 7a            JSR cfwait
  550 f2ad: 78 06               OUTI P8,CFSEL_HEAD
  551 f2af: 79 e0               OUTI P9,0E0H            ; LBA mode, drive 0
  552 f2b1: 78 01               OUTI P8,CFSEL_FEAT
  553 f2b3: 79 01               OUTI P9,001H            ; feature 1: 8-bit transfers
  554 f2b5: 78 07               OUTI P8,CFSEL_CMD
  555 f2b7: 79 ef               OUTI P9,0EFH            ; SET FEATURES
  556 f2b9: 04 f2 7a            JSR cfwait
  557 f2bc: b3 01               ANDI 001H               ; ERR bit; an absent card reads FFh and times out -> 1
  558 f2be: 05                  RET
  559 f2bf:             ;
  560 f2bf:             ; task file <- CFLBA0..2, LBA mode, one sector
  561 f2bf:             cfsetl:
  562 f2bf: 78 03               OUTI P8,CFSEL_LBA0
  563 f2c1: e4 0f 10            LDA CFLBA0
  564 f2c4: 69                  OUTA P9
  565 f2c5: 78 04               OUTI P8,CFSEL_LBA1
  566 f2c7: e4 0f 11            LDA CFLBA1
  567 f2ca: 69                  OUTA P9
  568 f2cb: 78 05               OUTI P8,CFSEL_LBA2
  569 f2cd: e4 0f 12            LDA CFLBA2
  570 f2d0: 69                  OUTA P9
  571 f2d1: 78 06               OUTI P8,CFSEL_HEAD
  572 f2d3: 79 e0               OUTI P9,0E0H
  573 f2d5: 78 02               OUTI P8,CFSEL_SCNT
  574 f2d7: 79 01               OUTI P9,1
  575 f2d9: 05                  RET
  576 f2da:             ;
  577 f2da:             cfread:
  578 f2da: 04 f2 7a            JSR cfwait
  579 f2dd: 04 f2 bf            JSR cfsetl
  580 f2e0: 78 07               OUTI P8,CFSEL_CMD
  581 f2e2: 79 20               OUTI P9,020H            ; READ SECTORS
  582 f2e4: 04 f2 92            JSR cfdrq
  583 f2e7: b3 08               ANDI 008H
  584 f2e9: a1 f3 00            BRZ cferr
  585 f2ec: 78 00               OUTI P8,CFSEL_DATA
  586 f2ee: 1e 02 00            MVIW R6,512
  587 f2f1:             cfrdl:
  588 f2f1: 99                  INP P9
  589 f2f2: 4f                  STAVR R7
  590 f2f3: 57                  INCR R7
  591 f2f4: 5e                  DECR R6
  592 f2f5: 26                  MVRLA R6
  593 f2f6: a2 f2 f1            BRNZ cfrdl
  594 f2f9: 2e                  MVRHA R6
  595 f2fa: a2 f2 f1            BRNZ cfrdl
  596 f2fd: 0e 00               LDAI 0
  597 f2ff: 05                  RET
  598 f300:             cferr:
  599 f300: 0e 01               LDAI 1
  600 f302: 05                  RET
  601 f303:             ;
  602 f303:             cfwrite:
  603 f303: 04 f2 7a            JSR cfwait
  604 f306: 04 f2 bf            JSR cfsetl
  605 f309: 78 07               OUTI P8,CFSEL_CMD
  606 f30b: 79 30               OUTI P9,030H            ; WRITE SECTORS
  607 f30d: 04 f2 92            JSR cfdrq
  608 f310: b3 08               ANDI 008H
  609 f312: a1 f3 00            BRZ cferr
  610 f315: 78 00               OUTI P8,CFSEL_DATA
  611 f317: 1e 02 00            MVIW R6,512
  612 f31a:             cfwrl:
  613 f31a: 47                  LDAVR R7
  614 f31b: 69                  OUTA P9
  615 f31c: 57                  INCR R7
  616 f31d: 5e                  DECR R6
  617 f31e: 26                  MVRLA R6
  618 f31f: a2 f3 1a            BRNZ cfwrl
  619 f322: 2e                  MVRHA R6
  620 f323: a2 f3 1a            BRNZ cfwrl
  621 f326: 04 f2 7a            JSR cfwait
  622 f329: b3 01               ANDI 001H
  623 f32b: 05                  RET
  624 f32c:             ;
  625 f32c:             ; const: ACC = 1 when a console byte is waiting. The emulator's port-2 console has no status: always ready.
  626 f32c:             const:
  627 f32c: af f3 32            BRDEV consthw
  628 f32f: 0e 01               LDAI 1
  629 f331: 05                  RET
  630 f332:             consthw:
  631 f332: 70 68               OUTI P0,(UARTCS!UARTA5)
  632 f334: 91                  INP P1
  633 f335: b3 01               ANDI 001H
  634 f337: 05                  RET
  635 f338:             ;
  636 f338:             ; O command: boot. Read the boot block (LBA 0) to OSBASE, check 'P8' and OSCNT, read OSCNT sectors from LBA 1
  637 f338:             ; to OSBASE and call it; the OS returns with RET.
  638 f338:             ;
  639 f338:             ;
  640 f338:             ; ':' - Intel-hex loader (YACC1-D 2026-09-23). A ':' at the prompt starts load mode: the rest of the record is read
  641 f338:             ; without echo (uartinne), its bytes stored from its address on, and the record acknowledged with one character:
  642 f338:             ;   .  stored and the checksum is right
  643 f338:             ;   ?  a bad hex digit or a bad checksum
  644 f338:             ;   !  refused or not verified: an address outside $1000-$DFFF (the monitor's page, the stack and the ROM are
  645 f338:             ;      protected; any write to $E000-$FFFF would reach the 28C64, review M2), or the byte read back differently
  646 f338:             ; Between records everything up to the next ':' is skipped (CR, LF, blanks), so an assembler .img can be pasted into
  647 f338:             ; a terminal or sent as is; ESC (or a NUL, the emulators' end of input) abandons, between records or inside one. The end record (type 01) prints
  648 f338:             ; LOADED, or LOADED WITH ERRORS when any record failed, and returns to the prompt. Records of other types are read
  649 f338:             ; and checked but not stored. Host side: tools/monload.py paces the characters (the UART has no FIFO enabled: one
  650 f338:             ; character of buffering) and waits for each acknowledgement. Registers: R3 checksum, R4 count, R5 type,
  651 f338:             ; R6 record status (0 ok, 1 bad hex, 2 refused/unverified), R7 the address; never R2.
  652 f338:             ;
  653 f338:             hexload:
  654 f338: 0d 05               LDTI  LOADMODE
  655 f33a: e7 0f 00            STT   monmode
  656 f33d: 0d 00               LDTI  0
  657 f33f: e7 0f 01            STT   lderr
  658 f342:             ldrec:
  659 f342: 1b 00 00            MVIW  R3,0
  660 f345: 1c 00 00            MVIW  R4,0
  661 f348: 1e 00 00            MVIW  R6,0
  662 f34b: 04 f3 f3            JSR   ldbyte            ; byte count
  663 f34e: 34                  MVARL R4
  664 f34f: 04 f3 f3            JSR   ldbyte            ; address high
  665 f352: 3f                  MVARH R7
  666 f353: 04 f3 f3            JSR   ldbyte            ; address low
  667 f356: 37                  MVARL R7
  668 f357: 04 f3 f3            JSR   ldbyte            ; record type
  669 f35a: 35                  MVARL R5
  670 f35b:             ldloop:
  671 f35b: 24                  MVRLA R4
  672 f35c: a1 f3 8b            BRZ   ldsum
  673 f35f: 04 f3 f3            JSR   ldbyte
  674 f362: 09                  PUSH
  675 f363: 25                  MVRLA R5
  676 f364: a2 f3 85            BRNZ  ldskip            ; not a data record: check only
  677 f367: 2f                  MVRHA R7                ; protect everything outside $1000-$DFFF
  678 f368: 0d 0f               LDTI  00fh
  679 f36a: a9 f3 70            BRGT  ldlowok
  680 f36d: a0 f3 82            BR    ldref
  681 f370:             ldlowok:
  682 f370: 0d df               LDTI  0dfh
  683 f372: a9 f3 82            BRGT  ldref
  684 f375: 0a                  POP
  685 f376: 4f                  STAVR R7
  686 f377: 0b                  MVAT
  687 f378: 47                  LDAVR R7                ; read it back
  688 f379: a8 f3 86            BREQ  ldnext
  689 f37c: 1e 00 02            MVIW  R6,2
  690 f37f: a0 f3 86            BR    ldnext
  691 f382:             ldref:
  692 f382: 1e 00 02            MVIW  R6,2
  693 f385:             ldskip:
  694 f385: 0a                  POP
  695 f386:             ldnext:
  696 f386: 57                  INCR  R7
  697 f387: 5c                  DECR  R4
  698 f388: a0 f3 5b            BR    ldloop
  699 f38b:             ldsum:
  700 f38b: 04 f3 f3            JSR   ldbyte            ; the checksum: the record's bytes now sum to zero
  701 f38e: 26                  MVRLA R6
  702 f38f: 0d 01               LDTI  1
  703 f391: a8 f3 aa            BREQ  ldbadrec
  704 f394: 23                  MVRLA R3
  705 f395: a2 f3 aa            BRNZ  ldbadrec
  706 f398: 26                  MVRLA R6
  707 f399: a2 f3 af            BRNZ  ldrefrec
  708 f39c: 25                  MVRLA R5
  709 f39d: 0d 01               LDTI  1
  710 f39f: a8 f3 d2            BREQ  ldeof
  711 f3a2: 0e 2e               LDAI  '.'
  712 f3a4: 04 f9 e0            JSR   uartout
  713 f3a7: a0 f3 bf            BR    ldwait
  714 f3aa:             ldbadrec:
  715 f3aa: 0e 3f               LDAI  '?'
  716 f3ac: a0 f3 b1            BR    ldflag
  717 f3af:             ldrefrec:
  718 f3af: 0e 21               LDAI  '!'
  719 f3b1:             ldflag:
  720 f3b1: 04 f9 e0            JSR   uartout
  721 f3b4: 0d 01               LDTI  1
  722 f3b6: e7 0f 01            STT   lderr
  723 f3b9: 25                  MVRLA R5
  724 f3ba: 0d 01               LDTI  1
  725 f3bc: a8 f3 d2            BREQ  ldeof
