  905 f55d: 05          vidrx:  RET
  906 f55e:             ;
  907 f55e:             ; vprobe: VIDPRES = 1 when IN PE (the card's status) reads $6x, the card ID in bits 7..4, else 0. With no card the
  908 f55e:             ; port is not decoded and reads the floating bus: $FF on the pull-ups, or the INP's own opcode $9E - neither is $6x.
  909 f55e:             ; A card found has its mouse turned off (PS/2 command 5): the keyboard alone is the console's.
  910 f55e: 9e          vprobe: INP PE
  911 f55f: b3 f0               ANDI 0f0h
  912 f561: 0d 60               LDTI 060h
  913 f563: aa f5 6d            BRNEQ vprno
  914 f566: 7e 05               OUTI PE,5
  915 f568: 0e 01               LDAI 1
  916 f56a: a0 f5 6f            BR vprset
  917 f56d: 0e 00       vprno:  LDAI 0
  918 f56f: e5 0f f0    vprset: STA VIDPRES
  919 f572: 05                  RET
  920 f573:             ;
  921 f573:             ; vwfe: the chip's address register on the FIFO, and wait until the write FIFO is empty: room for 16 bytes
  922 f573: 7a 00       vwfe:   OUTI PA,0
  923 f575: 9c          vwfel:  INP PC
  924 f576: b3 01               ANDI 1
  925 f578: a1 f5 75            BRZ vwfel
  926 f57b: 05                  RET
  927 f57c:             ;
  928 f57c:             ; vsend: packets to the write FIFO from the table at R6: a count (0 ends the table), then that many bytes, each
  929 f57c:             ; packet (16 bytes at most) after the FIFO is empty (R5, R6 clobbered)
  930 f57c: 46          vsend:  LDAVR R6
  931 f57d: a1 f5 90            BRZ vsendx
  932 f580: 35                  MVARL R5
  933 f581: 56                  INCR R6
  934 f582: 04 f5 73            JSR vwfe
  935 f585: 46          vsendl: LDAVR R6
  936 f586: 6b                  OUTA PB
  937 f587: 56                  INCR R6
  938 f588: 5d                  DECR R5
  939 f589: 25                  MVRLA R5
  940 f58a: a2 f5 85            BRNZ vsendl
  941 f58d: a0 f5 7c            BR vsend
  942 f590: 05          vsendx: RET
  943 f591:             ;
  944 f591:             ; vinit: the chip's registers (vregs: a register and its byte, to $FF), the origin and the font's picture (vsetup),
  945 f591:             ; then vcls (R5-R7 clobbered)
  946 f591: 1e f8 27    vinit:  MVIW R6,vregs
  947 f594: 46          vinitl: LDAVR R6
  948 f595: 0d ff               LDTI 0ffh
  949 f597: a8 f5 a2            BREQ viniti
  950 f59a: 6a                  OUTA PA
  951 f59b: 56                  INCR R6
  952 f59c: 46                  LDAVR R6
  953 f59d: 6b                  OUTA PB
  954 f59e: 56                  INCR R6
  955 f59f: a0 f5 94            BR vinitl
  956 f5a2: 1e f8 58    viniti: MVIW R6,vsetup
