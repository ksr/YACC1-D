  569 f2b1: 78 01               OUTI P8,CFSEL_FEAT
  570 f2b3: 79 01               OUTI P9,001H            ; feature 1: 8-bit transfers
  571 f2b5: 78 07               OUTI P8,CFSEL_CMD
  572 f2b7: 79 ef               OUTI P9,0EFH            ; SET FEATURES
  573 f2b9: 04 f2 7a            JSR cfwait
  574 f2bc: b3 01               ANDI 001H               ; ERR bit; an absent card reads FFh and times out -> 1
  575 f2be: 05                  RET
  576 f2bf:             ;
  577 f2bf:             ; task file <- CFLBA0..2, LBA mode, one sector
  578 f2bf:             cfsetl:
  579 f2bf: 78 03               OUTI P8,CFSEL_LBA0
  580 f2c1: e4 0f 10            LDA CFLBA0
  581 f2c4: 69                  OUTA P9
