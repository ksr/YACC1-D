 1026 f628:             ; vpchar: ACC stored at the cursor, the cursor one right; past the last column to the next row (R7, TMP clobbered)
 1027 f628: 09          vpchar: PUSH
 1028 f629: 04 f6 ac            JSR vcaddr
 1029 f62c: 0a                  POP
 1030 f62d: 4f                  STAVR R7
 1031 f62e: e4 0f f4            LDA VCOL
