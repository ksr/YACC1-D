  480 f26a:             ;
  481 f26a:             ; YACC1-D 2026-09-22: was BRVR R7, which is an INDIRECT jump (PC <- the word AT the address, see the
  482 f26a:             ; microcode: branch() fetches the target through R7 like BR fetches its operand through the PC), so G jumped
  483 f26a:             ; through whatever was stored at AAAA. JSRUR R7 jumps TO AAAA and pushes a return address: the program ends
  484 f26a:             ; with RET and lands back in the command loop.
  485 f26a:             ;
  486 f26a: 06 07             JSRUR R7
  487 f26c: a0 f0 6a          BR cmdloop
  488 f26f:             
  489 f26f:             dumpreg:
  490 f26f: 04 f9 45          JSR showregs
  491 f272:             ;      MVIB R6,NOMODE
  492 f272: 0d 00             LDTI NOMODE
  493 f274: e7 0f 00          STT monmode
  494 f277:             
  495 f277: a0 f0 6a          BR cmdloop
  496 f27a:             
  497 f27a:             ;
  498 f27a:             ; ---- CompactFlash driver (YACC1-D 2026-09-22) -----------------------------------------------------------
  499 f27a:             ; The card sits on two ports: P8 = register-select latch (ATA task-file register 0-7), P9 = data.
  500 f27a:             ; 8-bit True IDE mode. Registers: 0 data, 1 error/feature, 2 sector count, 3-5 LBA0-2, 6 drive/head, 7 status/cmd.
  501 f27a:             ; Entry points (also BIOS vectors at 0FFECh..): cfinit  ACC = 0 ok / 1 error (absent card times out);
  502 f27a:             ;   cfread   sector CFLBA0..2 -> (R7), R7 += 512, ACC = 0 ok / 1 error;   cfwrite  (R7) -> sector, R7 += 512, same;
  503 f27a:             ;   R6 and TMP are clobbered. const  ACC = 1 when a console byte waits (0 otherwise).
  504 f27a:             ;
  505 f27a:             CFSEL_DATA:  EQU 0
  506 f27a:             CFSEL_FEAT:  EQU 1
  507 f27a:             CFSEL_SCNT:  EQU 2
  508 f27a:             CFSEL_LBA0:  EQU 3
  509 f27a:             CFSEL_LBA1:  EQU 4
  510 f27a:             CFSEL_LBA2:  EQU 5
  511 f27a:             CFSEL_HEAD:  EQU 6
  512 f27a:             CFSEL_CMD:   EQU 7
  513 f27a:             ;
  514 f27a:             ; wait while BSY (bit 7), bounded to 65536 polls; returns the status in ACC
  515 f27a:             cfwait:
  516 f27a: 1e 00 00            MVIW R6,0
  517 f27d:             cfwaitl:
  518 f27d: 78 07               OUTI P8,CFSEL_CMD
  519 f27f: 99                  INP P9
  520 f280: b3 80               ANDI 080H
  521 f282: a1 f2 8e            BRZ cfwaitd
  522 f285: 5e                  DECR R6
  523 f286: 26                  MVRLA R6
  524 f287: a2 f2 7d            BRNZ cfwaitl
  525 f28a: 2e                  MVRHA R6
  526 f28b: a2 f2 7d            BRNZ cfwaitl
  527 f28e:             cfwaitd:
  528 f28e: 78 07               OUTI P8,CFSEL_CMD
  529 f290: 99                  INP P9
  530 f291: 05                  RET
  531 f292:             ;
  532 f292:             ; wait until DRQ (bit 3), bounded; returns the status in ACC
  533 f292:             cfdrq:
  534 f292: 1e 00 00            MVIW R6,0
  535 f295:             cfdrql:
  536 f295: 78 07               OUTI P8,CFSEL_CMD
  537 f297: 99                  INP P9
  538 f298: b3 08               ANDI 008H
  539 f29a: a2 f2 a6            BRNZ cfdrqd
  540 f29d: 5e                  DECR R6
  541 f29e: 26                  MVRLA R6
  542 f29f: a2 f2 95            BRNZ cfdrql
  543 f2a2: 2e                  MVRHA R6
  544 f2a3: a2 f2 95            BRNZ cfdrql
  545 f2a6:             cfdrqd:
  546 f2a6: 78 07               OUTI P8,CFSEL_CMD
  547 f2a8: 99                  INP P9
  548 f2a9: 05                  RET
  549 f2aa:             ;
  550 f2aa:             cfinit:
  551 f2aa: 04 f2 7a            JSR cfwait
  552 f2ad: 78 06               OUTI P8,CFSEL_HEAD
  553 f2af: 79 e0               OUTI P9,0E0H            ; LBA mode, drive 0
  554 f2b1: 78 01               OUTI P8,CFSEL_FEAT
  555 f2b3: 79 01               OUTI P9,001H            ; feature 1: 8-bit transfers
  556 f2b5: 78 07               OUTI P8,CFSEL_CMD
  557 f2b7: 79 ef               OUTI P9,0EFH            ; SET FEATURES
  558 f2b9: 04 f2 7a            JSR cfwait
  559 f2bc: b3 01               ANDI 001H               ; ERR bit; an absent card reads FFh and times out -> 1
  560 f2be: 05                  RET
  561 f2bf:             ;
  562 f2bf:             ; task file <- CFLBA0..2, LBA mode, one sector
  563 f2bf:             cfsetl:
  564 f2bf: 78 03               OUTI P8,CFSEL_LBA0
  565 f2c1: e4 0f 10            LDA CFLBA0
  566 f2c4: 69                  OUTA P9
  567 f2c5: 78 04               OUTI P8,CFSEL_LBA1
  568 f2c7: e4 0f 11            LDA CFLBA1
  569 f2ca: 69                  OUTA P9
  570 f2cb: 78 05               OUTI P8,CFSEL_LBA2
  571 f2cd: e4 0f 12            LDA CFLBA2
  572 f2d0: 69                  OUTA P9
  573 f2d1: 78 06               OUTI P8,CFSEL_HEAD
  574 f2d3: 79 e0               OUTI P9,0E0H
  575 f2d5: 78 02               OUTI P8,CFSEL_SCNT
  576 f2d7: 79 01               OUTI P9,1
  577 f2d9: 05                  RET
  578 f2da:             ;
  579 f2da:             cfread:
  580 f2da: 04 f2 7a            JSR cfwait
  581 f2dd: 04 f2 bf            JSR cfsetl
  582 f2e0: 78 07               OUTI P8,CFSEL_CMD
  583 f2e2: 79 20               OUTI P9,020H            ; READ SECTORS
  584 f2e4: 04 f2 92            JSR cfdrq
  585 f2e7: b3 08               ANDI 008H
  586 f2e9: a1 f3 00            BRZ cferr
  587 f2ec: 78 00               OUTI P8,CFSEL_DATA
  588 f2ee: 1e 02 00            MVIW R6,512
  589 f2f1:             cfrdl:
  590 f2f1: 99                  INP P9
  591 f2f2: 4f                  STAVR R7
  592 f2f3: 57                  INCR R7
  593 f2f4: 5e                  DECR R6
  594 f2f5: 26                  MVRLA R6
  595 f2f6: a2 f2 f1            BRNZ cfrdl
  596 f2f9: 2e                  MVRHA R6
  597 f2fa: a2 f2 f1            BRNZ cfrdl
  598 f2fd: 0e 00               LDAI 0
  599 f2ff: 05                  RET
  600 f300:             cferr:
  601 f300: 0e 01               LDAI 1
  602 f302: 05                  RET
  603 f303:             ;
  604 f303:             cfwrite:
  605 f303: 04 f2 7a            JSR cfwait
  606 f306: 04 f2 bf            JSR cfsetl
  607 f309: 78 07               OUTI P8,CFSEL_CMD
  608 f30b: 79 30               OUTI P9,030H            ; WRITE SECTORS
  609 f30d: 04 f2 92            JSR cfdrq
  610 f310: b3 08               ANDI 008H
  611 f312: a1 f3 00            BRZ cferr
  612 f315: 78 00               OUTI P8,CFSEL_DATA
  613 f317: 1e 02 00            MVIW R6,512
  614 f31a:             cfwrl:
  615 f31a: 47                  LDAVR R7
  616 f31b: 69                  OUTA P9
  617 f31c: 57                  INCR R7
  618 f31d: 5e                  DECR R6
  619 f31e: 26                  MVRLA R6
  620 f31f: a2 f3 1a            BRNZ cfwrl
  621 f322: 2e                  MVRHA R6
  622 f323: a2 f3 1a            BRNZ cfwrl
  623 f326: 04 f2 7a            JSR cfwait
  624 f329: b3 01               ANDI 001H
  625 f32b: 05                  RET
  626 f32c:             ;
  627 f32c:             ; const: ACC = 1 when a console byte is waiting (2026-11-10: a key on the V2.0 card's keyboard counts too). The
  628 f32c:             ; emulator's port-2 console has no status: always ready.
  629 f32c:             const:
  630 f32c: af f3 32            BRDEV consthw
  631 f32f: 0e 01               LDAI 1
  632 f331: 05                  RET
  633 f332:             consthw:
  634 f332: 04 f3 3e            JSR kbst
  635 f335: a2 f3 3d            BRNZ constx
  636 f338: 70 68               OUTI P0,(UARTCS!UARTA5)
  637 f33a: 91                  INP P1
  638 f33b: b3 01               ANDI 001H
  639 f33d: 05          constx: RET
  640 f33e:             ;
  641 f33e:             ; kbst (2026-11-10; the V3 card's ports 2026-11-11): ACC = 1 when the video card's PS/2 keyboard has a byte (IN PE
  642 f33e:             ; bit 0 FULL with bit 1 SRC = 0), else 0; the byte is then IN PF (the card's rule: read it only after FULL showed).
  643 f33e:             ; A byte from the mouse (SRC = 1) is read and dropped: the console is the keyboard's. 0 with no card (VIDPRES = 0).
  644 f33e: e4 0f f0    kbst:   LDA VIDPRES
  645 f341: 0d 01               LDTI 1
  646 f343: aa f3 54            BRNEQ kbst0
  647 f346: 9e                  INP PE
  648 f347: b3 03               ANDI 3
  649 f349: 0d 01               LDTI 1
  650 f34b: a8 f3 56            BREQ kbst1
  651 f34e: 0d 03               LDTI 3
  652 f350: aa f3 54            BRNEQ kbst0
  653 f353: 9f                  INP PF
  654 f354: 0e 00       kbst0:  LDAI 0
  655 f356: 05          kbst1:  RET
  656 f357:             ;
  657 f357:             ; O command: boot. Read the boot block (LBA 0) to OSBASE, check 'P8' and OSCNT, read OSCNT sectors from LBA 1
  658 f357:             ; to OSBASE and call it; the OS returns with RET.
  659 f357:             ;
  660 f357:             ;
  661 f357:             ; ':' - Intel-hex loader (YACC1-D 2026-09-23). A ':' at the prompt starts load mode: the rest of the record is read
  662 f357:             ; without echo (uartinne), its bytes stored from its address on, and the record acknowledged with one character:
  663 f357:             ;   .  stored and the checksum is right
  664 f357:             ;   ?  a bad hex digit or a bad checksum
  665 f357:             ;   !  refused or not verified: an address outside $1000-$DFFF (the monitor's page, the stack and the ROM are
  666 f357:             ;      protected; any write to $E000-$FFFF would reach the 28C64, review M2), or the byte read back differently
  667 f357:             ; Between records everything up to the next ':' is skipped (CR, LF, blanks), so an assembler .img can be pasted into
  668 f357:             ; a terminal or sent as is; ESC (or a NUL, the emulators' end of input) abandons, between records or inside one. The end record (type 01) prints
  669 f357:             ; LOADED, or LOADED WITH ERRORS when any record failed, and returns to the prompt. Records of other types are read
  670 f357:             ; and checked but not stored. Host side: tools/monload.py paces the characters (the UART has no FIFO enabled: one
  671 f357:             ; character of buffering) and waits for each acknowledgement. Registers: R3 checksum, R4 count, R5 type,
  672 f357:             ; R6 record status (0 ok, 1 bad hex, 2 refused/unverified), R7 the address; never R2.
  673 f357:             ;
  674 f357:             hexload:
  675 f357: 0d 05               LDTI  LOADMODE
  676 f359: e7 0f 00            STT   monmode
  677 f35c: 0d 00               LDTI  0
  678 f35e: e7 0f 01            STT   lderr
  679 f361:             ldrec:
  680 f361: 1b 00 00            MVIW  R3,0
  681 f364: 1c 00 00            MVIW  R4,0
  682 f367: 1e 00 00            MVIW  R6,0
  683 f36a: 04 f4 12            JSR   ldbyte            ; byte count
  684 f36d: 34                  MVARL R4
  685 f36e: 04 f4 12            JSR   ldbyte            ; address high
  686 f371: 3f                  MVARH R7
  687 f372: 04 f4 12            JSR   ldbyte            ; address low
  688 f375: 37                  MVARL R7
  689 f376: 04 f4 12            JSR   ldbyte            ; record type
  690 f379: 35                  MVARL R5
  691 f37a:             ldloop:
  692 f37a: 24                  MVRLA R4
  693 f37b: a1 f3 aa            BRZ   ldsum
  694 f37e: 04 f4 12            JSR   ldbyte
  695 f381: 09                  PUSH
  696 f382: 25                  MVRLA R5
  697 f383: a2 f3 a4            BRNZ  ldskip            ; not a data record: check only
  698 f386: 2f                  MVRHA R7                ; protect everything outside $1000-$DFFF
  699 f387: 0d 0f               LDTI  00fh
  700 f389: a9 f3 8f            BRGT  ldlowok
  701 f38c: a0 f3 a1            BR    ldref
  702 f38f:             ldlowok:
  703 f38f: 0d df               LDTI  0dfh
  704 f391: a9 f3 a1            BRGT  ldref
