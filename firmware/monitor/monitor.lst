 1157 f6fc:             ;
 1158 f6fc:             ; vidctl: the video entry at $FFBC (JSR vidctl / RET, below the full vector table), for Y1/OS and programs.
 1159 f6fc:             ; ACC = 0 probe (ACC = VIDPRES), 1 init (V I), 2 clear + home (V C); anything else: ACC = VIDPRES.
 1160 f6fc:             ; A caller checks that $FFBC holds $04 (JSR) first: an older ROM has $FF there. Clobbers R5-R7, TMP.
 1161 f6fc: 0d 01       vidctl: LDTI 1
