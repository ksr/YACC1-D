  987 f5c8: 0d 20               LDTI 020h
  988 f5ca: a7 f5 dd            BRLT vpctl
  989 f5cd: 0d 7f               LDTI 07fh
  990 f5cf: a8 f5 d5            BREQ vpdone
  991 f5d2: 04 f6 28            JSR vpchar
  992 f5d5: 04 f6 ba    vpdone: JSR vcursor
  993 f5d8: 08 70               POPR R7
  994 f5da: 0a                  POP
  995 f5db: 0b                  MVAT
  996 f5dc: 05                  RET
  997 f5dd: 0d 0d       vpctl:  LDTI 0dh
  998 f5df: a8 f6 06            BREQ vpcr
  999 f5e2: 0d 0a               LDTI 0ah
