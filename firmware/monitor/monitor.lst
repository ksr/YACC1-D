 1125 f6e9: b1 20               SUBI 020h
 1126 f6eb: 05          vuppx:  RET
 1127 f6ec:             ;
 1128 f6ec:             ; vcaddr: R7 = VLINE + VCOL, the cursor's address (TMP clobbered)
 1129 f6ec: e6 0f f4    vcaddr: LDT VCOL
 1130 f6ef: f7 0f f6            LDR R7,VLINE
 1131 f6f2:             ; vaddt: R7 += TMP (8 bits). The ADDIC follows the ADDI with only register moves between: the carry is the add's
 1132 f6f2:             ; on the machine and on both emulators (docs/programming/ISA-REFERENCE.md section 6)
 1133 f6f2: 27          vaddt:  MVRLA R7
 1134 f6f3: b8                  ADDT
 1135 f6f4: 37                  MVARL R7
 1136 f6f5: 2f                  MVRHA R7
