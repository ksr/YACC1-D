  473 f275:             
  474 f275:             ;
  475 f275:             ; ---- CompactFlash driver (YACC1-D 2026-09-22) -----------------------------------------------------------
  476 f275:             ; The card sits on two ports: P8 = register-select latch (ATA task-file register 0-7), P9 = data.
  477 f275:             ; 8-bit True IDE mode. Registers: 0 data, 1 error/feature, 2 sector count, 3-5 LBA0-2, 6 drive/head, 7 status/cmd.
  478 f275:             ; Entry points (also BIOS vectors at 0FFECh..): cfinit  ACC = 0 ok / 1 error (absent card times out);
  479 f275:             ;   cfread   sector CFLBA0..2 -> (R7), R7 += 512, ACC = 0 ok / 1 error;   cfwrite  (R7) -> sector, R7 += 512, same;
  480 f275:             ;   R6 and TMP are clobbered. const  ACC = 1 when a console byte waits (0 otherwise).
  481 f275:             ;
  482 f275:             CFSEL_DATA:  EQU 0
  483 f275:             CFSEL_FEAT:  EQU 1
  484 f275:             CFSEL_SCNT:  EQU 2
  485 f275:             CFSEL_LBA0:  EQU 3
  486 f275:             CFSEL_LBA1:  EQU 4
  487 f275:             CFSEL_LBA2:  EQU 5
  488 f275:             CFSEL_HEAD:  EQU 6
  489 f275:             CFSEL_CMD:   EQU 7
  490 f275:             ;
  491 f275:             ; wait while BSY (bit 7), bounded to 65536 polls; returns the status in ACC
  492 f275:             cfwait:
  493 f275: 1e 00 00            MVIW R6,0
  494 f278:             cfwaitl:
  495 f278: 78 07               OUTI P8,CFSEL_CMD
  496 f27a: 99                  INP P9
  497 f27b: b3 80               ANDI 080H
  498 f27d: a1 f2 89            BRZ cfwaitd
  499 f280: 5e                  DECR R6
  500 f281: 26                  MVRLA R6
  501 f282: a2 f2 78            BRNZ cfwaitl
  502 f285: 2e                  MVRHA R6
  503 f286: a2 f2 78            BRNZ cfwaitl
  504 f289:             cfwaitd:
