  477 f27a:             
  478 f27a:             ;
  479 f27a:             ; ---- CompactFlash driver (YACC1-D 2026-09-22) -----------------------------------------------------------
  480 f27a:             ; The card sits on two ports: P4 = register-select latch (ATA task-file register 0-7), P5 = data (on the I/O card v2.0; P8/P9 until 2026-09-23).
  481 f27a:             ; 8-bit True IDE mode. Registers: 0 data, 1 error/feature, 2 sector count, 3-5 LBA0-2, 6 drive/head, 7 status/cmd.
  482 f27a:             ; Entry points (also BIOS vectors at 0FFECh..): cfinit  ACC = 0 ok / 1 error (absent card times out);
  483 f27a:             ;   cfread   sector CFLBA0..2 -> (R7), R7 += 512, ACC = 0 ok / 1 error;   cfwrite  (R7) -> sector, R7 += 512, same;
  484 f27a:             ;   R6 and TMP are clobbered. const  ACC = 1 when a console byte waits (0 otherwise).
  485 f27a:             ;
  486 f27a:             CFSEL_DATA:  EQU 0
  487 f27a:             CFSEL_FEAT:  EQU 1
  488 f27a:             CFSEL_SCNT:  EQU 2
  489 f27a:             CFSEL_LBA0:  EQU 3
  490 f27a:             CFSEL_LBA1:  EQU 4
  491 f27a:             CFSEL_LBA2:  EQU 5
  492 f27a:             CFSEL_HEAD:  EQU 6
  493 f27a:             CFSEL_CMD:   EQU 7
  494 f27a:             ;
  495 f27a:             ; wait while BSY (bit 7), bounded to 65536 polls; returns the status in ACC
  496 f27a:             cfwait:
  497 f27a: 1e 00 00            MVIW R6,0
