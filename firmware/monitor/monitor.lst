  505 f27a:             ;
  506 f27a:             ; ---- CompactFlash driver (YACC1-D 2026-09-22) -----------------------------------------------------------
  507 f27a:             ; The card sits on two ports: P8 = register-select latch (ATA task-file register 0-7), P9 = data.
  508 f27a:             ; 8-bit True IDE mode. Registers: 0 data, 1 error/feature, 2 sector count, 3-5 LBA0-2, 6 drive/head, 7 status/cmd.
  509 f27a:             ; Entry points (also BIOS vectors at 0FFECh..): cfinit  ACC = 0 ok / 1 error (absent card times out);
  510 f27a:             ;   cfread   sector CFLBA0..2 -> (R7), R7 += 512, ACC = 0 ok / 1 error;   cfwrite  (R7) -> sector, R7 += 512, same;
  511 f27a:             ;   R6 and TMP are clobbered. const  ACC = 1 when a console byte waits (0 otherwise).
  512 f27a:             ;
  513 f27a:             CFSEL_DATA:  EQU 0
  514 f27a:             CFSEL_FEAT:  EQU 1
  515 f27a:             CFSEL_SCNT:  EQU 2
  516 f27a:             CFSEL_LBA0:  EQU 3
  517 f27a:             CFSEL_LBA1:  EQU 4
  518 f27a:             CFSEL_LBA2:  EQU 5
  519 f27a:             CFSEL_HEAD:  EQU 6
  520 f27a:             CFSEL_CMD:   EQU 7
  521 f27a:             ;
  522 f27a:             ; wait while BSY (bit 7), bounded to 65536 polls; returns the status in ACC
  523 f27a:             cfwait:
  524 f27a: 1e 00 00            MVIW R6,0
  525 f27d:             cfwaitl:
  526 f27d: 78 07               OUTI P8,CFSEL_CMD
  527 f27f: 99                  INP P9
  528 f280: b3 80               ANDI 080H
  529 f282: a1 f2 8e            BRZ cfwaitd
  530 f285: 5e                  DECR R6
  531 f286: 26                  MVRLA R6
  532 f287: a2 f2 7d            BRNZ cfwaitl
  533 f28a: 2e                  MVRHA R6
  534 f28b: a2 f2 7d            BRNZ cfwaitl
  535 f28e:             cfwaitd:
  536 f28e: 78 07               OUTI P8,CFSEL_CMD
  537 f290: 99                  INP P9
  538 f291: 05                  RET
  539 f292:             ;
  540 f292:             ; wait until DRQ (bit 3), bounded; returns the status in ACC
  541 f292:             cfdrq:
  542 f292: 1e 00 00            MVIW R6,0
  543 f295:             cfdrql:
  544 f295: 78 07               OUTI P8,CFSEL_CMD
  545 f297: 99                  INP P9
  546 f298: b3 08               ANDI 008H
  547 f29a: a2 f2 a6            BRNZ cfdrqd
  548 f29d: 5e                  DECR R6
  549 f29e: 26                  MVRLA R6
  550 f29f: a2 f2 95            BRNZ cfdrql
  551 f2a2: 2e                  MVRHA R6
  552 f2a3: a2 f2 95            BRNZ cfdrql
  553 f2a6:             cfdrqd:
  554 f2a6: 78 07               OUTI P8,CFSEL_CMD
  555 f2a8: 99                  INP P9
  556 f2a9: 05                  RET
  557 f2aa:             ;
  558 f2aa:             cfinit:
  559 f2aa: 04 f2 7a            JSR cfwait
  560 f2ad: 78 06               OUTI P8,CFSEL_HEAD
  561 f2af: 79 e0               OUTI P9,0E0H            ; LBA mode, drive 0
  562 f2b1: 78 01               OUTI P8,CFSEL_FEAT
  563 f2b3: 79 01               OUTI P9,001H            ; feature 1: 8-bit transfers
  564 f2b5: 78 07               OUTI P8,CFSEL_CMD
  565 f2b7: 79 ef               OUTI P9,0EFH            ; SET FEATURES
  566 f2b9: 04 f2 7a            JSR cfwait
  567 f2bc: b3 01               ANDI 001H               ; ERR bit; an absent card reads FFh and times out -> 1
  568 f2be: 05                  RET
  569 f2bf:             ;
  570 f2bf:             ; task file <- CFLBA0..2, LBA mode, one sector
  571 f2bf:             cfsetl:
  572 f2bf: 78 03               OUTI P8,CFSEL_LBA0
  573 f2c1: e4 0f 10            LDA CFLBA0
  574 f2c4: 69                  OUTA P9
  575 f2c5: 78 04               OUTI P8,CFSEL_LBA1
  576 f2c7: e4 0f 11            LDA CFLBA1
  577 f2ca: 69                  OUTA P9
  578 f2cb: 78 05               OUTI P8,CFSEL_LBA2
  579 f2cd: e4 0f 12            LDA CFLBA2
  580 f2d0: 69                  OUTA P9
  581 f2d1: 78 06               OUTI P8,CFSEL_HEAD
  582 f2d3: 79 e0               OUTI P9,0E0H
  583 f2d5: 78 02               OUTI P8,CFSEL_SCNT
  584 f2d7: 79 01               OUTI P9,1
  585 f2d9: 05                  RET
  586 f2da:             ;
  587 f2da:             cfread:
