  683 f357: 1b 00 00            MVIW  R3,0
  684 f35a: 1c 00 00            MVIW  R4,0
  685 f35d: 1e 00 00            MVIW  R6,0
  686 f360: 04 f4 08            JSR   ldbyte            ; byte count
  687 f363: 34                  MVARL R4
  688 f364: 04 f4 08            JSR   ldbyte            ; address high
  689 f367: 3f                  MVARH R7
  690 f368: 04 f4 08            JSR   ldbyte            ; address low
  691 f36b: 37                  MVARL R7
  692 f36c: 04 f4 08            JSR   ldbyte            ; record type
  693 f36f: 35                  MVARL R5
