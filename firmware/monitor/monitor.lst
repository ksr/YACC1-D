 1421 f8bc:             ;
 1422 f8bc:             ; the CRTC registers R0..R15 for vinit, as measured on the card 2026-10-21: an 11.0592 MHz crystal (Q2, SV4 on 1-2),
 1423 f8bc:             ; 6 dots a character (IC28 a 74163), 8 scan lines a row (RA0..2): a 1.8432 MHz character clock, 117 characters a line
 1424 f8bc:             ; = 63.5 us (15.75 kHz), 32 rows + 6 lines = 262 lines (60.1 Hz), non-interlaced - a TV-rate monitor. 80 columns
 1425 f8bc:             ; (43.4 us of text) fit such a monitor's visible ~48 us with a margin each side (R2 94 centres them); a 9 MHz crystal
 1426 f8bc:             ; gave room for only 64. The character EPROM gets ~540 ns a character (an MBM2732A is a 450 ns part). R1/R6 follow
 1427 f8bc:             ; VROWS; tools/vidsim.py timing checks a table.
 1428 f8bc:             ; 2026-10-22: R0..R3 per card (vmode picks one, R6), R4..R15 common. A V1.3 card runs from 12 MHz: 6 dots a 2.0 MHz
 1429 f8bc:             ; character, 127 a line (15.75 kHz), 80 x 24 (40 us of text, R2 98 centres it); 8 dots a 1.5 MHz character, 95 a line
 1430 f8bc:             ; (15.79 kHz), 64 x 24 - the 64-column table proven on the monitor 2026-10-21 (then from 9 MHz / 6, the same 1.5 MHz).
 1431 f8bc:             ; 2026-11-10 (branch video-v2): the V2.0 card, 12 MHz like the V1.3; the V1.0-V1.2 table (11.0592 MHz: 116, 80, 94, 9)
 1432 f8bc:             ; is gone with the card.
 1433 f8bc: 7e 50 62 0a vcr80:  DB 126,80,98,10   ; DOTS open: 6 dots, 80 x 24 (R0 total-1, R1 displayed, R2 sync position, R3 sync width) ;;V2
 1434 f8c0: 5e 40 4b 08 vcr64:  DB 94,64,75,8     ; DOTS fitted: 8 dots, 64 x 24 ;;V2
 1435 f8c4: 1f          vcrtab: DB 31             ; R4  vertical total - 1 (rows) ;;V2
 1436 f8c5: 06                  DB 6              ; R5  vertical total adjust (scan lines) ;;V2
 1437 f8c6: 18                  DB VROWS          ; R6  rows displayed ;;V2
 1438 f8c7: 1b                  DB 27             ; R7  vertical sync position (row) ;;V2
 1439 f8c8: 00                  DB 0              ; R8  interlace mode: off ;;V2
 1440 f8c9: 07                  DB 7              ; R9  scan lines per row - 1 ;;V2
 1441 f8ca: 67                  DB 067h           ; R10 cursor start line 7, blinking (1/16 field rate) ;;V2
 1442 f8cb: 07                  DB 7              ; R11 cursor end line 7 ;;V2
 1443 f8cc: 00                  DB 0              ; R12 start address high ;;V2
 1444 f8cd: 00                  DB 0              ; R13 start address low ;;V2
 1445 f8ce: 00                  DB 0              ; R14 cursor address high ;;V2
 1446 f8cf: 00                  DB 0              ; R15 cursor address low ;;V2
 1447 f8d0:             ;;V4 ; V4 (docs/cards/video-v4.md section 3): 640 x 480 at 60 Hz with the text in a band of 400 lines. A count is 16
 1448 f8d0:             ;;V4 ; dots of the 25.175 MHz oscillator, 635.6 ns: 50 counts a line (31.469 kHz), 32 rows of 16 lines and 13 lines (525
 1449 f8d0:             ;;V4 ; lines, 59.94 Hz); both syncs negative, which is control 2 = 0. tools/vidsim.py timing --card v4 checks the table.
 1450 f8d0:             ;;V4 vcrtab: DB 49             ; R0  counts a line - 1
 1451 f8d0:             ;;V4         DB 40             ; R1  counts shown: 80 characters
 1452 f8d0:             ;;V4         DB 42             ; R2  the horizontal sync from count 42
 1453 f8d0:             ;;V4         DB 026h           ; R3  the horizontal sync 6 counts (96 dots); the vertical 2 lines on Hitachi's S type
 1454 f8d0:             ;;V4         DB 31             ; R4  vertical total - 1 (rows)
 1455 f8d0:             ;;V4         DB 13             ; R5  vertical total adjust (scan lines)
 1456 f8d0:             ;;V4         DB VROWS          ; R6  rows displayed
 1457 f8d0:             ;;V4         DB 28             ; R7  vertical sync position (row): line 448
 1458 f8d0:             ;;V4         DB 0              ; R8  interlace mode: off
 1459 f8d0:             ;;V4         DB 15             ; R9  scan lines per row - 1
 1460 f8d0:             ;;V4         DB 06eh           ; R10 cursor start line 14, blinking (1/32 field rate)
 1461 f8d0:             ;;V4         DB 15             ; R11 cursor end line 15
 1462 f8d0:             ;;V4         DB 0              ; R12 start address high (in counts)
 1463 f8d0:             ;;V4         DB 0              ; R13 start address low
 1464 f8d0:             ;;V4         DB 0              ; R14 cursor address high
 1465 f8d0:             ;;V4         DB 0              ; R15 cursor address low
