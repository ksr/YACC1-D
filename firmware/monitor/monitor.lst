  784 f427: a7 f4 32            BRLT  ldhexbad
  785 f42a: 0d 46               LDTI  'F'
  786 f42c: a9 f4 32            BRGT  ldhexbad
  787 f42f: b1 37               SUBI  037h
  788 f431: 05                  RET
  789 f432:             ldhexbad:
