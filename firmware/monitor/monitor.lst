 1260 f7fb: 04 f6 f2            JSR vaddt
 1261 f7fe: 0a                  POP
 1262 f7ff: b1 01               SUBI 1
 1263 f801: a0 f7 f4            BR vcwrl
 1264 f804: e6 0f f5    vcwrc:  LDT VCHAR
 1265 f807: 04 f6 f2            JSR vaddt
