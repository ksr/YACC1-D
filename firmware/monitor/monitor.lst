 1126 f6ba:             ;
 1127 f6ba:             ; vcursor: with VIDCUR set, the CRTC's cursor registers R14/R15 <- the cursor's offset from VIDRAM (R7 clobbered)
 1128 f6ba:             vcursor:
 1129 f6ba: e4 0f f2            LDA VIDCUR
 1130 f6bd: a1 f6 ea            BRZ vcurx
 1131 f6c0: 04 f6 ac            JSR vcaddr
 1132 f6c3:             ; V4: the 6845 counts pairs of characters. R14/R15 = the cursor's offset from VIDRAM halved (the start address is
 1133 f6c3:             ; 0), and the offset's bit 0 is CURH, control 2's bit 1: the cursor on the right-hand character of its count
 1134 f6c3: 0e 0e               LDAI 14
 1135 f6c5: 6a                  OUTA PA
 1136 f6c6: 2f                  MVRHA R7
 1137 f6c7: b1 d0               SUBI (VIDRAM).1         ; the offset's high byte, 0..7
 1138 f6c9: b7                  SHR
 1139 f6ca: 6b                  OUTA PB
 1140 f6cb: 0e 0f               LDAI 15
 1141 f6cd: 6a                  OUTA PA
 1142 f6ce: 2f                  MVRHA R7                ; its bit 0 ((VIDRAM).1 is even) is bit 7 of the halved low byte
 1143 f6cf: b3 01               ANDI 1
 1144 f6d1: a1 f6 d6            BRZ vcur1
 1145 f6d4: 0e 80               LDAI 080h
 1146 f6d6: 0b          vcur1:  MVAT
 1147 f6d7: 27                  MVRLA R7
 1148 f6d8: b7                  SHR
 1149 f6d9: ba                  ORT
 1150 f6da: 6b                  OUTA PB
