 1062 f670: 1f d0 00            MVIW R7,VIDRAM
 1063 f673: 0e f0               LDAI 240                ; 80*(VROWS-1)/8
 1064 f675: 35                  MVARL R5
 1065 f676: 46          vscrl:  LDAVR R6
 1066 f677: 4f                  STAVR R7
 1067 f678: 56                  INCR R6
 1068 f679: 57                  INCR R7
 1069 f67a: 46                  LDAVR R6
 1070 f67b: 4f                  STAVR R7
 1071 f67c: 56                  INCR R6
 1072 f67d: 57                  INCR R7
