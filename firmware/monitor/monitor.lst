 1111 f6d6: 35                  MVARL R5
 1112 f6d7: d7 20       vscrb:  LDIVR R7,' '
 1113 f6d9: 57                  INCR R7
 1114 f6da: 5d                  DECR R5
 1115 f6db: 25                  MVRLA R5
 1116 f6dc: a2 f6 d7            BRNZ vscrb
