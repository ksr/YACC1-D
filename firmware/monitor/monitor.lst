 1094 f693: 4f                  STAVR R7
 1095 f694: 56                  INCR R6
 1096 f695: 57                  INCR R7
 1097 f696: 5d                  DECR R5
 1098 f697: 25                  MVRLA R5
 1099 f698: a2 f6 76            BRNZ vscrl
 1100 f69b: e4 0f f8            LDA VCOLSV
 1101 f69e: 35                  MVARL R5
 1102 f69f: d7 20       vscrb:  LDIVR R7,' '
 1103 f6a1: 57                  INCR R7
 1104 f6a2: 5d                  DECR R5
