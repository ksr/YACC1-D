  495 f26a:             ;
  496 f26a:             ; YACC1-D 2026-09-22: was BRVR R7, which is an INDIRECT jump (PC <- the word AT the address, see the
  497 f26a:             ; microcode: branch() fetches the target through R7 like BR fetches its operand through the PC), so G jumped
  498 f26a:             ; through whatever was stored at AAAA. JSRUR R7 jumps TO AAAA and pushes a return address: the program ends
  499 f26a:             ; with RET and lands back in the command loop.
  500 f26a:             ;
  501 f26a: 06 07             JSRUR R7
  502 f26c: a0 f0 6a          BR cmdloop
