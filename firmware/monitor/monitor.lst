  727 f3bf: 04 fa 26            JSR   uartinne          ; skip to the next ':'
  728 f3c2: a1 f3 ea            BRZ   ldabort
  729 f3c5: 0d 3a               LDTI  ':'
  730 f3c7: a8 f3 42            BREQ  ldrec
  731 f3ca: 0d 1b               LDTI  01bh
  732 f3cc: a8 f3 ea            BREQ  ldabort
  733 f3cf: a0 f3 bf            BR    ldwait
  734 f3d2:             ldeof:
  735 f3d2: e4 0f 01            LDA   lderr
  736 f3d5: a2 f3 e1            BRNZ  ldeofbad
  737 f3d8: 1f f4 3e            MVIW  R7,MSGLOADED
  738 f3db: 04 f9 d2            JSR   stringout
  739 f3de: a0 f0 6a            BR    cmdloop
