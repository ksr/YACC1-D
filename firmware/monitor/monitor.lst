 1207 f740: a8 f8 2b            BREQ vcdump
 1208 f743: 0d 52               LDTI 'R'
 1209 f745: a8 f8 75            BREQ vcreg
 1210 f748: 1f fe ba            MVIW R7,VHELP
 1211 f74b: a0 f7 8c            BR vcmsg
 1212 f74e: 04 f5 46    vcprob: JSR vprobe
 1213 f751: a0 f7 68            BR vcstat
 1214 f754: 04 f5 65    vcinit: JSR vinit
