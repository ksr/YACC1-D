 1012 f603: a0 f5 d5            BR vpdone
 1013 f606: 0e 00       vpcr:   LDAI 0
 1014 f608: e5 0f f4            STA VCOL
 1015 f60b: a0 f5 d5            BR vpdone
 1016 f60e: 04 f6 40    vplf:   JSR vlf
