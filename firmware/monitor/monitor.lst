  984 f5d7: 6b                  OUTA PB
  985 f5d8: e4 0f f6            LDA VYTOP
  986 f5db: 6b                  OUTA PB
  987 f5dc: e4 0f f7            LDA VYTOPL
  988 f5df: 6b                  OUTA PB
  989 f5e0: 05                  RET
  990 f5e1:             ;
  991 f5e1:             ; vdn16: VYTOP 16 lines down, the next row's top line (R7 clobbered; no borrow to carry between the emulators)
