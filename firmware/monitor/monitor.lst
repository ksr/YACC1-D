  475 f26a:             ;
  476 f26a:             ; YACC1-D 2026-09-22: was BRVR R7, which is an INDIRECT jump (PC <- the word AT the address, see the
  477 f26a:             ; microcode: branch() fetches the target through R7 like BR fetches its operand through the PC), so G jumped
  478 f26a:             ; through whatever was stored at AAAA. JSRUR R7 jumps TO AAAA and pushes a return address: the program ends
  479 f26a:             ; with RET and lands back in the command loop.
  480 f26a:             ;
  481 f26a: 06 07             JSRUR R7
  482 f26c: a0 f0 6a          BR cmdloop
  483 f26f:             
  484 f26f:             dumpreg:
  485 f26f: 04 f9 0e          JSR showregs
  486 f272:             ;      MVIB R6,NOMODE
  487 f272: 0d 00             LDTI NOMODE
  488 f274: e7 0f 00          STT monmode
  489 f277:             
  490 f277: a0 f0 6a          BR cmdloop
  491 f27a:             
  492 f27a:             ;
  493 f27a:             ; ---- CompactFlash driver (YACC1-D 2026-09-22) -----------------------------------------------------------
  494 f27a:             ; The card sits on two ports: P8 = register-select latch (ATA task-file register 0-7), P9 = data.
  495 f27a:             ; 8-bit True IDE mode. Registers: 0 data, 1 error/feature, 2 sector count, 3-5 LBA0-2, 6 drive/head, 7 status/cmd.
  496 f27a:             ; Entry points (also BIOS vectors at 0FFECh..): cfinit  ACC = 0 ok / 1 error (absent card times out);
  497 f27a:             ;   cfread   sector CFLBA0..2 -> (R7), R7 += 512, ACC = 0 ok / 1 error;   cfwrite  (R7) -> sector, R7 += 512, same;
  498 f27a:             ;   R6 and TMP are clobbered. const  ACC = 1 when a console byte waits (0 otherwise).
  499 f27a:             ;
  500 f27a:             CFSEL_DATA:  EQU 0
  501 f27a:             CFSEL_FEAT:  EQU 1
  502 f27a:             CFSEL_SCNT:  EQU 2
  503 f27a:             CFSEL_LBA0:  EQU 3
  504 f27a:             CFSEL_LBA1:  EQU 4
  505 f27a:             CFSEL_LBA2:  EQU 5
  506 f27a:             CFSEL_HEAD:  EQU 6
  507 f27a:             CFSEL_CMD:   EQU 7
  508 f27a:             ;
  509 f27a:             ; wait while BSY (bit 7), bounded to 65536 polls; returns the status in ACC
  510 f27a:             cfwait:
  511 f27a: 1e 00 00            MVIW R6,0
  512 f27d:             cfwaitl:
  513 f27d: 78 07               OUTI P8,CFSEL_CMD
  514 f27f: 99                  INP P9
  515 f280: b3 80               ANDI 080H
  516 f282: a1 f2 8e            BRZ cfwaitd
  517 f285: 5e                  DECR R6
  518 f286: 26                  MVRLA R6
  519 f287: a2 f2 7d            BRNZ cfwaitl
  520 f28a: 2e                  MVRHA R6
  521 f28b: a2 f2 7d            BRNZ cfwaitl
  522 f28e:             cfwaitd:
  523 f28e: 78 07               OUTI P8,CFSEL_CMD
  524 f290: 99                  INP P9
  525 f291: 05                  RET
  526 f292:             ;
  527 f292:             ; wait until DRQ (bit 3), bounded; returns the status in ACC
  528 f292:             cfdrq:
  529 f292: 1e 00 00            MVIW R6,0
  530 f295:             cfdrql:
  531 f295: 78 07               OUTI P8,CFSEL_CMD
  532 f297: 99                  INP P9
  533 f298: b3 08               ANDI 008H
  534 f29a: a2 f2 a6            BRNZ cfdrqd
  535 f29d: 5e                  DECR R6
  536 f29e: 26                  MVRLA R6
  537 f29f: a2 f2 95            BRNZ cfdrql
  538 f2a2: 2e                  MVRHA R6
  539 f2a3: a2 f2 95            BRNZ cfdrql
  540 f2a6:             cfdrqd:
  541 f2a6: 78 07               OUTI P8,CFSEL_CMD
  542 f2a8: 99                  INP P9
  543 f2a9: 05                  RET
  544 f2aa:             ;
  545 f2aa:             cfinit:
  546 f2aa: 04 f2 7a            JSR cfwait
  547 f2ad: 78 06               OUTI P8,CFSEL_HEAD
  548 f2af: 79 e0               OUTI P9,0E0H            ; LBA mode, drive 0
  549 f2b1: 78 01               OUTI P8,CFSEL_FEAT
  550 f2b3: 79 01               OUTI P9,001H            ; feature 1: 8-bit transfers
  551 f2b5: 78 07               OUTI P8,CFSEL_CMD
  552 f2b7: 79 ef               OUTI P9,0EFH            ; SET FEATURES
  553 f2b9: 04 f2 7a            JSR cfwait
  554 f2bc: b3 01               ANDI 001H               ; ERR bit; an absent card reads FFh and times out -> 1
  555 f2be: 05                  RET
  556 f2bf:             ;
  557 f2bf:             ; task file <- CFLBA0..2, LBA mode, one sector
  558 f2bf:             cfsetl:
  559 f2bf: 78 03               OUTI P8,CFSEL_LBA0
  560 f2c1: e4 0f 10            LDA CFLBA0
  561 f2c4: 69                  OUTA P9
  562 f2c5: 78 04               OUTI P8,CFSEL_LBA1
  563 f2c7: e4 0f 11            LDA CFLBA1
  564 f2ca: 69                  OUTA P9
  565 f2cb: 78 05               OUTI P8,CFSEL_LBA2
  566 f2cd: e4 0f 12            LDA CFLBA2
  567 f2d0: 69                  OUTA P9
  568 f2d1: 78 06               OUTI P8,CFSEL_HEAD
  569 f2d3: 79 e0               OUTI P9,0E0H
  570 f2d5: 78 02               OUTI P8,CFSEL_SCNT
  571 f2d7: 79 01               OUTI P9,1
  572 f2d9: 05                  RET
  573 f2da:             ;
  574 f2da:             cfread:
  575 f2da: 04 f2 7a            JSR cfwait
  576 f2dd: 04 f2 bf            JSR cfsetl
  577 f2e0: 78 07               OUTI P8,CFSEL_CMD
  578 f2e2: 79 20               OUTI P9,020H            ; READ SECTORS
  579 f2e4: 04 f2 92            JSR cfdrq
  580 f2e7: b3 08               ANDI 008H
  581 f2e9: a1 f3 00            BRZ cferr
  582 f2ec: 78 00               OUTI P8,CFSEL_DATA
  583 f2ee: 1e 02 00            MVIW R6,512
  584 f2f1:             cfrdl:
  585 f2f1: 99                  INP P9
  586 f2f2: 4f                  STAVR R7
  587 f2f3: 57                  INCR R7
  588 f2f4: 5e                  DECR R6
  589 f2f5: 26                  MVRLA R6
  590 f2f6: a2 f2 f1            BRNZ cfrdl
  591 f2f9: 2e                  MVRHA R6
  592 f2fa: a2 f2 f1            BRNZ cfrdl
  593 f2fd: 0e 00               LDAI 0
  594 f2ff: 05                  RET
  595 f300:             cferr:
  596 f300: 0e 01               LDAI 1
  597 f302: 05                  RET
  598 f303:             ;
  599 f303:             cfwrite:
  600 f303: 04 f2 7a            JSR cfwait
  601 f306: 04 f2 bf            JSR cfsetl
  602 f309: 78 07               OUTI P8,CFSEL_CMD
  603 f30b: 79 30               OUTI P9,030H            ; WRITE SECTORS
  604 f30d: 04 f2 92            JSR cfdrq
  605 f310: b3 08               ANDI 008H
  606 f312: a1 f3 00            BRZ cferr
  607 f315: 78 00               OUTI P8,CFSEL_DATA
  608 f317: 1e 02 00            MVIW R6,512
  609 f31a:             cfwrl:
  610 f31a: 47                  LDAVR R7
  611 f31b: 69                  OUTA P9
  612 f31c: 57                  INCR R7
  613 f31d: 5e                  DECR R6
  614 f31e: 26                  MVRLA R6
  615 f31f: a2 f3 1a            BRNZ cfwrl
  616 f322: 2e                  MVRHA R6
  617 f323: a2 f3 1a            BRNZ cfwrl
  618 f326: 04 f2 7a            JSR cfwait
  619 f329: b3 01               ANDI 001H
  620 f32b: 05                  RET
  621 f32c:             ;
  622 f32c:             ; const: ACC = 1 when a console byte is waiting. The emulator's port-2 console has no status: always ready.
  623 f32c:             const:
  624 f32c: af f3 32            BRDEV consthw
  625 f32f: 0e 01               LDAI 1
  626 f331: 05                  RET
  627 f332:             consthw:
  628 f332: 70 68               OUTI P0,(UARTCS!UARTA5)
  629 f334: 91                  INP P1
  630 f335: b3 01               ANDI 001H
  631 f337: 05                  RET
  632 f338:             ;
  633 f338:             ; O command: boot. Read the boot block (LBA 0) to OSBASE, check 'P8' and OSCNT, read OSCNT sectors from LBA 1
  634 f338:             ; to OSBASE and call it; the OS returns with RET.
  635 f338:             ;
  636 f338:             ;
  637 f338:             ; ':' - Intel-hex loader (YACC1-D 2026-09-23). A ':' at the prompt starts load mode: the rest of the record is read
  638 f338:             ; without echo (uartinne), its bytes stored from its address on, and the record acknowledged with one character:
  639 f338:             ;   .  stored and the checksum is right
  640 f338:             ;   ?  a bad hex digit or a bad checksum
  641 f338:             ;   !  refused or not verified: an address outside $1000-$DFFF (the monitor's page, the stack and the ROM are
  642 f338:             ;      protected; any write to $E000-$FFFF would reach the 28C64, review M2), or the byte read back differently
  643 f338:             ; Between records everything up to the next ':' is skipped (CR, LF, blanks), so an assembler .img can be pasted into
  644 f338:             ; a terminal or sent as is; ESC (or a NUL, the emulators' end of input) abandons, between records or inside one. The end record (type 01) prints
  645 f338:             ; LOADED, or LOADED WITH ERRORS when any record failed, and returns to the prompt. Records of other types are read
  646 f338:             ; and checked but not stored. Host side: tools/monload.py paces the characters (the UART has no FIFO enabled: one
  647 f338:             ; character of buffering) and waits for each acknowledgement. Registers: R3 checksum, R4 count, R5 type,
  648 f338:             ; R6 record status (0 ok, 1 bad hex, 2 refused/unverified), R7 the address; never R2.
  649 f338:             ;
  650 f338:             hexload:
  651 f338: 0d 05               LDTI  LOADMODE
  652 f33a: e7 0f 00            STT   monmode
  653 f33d: 0d 00               LDTI  0
  654 f33f: e7 0f 01            STT   lderr
  655 f342:             ldrec:
  656 f342: 1b 00 00            MVIW  R3,0
  657 f345: 1c 00 00            MVIW  R4,0
  658 f348: 1e 00 00            MVIW  R6,0
  659 f34b: 04 f3 f3            JSR   ldbyte            ; byte count
  660 f34e: 34                  MVARL R4
  661 f34f: 04 f3 f3            JSR   ldbyte            ; address high
  662 f352: 3f                  MVARH R7
  663 f353: 04 f3 f3            JSR   ldbyte            ; address low
  664 f356: 37                  MVARL R7
  665 f357: 04 f3 f3            JSR   ldbyte            ; record type
  666 f35a: 35                  MVARL R5
  667 f35b:             ldloop:
  668 f35b: 24                  MVRLA R4
  669 f35c: a1 f3 8b            BRZ   ldsum
  670 f35f: 04 f3 f3            JSR   ldbyte
  671 f362: 09                  PUSH
  672 f363: 25                  MVRLA R5
  673 f364: a2 f3 85            BRNZ  ldskip            ; not a data record: check only
  674 f367: 2f                  MVRHA R7                ; protect everything outside $1000-$DFFF
  675 f368: 0d 0f               LDTI  00fh
  676 f36a: a9 f3 70            BRGT  ldlowok
  677 f36d: a0 f3 82            BR    ldref
  678 f370:             ldlowok:
  679 f370: 0d df               LDTI  0dfh
  680 f372: a9 f3 82            BRGT  ldref
  681 f375: 0a                  POP
  682 f376: 4f                  STAVR R7
  683 f377: 0b                  MVAT
  684 f378: 47                  LDAVR R7                ; read it back
  685 f379: a8 f3 86            BREQ  ldnext
  686 f37c: 1e 00 02            MVIW  R6,2
  687 f37f: a0 f3 86            BR    ldnext
  688 f382:             ldref:
  689 f382: 1e 00 02            MVIW  R6,2
  690 f385:             ldskip:
  691 f385: 0a                  POP
  692 f386:             ldnext:
  693 f386: 57                  INCR  R7
  694 f387: 5c                  DECR  R4
  695 f388: a0 f3 5b            BR    ldloop
  696 f38b:             ldsum:
  697 f38b: 04 f3 f3            JSR   ldbyte            ; the checksum: the record's bytes now sum to zero
  698 f38e: 26                  MVRLA R6
  699 f38f: 0d 01               LDTI  1
  700 f391: a8 f3 aa            BREQ  ldbadrec
  701 f394: 23                  MVRLA R3
  702 f395: a2 f3 aa            BRNZ  ldbadrec
  703 f398: 26                  MVRLA R6
  704 f399: a2 f3 af            BRNZ  ldrefrec
  705 f39c: 25                  MVRLA R5
  706 f39d: 0d 01               LDTI  1
  707 f39f: a8 f3 d2            BREQ  ldeof
  708 f3a2: 0e 2e               LDAI  '.'
  709 f3a4: 04 f9 e0            JSR   uartout
  710 f3a7: a0 f3 bf            BR    ldwait
  711 f3aa:             ldbadrec:
  712 f3aa: 0e 3f               LDAI  '?'
  713 f3ac: a0 f3 b1            BR    ldflag
  714 f3af:             ldrefrec:
  715 f3af: 0e 21               LDAI  '!'
  716 f3b1:             ldflag:
  717 f3b1: 04 f9 e0            JSR   uartout
  718 f3b4: 0d 01               LDTI  1
  719 f3b6: e7 0f 01            STT   lderr
  720 f3b9: 25                  MVRLA R5
  721 f3ba: 0d 01               LDTI  1
  722 f3bc: a8 f3 d2            BREQ  ldeof
  723 f3bf:             ldwait:
  724 f3bf: 04 fa 26            JSR   uartinne          ; skip to the next ':'
  725 f3c2: a1 f3 ea            BRZ   ldabort
  726 f3c5: 0d 3a               LDTI  ':'
  727 f3c7: a8 f3 42            BREQ  ldrec
  728 f3ca: 0d 1b               LDTI  01bh
  729 f3cc: a8 f3 ea            BREQ  ldabort
  730 f3cf: a0 f3 bf            BR    ldwait
  731 f3d2:             ldeof:
  732 f3d2: e4 0f 01            LDA   lderr
  733 f3d5: a2 f3 e1            BRNZ  ldeofbad
  734 f3d8: 1f f4 3e            MVIW  R7,MSGLOADED
  735 f3db: 04 f9 d2            JSR   stringout
  736 f3de: a0 f0 6a            BR    cmdloop
  737 f3e1:             ldeofbad:
  738 f3e1: 1f f4 49            MVIW  R7,MSGLOADERR
  739 f3e4: 04 f9 d2            JSR   stringout
  740 f3e7: a0 f0 6a            BR    cmdloop
  741 f3ea:             ldabort:
  742 f3ea: 1f f4 60            MVIW  R7,MSGLOADAB
  743 f3ed: 04 f9 d2            JSR   stringout
  744 f3f0: a0 f0 6a            BR    cmdloop
  745 f3f3:             ;
  746 f3f3:             ; ldbyte: two hex digits (no echo) -> ACC, added into the checksum R3; a bad digit sets R6 = 1 and gives 0
  747 f3f3:             ;
  748 f3f3:             ldbyte:
  749 f3f3: 04 f4 0a            JSR   ldhex
  750 f3f6: b6                  SHL
  751 f3f7: b6                  SHL
  752 f3f8: b6                  SHL
  753 f3f9: b6                  SHL
  754 f3fa: b3 f0               ANDI  0f0h
  755 f3fc: 09                  PUSH
  756 f3fd: 04 f4 0a            JSR   ldhex
  757 f400: 0b                  MVAT
  758 f401: 0a                  POP
  759 f402: ba                  ORT
  760 f403: 09                  PUSH
  761 f404: 0b                  MVAT
  762 f405: 23                  MVRLA R3
  763 f406: b8                  ADDT
  764 f407: 33                  MVARL R3
  765 f408: 0a                  POP
  766 f409: 05                  RET
  767 f40a:             ;
  768 f40a:             ; ldhex: one hex digit (no echo) -> ACC 0..15; anything else sets R6 = 1 and gives 0
  769 f40a:             ;
  770 f40a:             ldhex:
  771 f40a: 04 fa 26            JSR   uartinne
  772 f40d: a1 f4 38            BRZ   ldhexab           ; NUL (the emulators' end of input) or ESC abandon, even inside a record
  773 f410: 0d 1b               LDTI  01bh
  774 f412: a8 f4 38            BREQ  ldhexab
  775 f415: 04 f8 bd            JSR   toupper
  776 f418: 0d 30               LDTI  '0'
