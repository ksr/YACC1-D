            20 43 41 52 
            44 0a 0d 00 MSGNOOS: DB "NO OS ON THE CARD",0ah,0dh,0
  881 f524:             ;
  882 f524:             ; ---- Video card driver (YACC1-D 2026-09-25) --------------------------------------------------------------------
  883 f524:             ; The screen is VCOLSV x VROWS bytes from VIDRAM, row after row; a byte's bits 0-5 pick one of the 64 glyphs of the
  884 f524:             ; character EPROM (the card latches VDATA0..5 only), bit 7 is inverse video, bit 6 is unused. The driver stores
  885 f524:             ; ASCII with $60-$7F moved to $40-$5F (upper case), so a 2513-style set (code = ASCII bits 0-5) shows the text as sent. Cursor: VROW/VCOL, VLINE =
  886 f524:             ; the address of the row. vputc handles CR (column 0), LF (column 0 of the next row: Y1/OS ends lines with LF
  887 f524:             ; alone), BS (one left, no erase), TAB (spaces to the next multiple of 8), FF (clear + home); other control bytes and
  888 f524:             ; DEL are ignored; a character in the last column wraps; LF on the last row scrolls (the whole screen moves up one
  889 f524:             ; row, the last row is blanked). Only instructions of the 2021 set: no LDZ/STZ/ADDIW/SHL16/BRUR, no R2.
  890 f524:             ;
  891 f524:             ; vidreset: at reset. Mirroring and the CRTC cursor off, cursor home, probe; with VIDAUTO also V I + mirroring on.
  892 f524:             vidreset:
  893 f524: 0e 00               LDAI 0
  894 f526: e5 0f f1            STA VIDMIR
  895 f529: e5 0f f2            STA VIDCUR
  896 f52c: 04 f5 ac            JSR vhome
  897 f52f: 04 f5 46            JSR vprobe
  898 f532: 0e 00               LDAI VIDAUTO
  899 f534: a1 f5 45            BRZ vidrx
  900 f537: e4 0f f0            LDA VIDPRES
  901 f53a: a1 f5 45            BRZ vidrx
  902 f53d: 04 f5 86            JSR vinit
  903 f540: 0e 01               LDAI 1
  904 f542: e5 0f f1            STA VIDMIR
  905 f545: 05          vidrx:  RET
  906 f546:             ;
  907 f546:             ; vprobe: VIDPRES (and ACC) = 1 when IN PC (the V2.0 card's status) reads $5x, the card ID in bits 7..4, else 0
  908 f546:             ; (2026-11-10; the V1 cards' probe wrote $55/$AA at VIDRAM). With no card the port is not decoded and reads the
  909 f546:             ; floating bus: $FF on the pull-ups, or the INP's own opcode $9C - neither is $5x.
  910 f546: 9c          vprobe: INP PC
  911 f547: b3 f0               ANDI 0f0h
  912 f549: 0d 50               LDTI 050h                      ;;V2
  913 f54b:             ;;V4         LDTI 070h
  914 f54b: aa f5 53            BRNEQ vprno
  915 f54e: 0e 01               LDAI 1
  916 f550: a0 f5 55            BR vprset
  917 f553: 0e 00       vprno:  LDAI 0
  918 f555: e5 0f f0    vprset: STA VIDPRES
  919 f558: 04 f5 5f            JSR vmode
  920 f55b: e4 0f f0            LDA VIDPRES
  921 f55e: 05                  RET
  922 f55f:             ;
  923 f55f:             ; vmode (2026-10-22; 2026-11-10 the V2.0 card): the geometry from the DOTS jumper, IN PC bit 0 (read only when the
  924 f55f:             ; probe found the card): 1 (open) = 6 dots, 80 x 24; 0 (fitted) = 8 dots, 64 x 24, the mode the graphics layer needs;
  925 f55f:             ; both from the 12 MHz crystal. Sets VCOLSV and VSCRLN; R6 = the CRTC's R0..R3 for vinit (the rest are common: vcrtab)
  926 f55f: 1e f8 bc    vmode:  MVIW R6,vcr80           ;;V2
  927 f562: 0e 50               LDAI 80                 ;;V2
  928 f564: e5 0f f8            STA VCOLSV              ;;V2
  929 f567: 0e e6               LDAI 230                ; 80*(VROWS-1)/8 ;;V2
  930 f569: e5 0f f9            STA VSCRLN              ;;V2
  931 f56c: e4 0f f0            LDA VIDPRES             ;;V2
  932 f56f: a1 f5 85            BRZ vmodex              ;;V2
  933 f572: 9c                  INP PC                  ;;V2
  934 f573: b3 01               ANDI 1                  ;;V2
  935 f575: a2 f5 85            BRNZ vmodex             ;;V2
  936 f578: 1e f8 c0            MVIW R6,vcr64           ;;V2
  937 f57b: 0e 40               LDAI 64                 ;;V2
  938 f57d: e5 0f f8            STA VCOLSV              ;;V2
  939 f580: 0e b8               LDAI 184                ; 64*(VROWS-1)/8 ;;V2
  940 f582: e5 0f f9            STA VSCRLN              ;;V2
  941 f585: 05          vmodex: RET                     ;;V2
  942 f586:             ;;V4 vmode:  LDAI 80                 ; V4: 80 columns, always
  943 f586:             ;;V4         STA VCOLSV
  944 f586:             ;;V4         RET
  945 f586:             ;
  946 f586:             ; vinit: the control register 0 (text on, graphics off: direct mode, plane and pages 0), the CRTC's 16 registers -
  947 f586:             ; R0..R3 for the mode vmode found, R4..R15 from vcrtab - through OUT PA / OUT PB, the CRTC cursor on, then vcls
  948 f586:             ; (R6, R7 clobbered)
  949 f586: 04 f5 5f    vinit:  JSR vmode
  950 f589: 7c 00               OUTI PC,0
  951 f58b:             ;;V4         LDAI 0                  ; V4: control 2 and its copy 0 - text on, the cursor's left half, both syncs
  952 f58b:             ;;V4         STA VIDC2               ;   negative, the three guns on (white)
  953 f58b:             ;;V4         OUTA PF
  954 f58b:             ;;V4         MVIW R6,vcrtab
  955 f58b: 0e 00               LDAI 0
  956 f58d: 6a          vinitl: OUTA PA
  957 f58e: 09                  PUSH
  958 f58f: 0d 04               LDTI 4                         ;;V2
  959 f591: aa f5 97            BRNEQ vinitn                   ;;V2
  960 f594: 1e f8 c4            MVIW R6,vcrtab                 ;;V2
  961 f597: 46          vinitn: LDAVR R6
  962 f598: 6b                  OUTA PB
  963 f599: 56                  INCR R6
  964 f59a: 0a                  POP
  965 f59b: b0 01               ADDI 1
  966 f59d: 0d 10               LDTI 16
  967 f59f: aa f5 8d            BRNEQ vinitl
  968 f5a2: 0e 01               LDAI 1
  969 f5a4: e5 0f f2            STA VIDCUR
  970 f5a7:             ; vcls: every byte of the display RAM a space, cursor home
  971 f5a7: 0e 20       vcls:   LDAI ' '
  972 f5a9: 04 f5 bb            JSR vfill
  973 f5ac:             ; vhome: cursor to row 0, column 0 (R7 clobbered)
  974 f5ac: 0e 00       vhome:  LDAI 0
  975 f5ae: e5 0f f3            STA VROW
  976 f5b1: e5 0f f4            STA VCOL
  977 f5b4: 1f d0 00            MVIW R7,VIDRAM
  978 f5b7: ef 0f f6            STR R7,VLINE
  979 f5ba: 05                  RET
  980 f5bb:             ;
  981 f5bb:             ; vfill: ACC to all VIDSIZE bytes of the display RAM, 8 per pass (R7, TMP clobbered, R5 kept)
  982 f5bb: 07 05       vfill:  PUSHR R5
  983 f5bd: 0b                  MVAT
  984 f5be: 1f d0 00            MVIW R7,VIDRAM
  985 f5c1: 15 00               MVIB R5,(VIDSIZE/8).0
  986 f5c3: 0c          vfilll: MVTA
  987 f5c4: 4f                  STAVR R7
  988 f5c5: 57                  INCR R7
  989 f5c6: 4f                  STAVR R7
  990 f5c7: 57                  INCR R7
  991 f5c8: 4f                  STAVR R7
  992 f5c9: 57                  INCR R7
  993 f5ca: 4f                  STAVR R7
  994 f5cb: 57                  INCR R7
  995 f5cc: 4f                  STAVR R7
  996 f5cd: 57                  INCR R7
  997 f5ce: 4f                  STAVR R7
  998 f5cf: 57                  INCR R7
  999 f5d0: 4f                  STAVR R7
 1000 f5d1: 57                  INCR R7
 1001 f5d2: 4f                  STAVR R7
 1002 f5d3: 57                  INCR R7
 1003 f5d4: 5d                  DECR R5
 1004 f5d5: 25                  MVRLA R5
 1005 f5d6: a2 f5 c3            BRNZ vfilll
 1006 f5d9: 08 50               POPR R5
 1007 f5db: 05                  RET
 1008 f5dc:             ;
 1009 f5dc:             ; vputc: ACC to the screen at the cursor (see above). Keeps R3-R7 and TMP; ACC is not kept (charout has its copy).
 1010 f5dc: e5 0f f5    vputc:  STA VCHAR
 1011 f5df: 0c                  MVTA
 1012 f5e0: 09                  PUSH
 1013 f5e1: 07 07               PUSHR R7
 1014 f5e3: e4 0f f5            LDA VCHAR
 1015 f5e6: b3 7f               ANDI 07fh
 1016 f5e8: 0d 20               LDTI 020h
 1017 f5ea: a7 f6 00            BRLT vpctl
 1018 f5ed: 0d 7f               LDTI 07fh
 1019 f5ef: a8 f5 f8            BREQ vpdone
 1020 f5f2: 04 f6 d0            JSR vupper                     ;;V2
 1021 f5f5: 04 f6 4b            JSR vpchar
 1022 f5f8: 04 f6 e6    vpdone: JSR vcursor
 1023 f5fb: 08 70               POPR R7
 1024 f5fd: 0a                  POP
 1025 f5fe: 0b                  MVAT
 1026 f5ff: 05                  RET
 1027 f600: 0d 0d       vpctl:  LDTI 0dh
 1028 f602: a8 f6 29            BREQ vpcr
 1029 f605: 0d 0a               LDTI 0ah
 1030 f607: a8 f6 31            BREQ vplf
 1031 f60a: 0d 08               LDTI 08h
 1032 f60c: a8 f6 37            BREQ vpbs
 1033 f60f: 0d 0c               LDTI 0ch
 1034 f611: a8 f6 45            BREQ vpff
 1035 f614: 0d 09               LDTI 09h
 1036 f616: aa f5 f8            BRNEQ vpdone
 1037 f619: 0e 20       vptab:  LDAI ' '
 1038 f61b: 04 f6 4b            JSR vpchar
 1039 f61e: e4 0f f4            LDA VCOL
 1040 f621: b3 07               ANDI 7
 1041 f623: a2 f6 19            BRNZ vptab
 1042 f626: a0 f5 f8            BR vpdone
 1043 f629: 0e 00       vpcr:   LDAI 0
 1044 f62b: e5 0f f4            STA VCOL
 1045 f62e: a0 f5 f8            BR vpdone
 1046 f631: 04 f6 63    vplf:   JSR vlf
 1047 f634: a0 f5 f8            BR vpdone
 1048 f637: e4 0f f4    vpbs:   LDA VCOL
 1049 f63a: a1 f5 f8            BRZ vpdone
 1050 f63d: b1 01               SUBI 1
 1051 f63f: e5 0f f4            STA VCOL
 1052 f642: a0 f5 f8            BR vpdone
 1053 f645: 04 f5 a7    vpff:   JSR vcls
 1054 f648: a0 f5 f8            BR vpdone
 1055 f64b:             ;
 1056 f64b:             ; vpchar: ACC stored at the cursor, the cursor one right; past the last column to the next row (R7, TMP clobbered)
 1057 f64b: 09          vpchar: PUSH
 1058 f64c: 04 f6 d8            JSR vcaddr
 1059 f64f: 0a                  POP
 1060 f650: 4f                  STAVR R7
 1061 f651: e4 0f f4            LDA VCOL
 1062 f654: b0 01               ADDI 1
 1063 f656: e5 0f f4            STA VCOL
 1064 f659: e6 0f f8            LDT VCOLSV
 1065 f65c: aa f6 62            BRNEQ vpchx
 1066 f65f: 04 f6 63            JSR vlf
 1067 f662: 05          vpchx:  RET
 1068 f663:             ;
 1069 f663:             ; vlf: column 0 of the next row; on the last row the screen scrolls instead (R7, TMP clobbered)
 1070 f663: 0e 00       vlf:    LDAI 0
 1071 f665: e5 0f f4            STA VCOL
 1072 f668: e4 0f f3            LDA VROW
 1073 f66b: b0 01               ADDI 1
 1074 f66d: 0d 18               LDTI VROWS
 1075 f66f: a8 f6 82            BREQ vscroll
 1076 f672: e5 0f f3            STA VROW
 1077 f675: f7 0f f6            LDR R7,VLINE
 1078 f678: e6 0f f8            LDT VCOLSV
 1079 f67b: 04 f6 de            JSR vaddt
 1080 f67e: ef 0f f6            STR R7,VLINE
 1081 f681: 05                  RET
 1082 f682:             ;
 1083 f682:             ; vscroll: rows 1..VROWS-1 up one row (8 bytes per pass), the last row blanked; R5/R6 kept, R7 clobbered
 1084 f682:             vscroll:
 1085 f682: 07 06               PUSHR R6
 1086 f684: 07 05               PUSHR R5
 1087 f686: 1f d0 00            MVIW R7,VIDRAM
 1088 f689: e6 0f f8            LDT VCOLSV
 1089 f68c: 04 f6 de            JSR vaddt
 1090 f68f: 07 07               PUSHR R7
 1091 f691: 08 60               POPR R6                 ; R6 = VIDRAM + VCOLSV: row 1
 1092 f693: 1f d0 00            MVIW R7,VIDRAM
 1093 f696: e4 0f f9            LDA VSCRLN                     ;;V2
 1094 f699:             ;;V4         LDAI 240                ; 80*(VROWS-1)/8
 1095 f699: 35                  MVARL R5
 1096 f69a: 46          vscrl:  LDAVR R6
 1097 f69b: 4f                  STAVR R7
 1098 f69c: 56                  INCR R6
 1099 f69d: 57                  INCR R7
 1100 f69e: 46                  LDAVR R6
 1101 f69f: 4f                  STAVR R7
 1102 f6a0: 56                  INCR R6
 1103 f6a1: 57                  INCR R7
 1104 f6a2: 46                  LDAVR R6
 1105 f6a3: 4f                  STAVR R7
 1106 f6a4: 56                  INCR R6
 1107 f6a5: 57                  INCR R7
 1108 f6a6: 46                  LDAVR R6
 1109 f6a7: 4f                  STAVR R7
 1110 f6a8: 56                  INCR R6
 1111 f6a9: 57                  INCR R7
 1112 f6aa: 46                  LDAVR R6
 1113 f6ab: 4f                  STAVR R7
 1114 f6ac: 56                  INCR R6
 1115 f6ad: 57                  INCR R7
 1116 f6ae: 46                  LDAVR R6
 1117 f6af: 4f                  STAVR R7
 1118 f6b0: 56                  INCR R6
 1119 f6b1: 57                  INCR R7
 1120 f6b2: 46                  LDAVR R6
 1121 f6b3: 4f                  STAVR R7
 1122 f6b4: 56                  INCR R6
 1123 f6b5: 57                  INCR R7
 1124 f6b6: 46                  LDAVR R6
 1125 f6b7: 4f                  STAVR R7
 1126 f6b8: 56                  INCR R6
 1127 f6b9: 57                  INCR R7
 1128 f6ba: 5d                  DECR R5
 1129 f6bb: 25                  MVRLA R5
 1130 f6bc: a2 f6 9a            BRNZ vscrl
 1131 f6bf: e4 0f f8            LDA VCOLSV
 1132 f6c2: 35                  MVARL R5
 1133 f6c3: d7 20       vscrb:  LDIVR R7,' '
 1134 f6c5: 57                  INCR R7
 1135 f6c6: 5d                  DECR R5
 1136 f6c7: 25                  MVRLA R5
 1137 f6c8: a2 f6 c3            BRNZ vscrb
 1138 f6cb: 08 50               POPR R5
 1139 f6cd: 08 60               POPR R6
 1140 f6cf: 05                  RET
 1141 f6d0:             ;
 1142 f6d0:             ; vupper: $60-$7F down to $40-$5F (lower case to upper; the monitor's toupper also moves [ \ ] ^ _, which the
 1143 f6d0:             ; 64-glyph set has)
 1144 f6d0: 0d 60       vupper: LDTI 060h               ;;V2
 1145 f6d2: a7 f6 d7            BRLT vuppx              ;;V2
 1146 f6d5: b1 20               SUBI 020h               ;;V2
 1147 f6d7: 05          vuppx:  RET                     ;;V2
 1148 f6d8:             ;
 1149 f6d8:             ; vcaddr: R7 = VLINE + VCOL, the cursor's address (TMP clobbered)
 1150 f6d8: e6 0f f4    vcaddr: LDT VCOL
 1151 f6db: f7 0f f6            LDR R7,VLINE
 1152 f6de:             ; vaddt: R7 += TMP (8 bits). The ADDIC follows the ADDI with only register moves between: the carry is the add's
 1153 f6de:             ; on the machine and on both emulators (docs/programming/ISA-REFERENCE.md section 6)
 1154 f6de: 27          vaddt:  MVRLA R7
 1155 f6df: b8                  ADDT
 1156 f6e0: 37                  MVARL R7
 1157 f6e1: 2f                  MVRHA R7
 1158 f6e2: e2 00               ADDIC 0
 1159 f6e4: 3f                  MVARH R7
 1160 f6e5: 05                  RET
 1161 f6e6:             ;
 1162 f6e6:             ; vcursor: with VIDCUR set, the CRTC's cursor registers R14/R15 <- the cursor's offset from VIDRAM (R7 clobbered)
 1163 f6e6:             vcursor:
 1164 f6e6: e4 0f f2            LDA VIDCUR
 1165 f6e9: a1 f6 fb            BRZ vcurx
 1166 f6ec: 04 f6 d8            JSR vcaddr
 1167 f6ef: 0e 0e               LDAI 14                 ;;V2
 1168 f6f1: 6a                  OUTA PA                 ;;V2
 1169 f6f2: 2f                  MVRHA R7                ;;V2
 1170 f6f3: b1 d0               SUBI (VIDRAM).1         ;;V2
 1171 f6f5: 6b                  OUTA PB                 ;;V2
 1172 f6f6: 0e 0f               LDAI 15                 ;;V2
 1173 f6f8: 6a                  OUTA PA                 ;;V2
 1174 f6f9: 27                  MVRLA R7                ;;V2
 1175 f6fa: 6b                  OUTA PB                 ;;V2
 1176 f6fb:             ;;V4 ; V4: the 6845 counts pairs of characters. R14/R15 = the cursor's offset from VIDRAM halved (the start address is
 1177 f6fb:             ;;V4 ; 0), and the offset's bit 0 is CURH, control 2's bit 1: the cursor on the right-hand character of its count
 1178 f6fb:             ;;V4         LDAI 14
 1179 f6fb:             ;;V4         OUTA PA
 1180 f6fb:             ;;V4         MVRHA R7
 1181 f6fb:             ;;V4         SUBI (VIDRAM).1         ; the offset's high byte, 0..7
 1182 f6fb:             ;;V4         SHR
 1183 f6fb:             ;;V4         OUTA PB
 1184 f6fb:             ;;V4         LDAI 15
 1185 f6fb:             ;;V4         OUTA PA
 1186 f6fb:             ;;V4         MVRHA R7                ; its bit 0 ((VIDRAM).1 is even) is bit 7 of the halved low byte
 1187 f6fb:             ;;V4         ANDI 1
 1188 f6fb:             ;;V4         BRZ vcur1
 1189 f6fb:             ;;V4         LDAI 080h
 1190 f6fb:             ;;V4 vcur1:  MVAT
 1191 f6fb:             ;;V4         MVRLA R7
 1192 f6fb:             ;;V4         SHR
 1193 f6fb:             ;;V4         ORT
 1194 f6fb:             ;;V4         OUTA PB
 1195 f6fb:             ;;V4         MVRLA R7                ; CURH
 1196 f6fb:             ;;V4         ANDI 1
 1197 f6fb:             ;;V4         SHL
 1198 f6fb:             ;;V4         MVAT
 1199 f6fb:             ;;V4         LDA VIDC2
 1200 f6fb:             ;;V4         ANDI 0fdh
 1201 f6fb:             ;;V4         ORT
 1202 f6fb:             ;;V4         STA VIDC2
 1203 f6fb:             ;;V4         OUTA PF
 1204 f6fb: 05          vcurx:  RET
 1205 f6fc:             ;
 1206 f6fc:             ; vidctl: the video entry at $FFBC (JSR vidctl / RET, below the full vector table), for Y1/OS and programs.
 1207 f6fc:             ; ACC = 0 probe (ACC = VIDPRES), 1 init (V I), 2 clear + home (V C); anything else: ACC = VIDPRES.
 1208 f6fc:             ; A caller checks that $FFBC holds $04 (JSR) first: an older ROM has $FF there. Clobbers R5-R7, TMP.
 1209 f6fc: 0d 01       vidctl: LDTI 1
 1210 f6fe: a8 f7 0f            BREQ vctli
 1211 f701: 0d 02               LDTI 2
 1212 f703: a8 f7 15            BREQ vctlc
 1213 f706: a2 f7 18            BRNZ vctlx
 1214 f709: 04 f5 46            JSR vprobe
 1215 f70c: a0 f7 18            BR vctlx
 1216 f70f: 04 f5 86    vctli:  JSR vinit
 1217 f712: a0 f7 18            BR vctlx
 1218 f715: 04 f5 a7    vctlc:  JSR vcls
 1219 f718: e4 0f f0    vctlx:  LDA VIDPRES
 1220 f71b: 05                  RET
 1221 f71c:             ;
 1222 f71c:             ; ---- V: the video unit (monitor command) ---------------------------------------------------------------------
 1223 f71c:             ; V then a letter (blanks skipped); numbers are hex, blanks between them optional. V? (or any other letter) lists:
 1224 f71c:             ;   VS  status          VP  probe again      VI  init (CRTC, clear, home)     VC  clear, home
 1225 f71c:             ;   VM1 / VM0  mirror on / off               VW rr cc text  text at row rr, column cc (not the cursor)
 1226 f71c:             ;   VB aaaa bb bb ..  bytes from aaaa ($Dxxx only)   VF bb  fill the 2K     VD  the screen as text (not mirrored)
 1227 f71c:             ;   VR rr [vv]  write CRTC register rr, or read it
 1228 f71c:             ;
 1229 f71c:             cmd_video:
 1230 f71c: 0d 00               LDTI NOMODE
 1231 f71e: e7 0f 00            STT monmode
 1232 f721: 04 f8 ad            JSR vskip
 1233 f724: 04 f9 04            JSR toupper
 1234 f727: 0d 53               LDTI 'S'
 1235 f729: a8 f7 79            BREQ vcstat
 1236 f72c: 0d 50               LDTI 'P'
 1237 f72e: a8 f7 5f            BREQ vcprob
 1238 f731: 0d 49               LDTI 'I'
 1239 f733: a8 f7 65            BREQ vcinit
 1240 f736: 0d 43               LDTI 'C'
 1241 f738: a8 f7 6b            BREQ vcclr
 1242 f73b: 0d 4d               LDTI 'M'
 1243 f73d: a8 f7 71            BREQ vcmir
 1244 f740: 0d 57               LDTI 'W'
 1245 f742: a8 f7 b9            BREQ vcwrt
 1246 f745: 0d 42               LDTI 'B'
 1247 f747: a8 f8 11            BREQ vcbyt
 1248 f74a: 0d 46               LDTI 'F'
 1249 f74c: a8 f8 36            BREQ vcfil
 1250 f74f: 0d 44               LDTI 'D'
 1251 f751: a8 f8 3f            BREQ vcdump
 1252 f754: 0d 52               LDTI 'R'
 1253 f756: a8 f8 88            BREQ vcreg
 1254 f759: 1f fe d1            MVIW R7,VHELP
 1255 f75c: a0 f7 9d            BR vcmsg
 1256 f75f: 04 f5 46    vcprob: JSR vprobe
 1257 f762: a0 f7 79            BR vcstat
 1258 f765: 04 f5 86    vcinit: JSR vinit
 1259 f768: a0 f7 79            BR vcstat
 1260 f76b: 04 f5 a7    vcclr:  JSR vcls
 1261 f76e: a0 f7 9a            BR vcok
 1262 f771: 04 f8 ad    vcmir:  JSR vskip                ; '1' ($31) -> 1, '0' ($30) -> 0
 1263 f774: b3 01               ANDI 1
 1264 f776: e5 0f f1            STA VIDMIR
 1265 f779: 1f fe 9b    vcstat: MVIW R7,MSGVST          ; VIDPRES, VIDMIR, VIDCUR, VROW, VCOL ($0FF0-$0FF4), each after its label
 1266 f77c: 1e 0f f0            MVIW R6,VIDPRES
 1267 f77f: 04 fa 19    vcstl:  JSR stringout
 1268 f782: 57                  INCR R7
 1269 f783: 46                  LDAVR R6
 1270 f784: 04 f9 dc            JSR showbytea
 1271 f787: 56                  INCR R6
 1272 f788: 26                  MVRLA R6
 1273 f789: 0d f5               LDTI (VCOL+1).0
 1274 f78b: aa f7 7f            BRNEQ vcstl
 1275 f78e: 1f fe c4            MVIW R7,MSGVCOL         ; 2026-10-22: the columns vmode set ($50 or $40)
 1276 f791: 04 fa 19            JSR stringout
