 1120 f6e4:             ;
 1121 f6e4:             ; vupper: $60-$7F down to $40-$5F (lower case to upper; the monitor's toupper also moves [ \ ] ^ _, which the
 1122 f6e4:             ; 64-glyph set has)
 1123 f6e4: 0d 60       vupper: LDTI 060h
