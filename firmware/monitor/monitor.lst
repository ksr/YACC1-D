  625 f322: 2e                  MVRHA R6
  626 f323: a2 f3 1a            BRNZ cfwrl
  627 f326: 04 f2 7a            JSR cfwait
  628 f329: b3 01               ANDI 001H
  629 f32b: 05                  RET
  630 f32c:             ;
  631 f32c:             ; const: ACC = 1 when a console byte is waiting (2026-11-10: a key on the V2.0 card's keyboard counts too). The
  632 f32c:             ; emulator's port-2 console has no status: always ready.
  633 f32c:             const:
  634 f32c: af f3 32            BRDEV consthw
  635 f32f: 0e 01               LDAI 1
  636 f331: 05                  RET
  637 f332:             consthw:
  638 f332: 04 f3 3e            JSR kbst
  639 f335: a2 f3 3d            BRNZ constx
  640 f338: 70 68               OUTI P0,(UARTCS!UARTA5)
  641 f33a: 91                  INP P1
  642 f33b: b3 01               ANDI 001H
  643 f33d: 05          constx: RET
  644 f33e:             ;
  645 f33e:             ; kbst (2026-11-10): ACC = 1 when the video card V2.0's PS/2 keyboard has a byte (IN PD bit 0, FULL), else 0; the
  646 f33e:             ; byte is then IN PE (the card's rule: read PE only after PD showed FULL). 0 with no card (VIDPRES = 0).
  647 f33e: e4 0f f0    kbst:   LDA VIDPRES
  648 f341: 0d 01               LDTI 1
  649 f343: aa f3 4a            BRNEQ kbst0
  650 f346: 9d                  INP PD
  651 f347: b3 01               ANDI 1
  652 f349: 05                  RET
  653 f34a: 0e 00       kbst0:  LDAI 0
  654 f34c: 05                  RET
  655 f34d:             ;
  656 f34d:             ; O command: boot. Read the boot block (LBA 0) to OSBASE, check 'P8' and OSCNT, read OSCNT sectors from LBA 1
  657 f34d:             ; to OSBASE and call it; the OS returns with RET.
  658 f34d:             ;
  659 f34d:             ;
  660 f34d:             ; ':' - Intel-hex loader (YACC1-D 2026-09-23). A ':' at the prompt starts load mode: the rest of the record is read
  661 f34d:             ; without echo (uartinne), its bytes stored from its address on, and the record acknowledged with one character:
  662 f34d:             ;   .  stored and the checksum is right
  663 f34d:             ;   ?  a bad hex digit or a bad checksum
  664 f34d:             ;   !  refused or not verified: an address outside $1000-$DFFF (the monitor's page, the stack and the ROM are
  665 f34d:             ;      protected; any write to $E000-$FFFF would reach the 28C64, review M2), or the byte read back differently
  666 f34d:             ; Between records everything up to the next ':' is skipped (CR, LF, blanks), so an assembler .img can be pasted into
  667 f34d:             ; a terminal or sent as is; ESC (or a NUL, the emulators' end of input) abandons, between records or inside one. The end record (type 01) prints
  668 f34d:             ; LOADED, or LOADED WITH ERRORS when any record failed, and returns to the prompt. Records of other types are read
  669 f34d:             ; and checked but not stored. Host side: tools/monload.py paces the characters (the UART has no FIFO enabled: one
  670 f34d:             ; character of buffering) and waits for each acknowledgement. Registers: R3 checksum, R4 count, R5 type,
  671 f34d:             ; R6 record status (0 ok, 1 bad hex, 2 refused/unverified), R7 the address; never R2.
  672 f34d:             ;
  673 f34d:             hexload:
  674 f34d: 0d 05               LDTI  LOADMODE
  675 f34f: e7 0f 00            STT   monmode
  676 f352: 0d 00               LDTI  0
  677 f354: e7 0f 01            STT   lderr
  678 f357:             ldrec:
  679 f357: 1b 00 00            MVIW  R3,0
  680 f35a: 1c 00 00            MVIW  R4,0
  681 f35d: 1e 00 00            MVIW  R6,0
  682 f360: 04 f4 08            JSR   ldbyte            ; byte count
  683 f363: 34                  MVARL R4
  684 f364: 04 f4 08            JSR   ldbyte            ; address high
  685 f367: 3f                  MVARH R7
  686 f368: 04 f4 08            JSR   ldbyte            ; address low
  687 f36b: 37                  MVARL R7
  688 f36c: 04 f4 08            JSR   ldbyte            ; record type
