  512 f27a:             ;
  513 f27a:             ; ---- CompactFlash driver (YACC1-D 2026-09-22) -----------------------------------------------------------
  514 f27a:             ; The card sits on two ports: P8 = register-select latch (ATA task-file register 0-7), P9 = data.
  515 f27a:             ; 8-bit True IDE mode. Registers: 0 data, 1 error/feature, 2 sector count, 3-5 LBA0-2, 6 drive/head, 7 status/cmd.
  516 f27a:             ; Entry points (also BIOS vectors at 0FFECh..): cfinit  ACC = 0 ok / 1 error (absent card times out);
  517 f27a:             ;   cfread   sector CFLBA0..2 -> (R7), R7 += 512, ACC = 0 ok / 1 error;   cfwrite  (R7) -> sector, R7 += 512, same;
  518 f27a:             ;   R6 and TMP are clobbered. const  ACC = 1 when a console byte waits (0 otherwise).
  519 f27a:             ;
  520 f27a:             CFSEL_DATA:  EQU 0
  521 f27a:             CFSEL_FEAT:  EQU 1
  522 f27a:             CFSEL_SCNT:  EQU 2
  523 f27a:             CFSEL_LBA0:  EQU 3
  524 f27a:             CFSEL_LBA1:  EQU 4
  525 f27a:             CFSEL_LBA2:  EQU 5
  526 f27a:             CFSEL_HEAD:  EQU 6
  527 f27a:             CFSEL_CMD:   EQU 7
  528 f27a:             ;
  529 f27a:             ; wait while BSY (bit 7), bounded to 65536 polls; returns the status in ACC
  530 f27a:             cfwait:
  531 f27a: 1e 00 00            MVIW R6,0
  532 f27d:             cfwaitl:
  533 f27d: 78 07               OUTI P8,CFSEL_CMD
  534 f27f: 99                  INP P9
  535 f280: b3 80               ANDI 080H
  536 f282: a1 f2 8e            BRZ cfwaitd
  537 f285: 5e                  DECR R6
  538 f286: 26                  MVRLA R6
  539 f287: a2 f2 7d            BRNZ cfwaitl
  540 f28a: 2e                  MVRHA R6
  541 f28b: a2 f2 7d            BRNZ cfwaitl
  542 f28e:             cfwaitd:
  543 f28e: 78 07               OUTI P8,CFSEL_CMD
  544 f290: 99                  INP P9
  545 f291: 05                  RET
  546 f292:             ;
  547 f292:             ; wait until DRQ (bit 3), bounded; returns the status in ACC
  548 f292:             cfdrq:
  549 f292: 1e 00 00            MVIW R6,0
  550 f295:             cfdrql:
  551 f295: 78 07               OUTI P8,CFSEL_CMD
  552 f297: 99                  INP P9
