   42 0000:             ;
   43 0000:             ; Monitor variables 0x0f00 - 0x0fff
   44 0000:             ;
   45 0000:             monmode:        EQU 0f00h
   46 0000:             continue_addr:  EQU 0f02h
   47 0000:             lderr:          EQU 0f01h    ; 2026-09-23: nonzero when a record of the current ':' load failed
   48 0000:             interupt_cnt:   EQU 0f04h
   49 0000:             ;
   50 0000:             ; CompactFlash driver variables (YACC1-D 2026-09-22) and the OS/program argument buffer
   51 0000:             ;
   52 0000:             CFLBA0:         EQU 0f10h    ; sector number for CFREAD/CFWRITE, low byte
   53 0000:             CFLBA1:         EQU 0f11h
   54 0000:             CFLBA2:         EQU 0f12h    ; high byte (24-bit LBA)
   55 0000:             ARGBUF:         EQU 0f40h    ; 64 bytes: the OS leaves a program's command tail here (NUL-terminated)
   56 0000:             OSBASE:         EQU 1000h    ; where the boot command loads the OS image (LBA 1..OSCNT) and calls it
   57 0000:             line_buffer:    EQU 0f80h    ; 112 bytes long max ($0FF0-$0FFF are the video variables since 2026-09-25)
   58 0000:             ;
   59 0000:             ; Video card (YACC1-D 2026-09-25): MC6845 CRTC + IDT7134 dual-port RAM in the $D000 block (docs/cards/video.md).
   60 0000:             ; The driver is always in the ROM; VIDAUTO decides whether reset also starts it. Until the card is debugged it does
   61 0000:             ; not: reset only probes $D000 (VIDPRES, the banner says VIDEO CARD FOUND) and homes the cursor variables; V I
   62 0000:             ; initialises the CRTC and clears the screen, V M1 (or Y1/OS's `video on`) turns the mirroring on.
   63 0000:             ;
   64 0000:             VIDAUTO:        EQU 0        ; 1 = reset also runs V I (CRTC table, clear, home) and sets VIDMIR when a card is found
   65 0000:             VIDRAM:         EQU 0d000h   ; display RAM, CPU side (A11 = 0); its first byte is the probe byte
   66 0000:             VIDSIZE:        EQU 2048     ; the RAM the CPU reaches (IC15 A11R grounded): VIDRAM..VIDRAM+2047
   67 0000:             VCOLS:          EQU 80       ; screen geometry: 80 x 24 = 1,920 bytes of the 2K, one byte per character
   68 0000:             VROWS:          EQU 24       ;   (VCOLS*(VROWS-1) must be a multiple of 8 and at most 2,040: the scroll's loop)
   69 0000:             VCRTCA:         EQU 0d800h   ; 6845 address register: A11 = 1, A1 = 0, A0 = 0 (the netlist reading of the card; the
   70 0000:             VCRTCD:         EQU 0d802h   ;   card README says $D400/$D402 - one edit here). Data register: A1 = 1, after the
   71 0000:                                          ;   RS-to-A1 bench fix (hardware/cards/video/docs/fix-6845-register-select.md)
   72 0000:             VIDPRES:        EQU 0ff0h    ; 1 = display RAM answered at VIDRAM at reset (or at the last V P)
   73 0000:             VIDMIR:         EQU 0ff1h    ; nonzero = CHAROUT/UARTOUT also write to the screen (only while VIDPRES is 1)
   74 0000:             VIDCUR:         EQU 0ff2h    ; nonzero = keep the CRTC's cursor (R14/R15) at the text cursor (set by V I)
   75 0000:             VROW:           EQU 0ff3h    ; text cursor row 0..VROWS-1
   76 0000:             VCOL:           EQU 0ff4h    ; text cursor column 0..VCOLS-1
   77 0000:             VCHAR:          EQU 0ff5h    ; the driver's scratch byte
   78 0000:             VLINE:          EQU 0ff6h    ; word ($0FF6 high, $0FF7 low): the address of the cursor row's first byte
   79 0000:             
