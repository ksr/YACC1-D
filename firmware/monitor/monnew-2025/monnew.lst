    1 0000:             ; Simple Monitor Program for YACC1-2020
    2 0000:             ; Supports: 
    3 0000:             ; 1) Display a memory location (D command)
    4 0000:             ; 2) Modify a memory location (M command)
    5 0000:             ; 3) Display 256 bytes of memory block (B command)
    6 0000:             ; Uses support functions:
    7 0000:             ; - getc: gets character from keyboard, returns in R7
    8 0000:             ; - putc: outputs character in R7 to the screen
    9 0000:             
   10 0000:             ; Constants
   11 0000:             CR: EQU  0x0D       ; Carriage return
   12 0000:             LF: EQU 0x0A       ; Line feed
   13 0000:             SPACE:  EQU 0x20    ; Space character
   14 0000:             CMD_DISP: EQU 0x44 ; 'D' - Display memory location
   15 0000:             CMD_MOD: EQU 0x4D  ; 'M' - Modify memory location
   16 0000:             CMD_BLOCK:  EQU 0x42 ; 'B' - Display memory block
