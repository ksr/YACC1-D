mkdir /t
touch /t/e1 /t/e2 fruit.txt
cp fruit.txt /t
cp /bin/hello /t/h
mkdir /t/s
cp fruit2.txt /t/s/f2.txt
tree /t
dir -R /t
dir -S /t
dir /t/*.txt
find f /t
find *2* /t
grep -r kiwi /t
grep an fruit.txt fruit2.txt
cp -r /t /u
cp -r /t /t/s
cp *.txt /u/s
cp /README /u/s/readme.txt
mv /u/e1 /u/e3
mv /u/h /u/s
mv /u/fruit.txt /u/s/f1.txt
mv /u /t
del /u/e2 /u/none /u/s/r*.txt
tree /u
cd /u/s
h x y
cd /
dir -R /u
exit
