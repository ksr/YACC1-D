mkdir /pk
echo gone > /pk/g.txt
mkdir /pk/sub
cp /docs/y1cc.md /pk/sub/y1cc.md
echo one > /pk/log
mkdir /pk/sub/deep
cp /docs/mddemo.md /pk/sub/deep/md.md
cp /bin/hello /pk/sub/h
mkdir /pk/empty
echo alpha > /pk/a.txt
echo two >> /pk/log
del /pk/g.txt
rmdir /pk/empty
echo alpha2 > /pk/a.txt
sort /fruit.txt | UNIQ > /pk/u.txt
del /fruit2.txt
cd /pk/sub
pack
pwd
dir
cd deep
dir
cd ..
cd ..
pwd
dir
cat log
cat a.txt
cat u.txt
cmp /pk/sub/y1cc.md /docs/y1cc.md
cmp /pk/sub/deep/md.md /docs/mddemo.md
run /pk/sub/h 1 2
head -3 /man/pack
echo new > /pk/new.txt
cat /pk/new.txt
pack > /x.txt
cat /fruit.txt | pack
pack < /fruit.txt
del /x.txt
echo mid > /pk/sub/deep/mid.txt
cd /
pack
echo last > /pk/sub/deep/last.txt
dir /pk/sub/deep
exit
