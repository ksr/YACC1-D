	(rectangle (start 12.7 27.94) (end 144.78 133.35) (stroke (width 0.2) (type dash) (color 72 72 160 1)) (fill (type none)) (uuid "d5d1d660-7a9c-52a4-a741-4ddd31087415"))
	(text "FROM THE BUS (memory card X1, sheet 1)" (exclude_from_sim no) (at 13.97 29.21 0) (effects (font (size 2 2) (bold yes)) (justify left top)) (uuid "21d8653c-1c77-56e6-83ea-f29777746aa5"))
	(text "The CF section has no bus connector of its own: it shares the memory\ncard's X1. Boxed global labels = nets shared with sheets 1-6:\n\n  IO-ADDR0-3   X1 C7-C10   port number -> IC30 (74LS138)\n  -IO-RD       X1 B25      -> IC31 gate 2 (CF -IOR)\n  -IO-WR       X1 B26      -> IC31 gates 1 and 3 (latch clock, CF -IOW)\n  -RESET       X1 C30      -> IC32 CLR, IC33 gate 2 (also IC12 PRE)\n  DATA0-7      X1 A19-A26  -> IC34 A side; DATA0-3 -> IC32 D1-D4\n  VCC, GND     the card's supply (six pins each on X1)\n\nOn v1.3, IO-ADDR0-3, -IO-RD and -IO-WR reached X1 only.\nThe CF section drives the data bus only while the CPU\nreads port P9 (IC34 enabled by -CFOE, DIR = -IOR)." (exclude_from_sim no) (at 15.24 40.64 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "73ae99a9-48a5-53b9-a2bf-ef2524fe8a91"))
	(rectangle (start 147.32 12.7) (end 266.7 106.68) (stroke (width 0.2) (type dash) (color 72 72 160 1)) (fill (type none)) (uuid "e28eacea-1561-5126-874a-8173473cfb8e"))
	(text "PORT DECODE + STROBE GATING" (exclude_from_sim no) (at 148.59 13.97 0) (effects (font (size 2 2) (bold yes)) (justify left top)) (uuid "ac3b031a-e926-5ee7-a3ac-0ce8414fb8d1"))
