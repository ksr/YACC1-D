	(text "-IO-SEL4 = IC5 Y4 (sheet 5): port P4\n-IO-SEL5 = IC5 Y5 (sheet 5): port P5\nIC5 decodes P0-P7 only with the\nIO-ADDR-HL strap in P0-P7.\n\ngate 1: P4 latch clock\n  = -IO-SEL4 OR -IO-WR\ngate 2: CF -IOR\n  = -IO-SEL5 OR -IO-RD\ngate 3: CF -IOW\n  = -IO-SEL5 OR -IO-WR\ngate 4: unused" (exclude_from_sim no) (at 15.24 25.4 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "4cdbcd5b-4be4-5199-b30e-6c53219106a5"))
