	(text "POWER UNITS, DECOUPLING, POWER LED, THE SPARE GATES" (exclude_from_sim no) (at 15.24 12.7 0) (effects (font (size 2.5 2.5) (bold yes)) (justify left top)) (uuid "daad6849-06d8-591f-b474-c8abe9602496"))
	(text "One 100 nF per IC beside its VCC pin (C21 at the oscillator), C5 47 uF bulk. The bus supplies VCC and GND (X1,\nsix pins each): the PWR_FLAGs. Spare, their inputs on GND: two gates of IC11, one of IC13, one of IC14." (exclude_from_sim no) (at 15.24 17.78 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "951182cd-ae1a-5e9a-803a-eaf67ea8600c"))
