	(text "THE SWITCHES, THE LEDS, THE TIL311 DISPLAYS, IN AND OUT" (exclude_from_sim no) (at 15.24 12.7 0) (effects (font (size 2.5 2.5) (bold yes)) (justify left top)) (uuid "e4d48839-7900-5afd-82c6-a6ad3ae69898"))
	(text "With SWITCH-LED in the control latch a read of P1 is the switches (IC3: up = 1, S0 = bit 0) and a write of P1 the\nLEDs (IC4). With TIL311 a write of P1 is the two hex displays (IC9: LO the low nibble). S8 is the bus line IN (JP6);\nLED8 shows the bus line OUT." (exclude_from_sim no) (at 15.24 17.78 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "fb863508-1310-5b7a-a4ed-94f71f80f8e2"))
	(embedded_fonts no)
)
