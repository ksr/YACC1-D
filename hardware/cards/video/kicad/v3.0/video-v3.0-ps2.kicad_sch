	(text "PS/2: ATMEGA328P, LATCHES ON PE / PF, THE CARD STATUS, FTDI, -INT, RESET" (exclude_from_sim no) (at 15.24 12.7 0) (effects (font (size 2.5 2.5) (bold yes)) (justify left top)) (uuid "1d4371a4-c4ea-5419-9680-5bfe80d168b1"))
	(text "IC24 runs embedded/video-ps2. OUT PE loads a command into IC26 (BUSY set), IN PF reads a byte from IC25 (FULL\ncleared), IN PE the status IC27: FULL, SRC, BUSY, TEXT (JP3: method A's parts are fitted) and the ID 0110.\n-INT = INTREQ AND FULL (IC30/B) through IC29/D and JP2. The bus -RESET reaches MRST through IC30/C, IC29/E\nand IC29/F (open collector, R8): it only ever pulls MRST low." (exclude_from_sim no) (at 15.24 17.78 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "179f212b-1bd5-5241-aee9-019e9a19c6a7"))
	(embedded_fonts no)
