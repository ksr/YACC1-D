	(text "PWR_FLAGs: the bus supplies VCC and GND (X1, six pins each)." (exclude_from_sim no) (at 55.88 267.97 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "56d05289-d233-554c-bb8d-d5ce8419f0aa"))
	(text "POWER UNITS, DECOUPLING, POWER LED, THE F PARTS' PULL-UP" (exclude_from_sim no) (at 15.24 12.7 0) (effects (font (size 2.5 2.5) (bold yes)) (justify left top)) (uuid "694f36f8-c3b8-51b8-8fdd-cd5a8955ab4b"))
	(text "One 100 nF per IC beside its VCC pin (C50 at the chip's second VCC pin, C52 at the ATmega's AVCC), C1 47 uF\nbulk. The bus supplies VCC and GND (X1, six pins each): the PWR_FLAGs. PU (R18, 1k) holds the 74F parts'\nunused inputs high. Spare gates: IC4/B, IC19/A, three of IC29, three of IC43." (exclude_from_sim no) (at 15.24 17.78 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "915bef3c-cace-55e1-a8a7-9502336e9c50"))
	(embedded_fonts no)
)
