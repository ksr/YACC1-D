	(text "PWR_FLAGs: the bus supplies VCC and GND (X1, six pins each)." (exclude_from_sim no) (at 55.88 232.41 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "06162311-0259-50fb-aad3-a987dd3602e6"))
	(text "POWER UNITS, DECOUPLING, POWER LED, THE F PARTS' PULL-UP" (exclude_from_sim no) (at 15.24 12.7 0) (effects (font (size 2.5 2.5) (bold yes)) (justify left top)) (uuid "045c6ff3-c7e0-5890-9b5b-ffda34d3631b"))
	(text "One 100 nF per IC beside its VCC pin (C48 at the oscillator, C49 at the ATmega's AVCC), C1 47 uF bulk. The bus\nsupplies VCC and GND (X1, six pins each): the PWR_FLAGs. PU (R2, 1k) holds the 74F parts' unused inputs high.\nSpare: one inverter of IC8, one OR of IC36 (inputs tied), three of IC46, control 2's bit 4." (exclude_from_sim no) (at 15.24 17.78 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "2cb769e8-37bb-5b67-8b01-56c2eac9c4ac"))
	(embedded_fonts no)
)
