	(text "PS/2: ATMEGA328P, LATCHES ON PD / PE, STATUS, FTDI, -INT, RESET" (exclude_from_sim no) (at 15.24 12.7 0) (effects (font (size 2.5 2.5) (bold yes)) (justify left top)) (uuid "a86596ad-6671-560c-894d-112906b3d3df"))
	(text "IC41 runs embedded/video-ps2. OUT PD loads a command into IC43 (BUSY set), IN PE reads a byte from IC42 (FULL\ncleared), IN PD the status IC44: FULL, SRC, BUSY. -INT = INTREQ AND FULL (IC9/B) through IC46/D and JP1.\nThe bus -RESET reaches MRST through IC9/C, IC46/E and IC46/F (open collector, R12): it only ever pulls MRST low.\nThe V2.0 card's section, its nets unchanged." (exclude_from_sim no) (at 15.24 17.78 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "8317b970-9a08-5dd2-9f4d-135642a3a05f"))
	(embedded_fonts no)
)
