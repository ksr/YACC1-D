	(text "THE TWO LAYERS MIXED, THE DOT RETIMED, THE THREE GUNS, THE SYNCS, THE VGA SOCKET" (exclude_from_sim no) (at 15.24 12.7 0) (effects (font (size 2.5 2.5) (bold yes)) (justify left top)) (uuid "2f539cb1-470d-5389-b7c5-0802c1676376"))
	(text "VIDN = NOR(text, graphics) OR (text AND graphics AND XOR); IC20/B puts it on the dot clock; each gun is\nNOR(VIDN, its off bit) through 470 ohm into the monitor's 75. HSYNC: the stage's, inverted, XOR POLH. VSYNC:\nIC40 takes SVS at each HSYNC and again at the next; the pulse to the monitor lasts from SVS's rise to the\nsecond HSYNC after it (VS2), whatever the 6845's own length; XOR POLV. Both negative after -RESET." (exclude_from_sim no) (at 15.24 17.78 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "4b2ada44-770b-5966-99e1-6b10040cc4df"))
	(embedded_fonts no)
)
