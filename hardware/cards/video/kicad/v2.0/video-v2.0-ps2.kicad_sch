	(text "PS/2: ATMEGA328P, LATCHES ON PD / PE, FTDI, -INT, RESET" (exclude_from_sim no) (at 15.24 12.7 0) (effects (font (size 2.5 2.5) (bold yes)) (justify left top)) (uuid "1cf64006-6c35-55d4-aa10-db024333e4ce"))
	(text "IC49 runs embedded/video-ps2. OUT PD loads a command into IC51 (BUSY set), IN PE reads a byte from IC50 (FULL\ncleared), IN PD the status IC52. -INT = INTREQ AND FULL (IC54/B) through IC27/D and JP3 (INT-EN). The bus\n-RESET reaches MRST through IC54/C, IC27/E and IC27/F (open collector, R21): it only ever pulls MRST low." (exclude_from_sim no) (at 15.24 17.78 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "842d386b-c517-507b-8689-2b6371024810"))
	(embedded_fonts no)
