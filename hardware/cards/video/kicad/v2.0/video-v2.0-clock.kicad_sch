	(text "DOT CLOCK, CHARACTER COUNTER (DOTS: 6 OR 8 DOTS A CHARACTER)" (exclude_from_sim no) (at 15.24 12.7 0) (effects (font (size 2.5 2.5) (bold yes)) (justify left top)) (uuid "36824ace-c209-5f74-bf02-4151be6974f5"))
	(text "12 MHz crystal oscillator (IC20/A-C); SV4 1-2 = the crystal, 2-3 = half of it (IC21). IC28 counts the dots of\na character and loads 8 (JP2 fitted, 8 dots) or 10 (open, 6 dots) on its carry: CHARCLOCK = NOT RCO (IC19/C).\nWEPH = QA XOR QB (IC26/D): counts 9 and 10, the graphics write phase." (exclude_from_sim no) (at 15.24 17.78 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "e8b6143b-cd29-524e-a0b2-699805551384"))
