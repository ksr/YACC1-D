	(text "6845 CRTC ON PORTS PA (ADDRESS) / PB (DATA)" (exclude_from_sim no) (at 15.24 12.7 0) (effects (font (size 2.5 2.5) (bold yes)) (justify left top)) (uuid "091859b2-43dc-523c-8508-cc12d14d3b7b"))
	(text "-CS = PSEL_A AND PSEL_B (IC1/A): low for PA or PB. RS = IO-ADDR0, R/-W = -IO-WR,\nE = -IO-RD XOR -IO-WR (IC26/C): high during either strobe. MA0-11 and RA0-2 address the text RAM, the\ncharacter generator and the graphics muxes; the 6845 grade: README (the B grade above 1 MHz)." (exclude_from_sim no) (at 15.24 17.78 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "3adea701-8297-5b5f-8240-3a5f23ba0071"))
