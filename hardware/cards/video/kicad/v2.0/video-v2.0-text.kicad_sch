	(text "BOARD SELECT ($D000 BLOCK), TEXT RAM $D000-$D7FF, CHARACTER GENERATOR, TEXT DOT SHIFTER" (exclude_from_sim no) (at 15.24 12.7 0) (effects (font (size 2.5 2.5) (bold yes)) (justify left top)) (uuid "64d22807-ac2b-5126-8e0b-9e7181d0a217"))
	(text "IC18 compares ADDR12-15 with SV3 (fitted = 0; 5-6 only = $D000) while VMA: BOARDSEL. The CPU side of the\nIDT7134 is $D000-$D7FF (ADDR11 = 0, IC19/B); the 6845 reads the other port. IC23 latches the code, IC25\n(28C64, A10 = DOTS: the font) gives the row, IC24 shifts it out; IC22 delays DE and the attribute bits." (exclude_from_sim no) (at 15.24 17.78 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "b42d9722-ab05-55ac-91b6-8e5afac3c123"))
	(embedded_fonts no)
